<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<system.webServer>
		<handlers>
			<add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
		</handlers>

		<aspNetCore processPath="dotnet"
					arguments=".\Intl.Realty.Firm.dll"
					stdoutLogEnabled="true"
					stdoutLogFile=".\logs\stdout"
					hostingModel="inprocess">
			<environmentVariables>
				<environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
				<environmentVariable name="EmailSettings__Host" value="smtp.sendgrid.net" />
				<environmentVariable name="EmailSettings__Port" value="587" />
				<environmentVariable name="EmailSettings__Email" value="noreply@irfconnect.com" />
				<!-- Set EmailSettings__Password in SmarterASP control panel (Environment Variables). Do not commit secrets. -->
			</environmentVariables>
		</aspNetCore>
	</system.webServer>
</configuration>
