@using Intl.Realty.Firm.Model.ViewModel.UserProfileVM

@model UserProfileViewModel
@{
    ViewData["Title"] = "Preview";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<div class="c-content">
    <a href="##" class="back" onClick="history.go(-1); return false;">
        <i data-feather="chevron-left"></i><span>Back</span>
    </a>
    <div class="row mt-4">
        <div class="col-md-12 d-flex justify-content-between align-items-center">
            <h1 class="text-blue mb-0">User Details</h1>
            <div class="d-flex gap-4">
                <button type="button" id="btnMultipleDelete"
                        class="btn btn-danger d-none align-items-center"
                        data-toggle="tooltip"
                        data-bs-placement="left"
                        title="Delete"
                        onclick="OpenMultipleDeleteModal('User')">
                    <i data-feather="trash-2"></i>
                </button>
                <a asp-action="Create"
                   class="btn btn-primary d-flex align-items-center">
                    <i data-feather="plus" class="w-15px h-auto me-1"></i>Add New
                </a>
            </div>
        </div>
    </div>

    <div class="preview-page w-100 mt-4">
        <div class="row justify-content-center w-100">
            <div class="col-md-12 card p-5 mx-2">
                <div class="preview-page-header">
                    <h2 class="text-blue">@Model.FirstName @Model.LastName</h2>
                    <button type="button" class="btn btn-secondary preview-change-pw"
                            onclick="location.href='@Url.Action("ChangePassword", "UserProfile", new { id = Model.Id })'">
                        Change Password
                    </button>
                </div>

                <hr>

                <h4 class="text-blue mb-1">Details</h4>
                <div class="row my-2">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Firstname</label>
                            <p>@Model.FirstName</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Lastname</label>
                            <p>@Model.LastName</p>
                        </div>
                    </div>
                </div>
                <div class="row my-2">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Email</label>
                            <p>@Model.Email</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Employment Status</label>
                            <p>@Model.EmploymentStatusName</p>
                        </div>
                    </div>
                </div>
                <div class="row my-2">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Department</label>
                            <p>@(Model.DepartmentName ?? "No Department Assigned yet")</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Email Confirmation</label>
                            <p>
                                @if (Model.EmailConfirmed)
                                {
                                    <label class="status-ongoing pe-cursor">Confirmed</label>
                                }
                                else
                                {
                                    <label class="status-pending pe-cursor">Not yet confirmed</label>
                                }
                            </p>
                        </div>
                    </div>
                </div>

                <hr>

                <!-- Success/Error Messages -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }

                <h4 class="text-blue mb-1">Assign Team Leader</h4>
                <div class="row my-2">
                    <div class="col-md-6">
                        <form method="post" asp-action="UpdateTeamLeader" asp-controller="UserProfile">
                            <input type="hidden" name="userId" value="@Model.Id" />

                            <div class="form-group">
                                <label class="fw-bolder">Select Team Leader</label>
                                <div class="d-flex">
                                    @Html.DropDownListFor(m => m.TeamLeaderId,
                                             new SelectList(Model.TeamLeaders, "Value", "Text"),
                                             "Select a Team Leader",
                                             new { @class = "form-control rounded" })

                                    <button type="submit" class="btn btn-primary ms-2 rounded">Save</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>




                <h4 class="text-blue mb-1 roles-header">Roles associated with this user</h4>
                <div class="row my-2">
                    <div class="table-responsive table-no-border">
                        <table id="modelTable" class="data-table table w-100">
                            <thead>
                                <tr>
                                    <th class="text-start">Role Name</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Roles!.Count > 0)
                                {
                                    @foreach (var item in Model.Roles)
                                    {
                                        <tr>
                                            <td>@item</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td>No Roles Found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <h4 class="text-blue mb-1 roles-header">Claims associated with this user</h4>
                <div class="row my-2">
                    <div class="table-responsive table-no-border">
                        <table id="modelTable" class="data-table table w-100">
                            <thead>
                                <tr>
                                    <th class="text-start">Claim Name</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Claims!.Count > 0)
                                {
                                    @foreach (var item in Model.Claims)
                                    {
                                        <tr>
                                            <td>@item</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td>No Claims Found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .blurry {
        filter: blur(3px);
    }

    tfoot {
        display: table-header-group;
    }
</style>

<script>
    $(document).ready(function () {
        // Optional: Show success message for a few seconds
        setTimeout(function () {
            $(".alert").fadeOut("slow");
        }, 3000);
    });
</script>
