@using Intl.Realty.Firm.Model.ViewModel.UserProfileVM

@model UserProfileViewModel
@{
    ViewData["Title"] = "Preview";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<div class="c-content">
    <a href="##" class="back" onClick="history.go(-1); return false;">
        <i data-feather="chevron-left"></i><span>Back</span>
    </a>
    <div class="row mt-4">
        <div class="col-md-12 d-flex justify-content-between align-items-center">
            <h1 class="text-blue mb-0">User Details</h1>
        </div>
    </div>

    <div class="preview-page w-100 mt-4">
        <div class="row justify-content-center w-100">
            <div class="col-md-12 card p-5 mx-2">
                <div class="preview-page-header">
                    <h2 class="text-blue">@Model.FirstName @Model.LastName</h2>
                    <button type="button" class="btn btn-secondary preview-change-pw"
                            onclick="location.href='@Url.Action("ChangePassword", "UserProfile", new { id = Model.Id })'">
                        Change Password
                    </button>
                </div>

                <hr>

                <h4 class="text-blue mb-1">Details</h4>
                <div class="row my-2">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Firstname</label>
                            <p>@Model.FirstName</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Lastname</label>
                            <p>@Model.LastName</p>
                        </div>
                    </div>
                </div>

                <div class="row my-2">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Email</label>
                            <p>@Model.Email</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Employment Status</label>
                            <p>@Model.EmploymentStatusName</p>
                        </div>
                    </div>
                </div>

                <hr>

                <!-- Success/Error Messages -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }

                @if (Model.Roles.Contains("Agent"))
                {
                    @* <!-- Only Agents Can Change Team Leader --> *@
                    <h4 class="text-blue mb-1 roles-header">Select Team Leader</h4>
                    <div class="row my-2">
                        <div class="col-md-6">
                            <div class="form-group">
                                <div class="d-flex">
                                    @Html.DropDownListFor(m => m.TeamLeaderId,
                                             new SelectList(Model.TeamLeaders, "Value", "Text"),
                                             "Select a Team Leader",
                                             new { @class = "form-control rounded", id = "teamLeaderDropdown" })

                                    <button type="button" class="btn btn-primary ms-2 rounded" id="saveTeamLeaderBtn">
                                        Save
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (Model.Roles.Contains("TeamLeader"))
                {
                    @* <!-- Team Leaders Cannot Assign a Team Leader, Instead Show Their Members --> *@
                    <h4 class="text-blue mb-1 roles-header">Team Members</h4>
                    <div class="row my-2">
                        <div class="table-responsive table-no-border">
                            <table class="data-table table w-100">
                                <thead>
                                    <tr>
                                        <th class="text-start">First Name</th>
                                        <th class="text-start">Last Name</th>
                                        <th class="text-start">Email</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.TeamMembers!.Count > 0)
                                    {
                                        @foreach (var member in Model.TeamMembers)
                                        {
                                            <tr>
                                                <td>@member.FirstName</td>
                                                <td>@member.LastName</td>
                                                <td>@member.Email</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3">No Team Members Found</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>


                }

                <h4 class="text-blue mb-1 roles-header">Roles associated with this user</h4>
                <div class="row my-2">
                    <div class="table-responsive table-no-border">
                        <table class="data-table table w-100">
                            <thead>
                                <tr>
                                    <th class="text-start">Role Name</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Roles!.Count > 0)
                                {
                                    @foreach (var item in Model.Roles)
                                    {
                                        <tr>
                                            <td>@item</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td>No Roles Found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .blurry {
        filter: blur(3px);
    }
</style>

<!-- Include SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {
        // Hide success messages after 3 seconds
        setTimeout(function () {
            $(".alert").fadeOut("slow");
        }, 3000);

        // Handle Team Leader Assignment with SweetAlert2
        $("#saveTeamLeaderBtn").click(function () {
            var selectedTeamLeader = $("#teamLeaderDropdown").val();
            if (!selectedTeamLeader) {
                Swal.fire({
                    icon: "warning",
                    title: "No Team Leader Selected",
                    text: "Please select a team leader before saving.",
                    confirmButtonColor: "#3085d6",
                    confirmButtonText: "OK"
                });
                return;
            }

            Swal.fire({
                title: "Are you sure?",
                text: "You are about to assign a new team leader.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, Assign"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("UpdateTeamLeader", "UserProfile")',
                        type: 'POST',
                        data: {
                            userId: '@Model.Id',
                            teamLeaderId: selectedTeamLeader
                        },
                        success: function (response) {
                            console.log("✅ Success Response:", response);
                            Swal.fire({
                                icon: "success",
                                title: "Success",
                                text: response.message,
                                confirmButtonColor: "#3085d6"
                            }).then(() => {
                                location.reload();
                            });
                        },
                        error: function (xhr, status, error) {
                            console.error("❌ AJAX Error:", xhr.responseText);
                            Swal.fire({
                                icon: "error",
                                title: "Error",
                                text: "Something went wrong. Please try again.",
                                confirmButtonColor: "#d33"
                            });
                        }
                    });
                }
            });
        });
    });
</script>
