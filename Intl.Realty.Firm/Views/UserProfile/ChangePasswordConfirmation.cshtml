@{
    ViewData["Title"] = "Password Changed Successfully";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";

    var userId = ViewBag.UserId; // Get user ID from ViewBag
}

<div class="card shadow-sm p-4 text-center">
    <h2 class="text-success"><i class="fas fa-check-circle"></i> Password Updated!</h2>
    <p class="mt-3">
        Your password has been successfully changed. You can now use your new password to log in.
    </p>

    <div class="mt-4">
        <a href="@Url.Action("Index", "UserProfile", new { id = userId })" class="btn btn-primary">
            Go to Profile
        </a>
        <a href="@Url.Action("Dashboard", "Home")" class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>
</div>

@section Scripts {
    <script>
        setTimeout(function () {
            window.location.href = "@Url.Action("Dashboard", "Home")"; // Auto-redirect after 5 seconds
        }, 5000);
    </script>
}
