@using Intl.Realty.Firm.Model.ViewModel.UserProfileVM
@model ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm p-4">
                <div class="d-flex justify-content-start mb-3">
                    <a href="##" onclick="history.go(-1); return false;" class="btn btn-outline-secondary btn-sm">
                        ← Back
                    </a>
                </div>

                <h3 class="fw-bolder text-center mb-4">Change Password</h3>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>🚫 @error.ErrorMessage</div>
                        }
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form method="post" novalidate>
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="form-group mb-4">
                        <label asp-for="CurrentPassword" class="fw-bolder"></label>
                        <div class="input-group">
                            <input asp-for="CurrentPassword" class="form-control" placeholder="Enter current password" />
                            <button class="btn" type="button" data-target="#CurrentPassword">
                                <i data-feather="eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger fst-italic"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="NewPassword" class="fw-bolder"></label>
                        <div class="input-group">
                            <input asp-for="NewPassword" class="form-control" placeholder="Enter new password" />
                            <button class="btn" type="button" data-target="#NewPassword">
                                <i data-feather="eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger fst-italic"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="ConfirmPassword" class="fw-bolder"></label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm new password" />
                            <button class="btn" type="button" data-target="#ConfirmPassword">
                                <i data-feather="eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger fst-italic"></span>
                    </div>

                    <button type="submit" id="submitBtn" class="btn btn-primary w-100">
                        <span class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true" id="spinner"></span>
                        Update Password
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>

    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            feather.replace();

            $("button[data-target]").on("click", function () {
                const target = $($(this).data("target"));
                const input = target.length ? target : $("#" + $(this).data("target").replace("#", ""));
                const type = input.attr("type") === "password" ? "text" : "password";
                input.attr("type", type);

                const icon = $(this).find("i");
                icon.attr("data-feather", type === "text" ? "eye-off" : "eye");
                feather.replace();
            });

            const form = $("form");
            const submitBtn = $("#submitBtn");
            const spinner = $("#spinner");

            form.on("submit", function () {
                if (form.valid()) {
                    spinner.removeClass("d-none");
                    submitBtn.prop("disabled", true);
                }
            });
        });
    </script>
}
