@using Intl.Realty.Firm.Model.ViewModel.UserProfileVM

@model ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<h2>Change Password</h2>
<hr />

<div class="row">
    <div class="col-md-12 card p-4">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="row mb-4">
                <div class="form-group">
                    <label asp-for="CurrentPassword"></label>
                    <div class="input-group">
                        <input asp-for="CurrentPassword" type="password" class="form-control" id="currentPassword" />
                        <button type="button" class="btn btn-outline-secondary toggle-password" data-target="currentPassword">
                            👁️
                        </button>
                    </div>
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="form-group">
                    <label asp-for="NewPassword"></label>
                    <div class="input-group">
                        <input asp-for="NewPassword" type="password" class="form-control" id="newPassword" />
                        <button type="button" class="btn btn-outline-secondary toggle-password" data-target="newPassword">
                            👁️
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="form-group">
                    <label asp-for="ConfirmPassword"></label>
                    <div class="input-group">
                        <input asp-for="ConfirmPassword" type="password" class="form-control" id="confirmPassword" />
                        <button type="button" class="btn btn-outline-secondary toggle-password" data-target="confirmPassword">
                            👁️
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Update</button>
            <a href="##" onClick="history.go(-1); return false;" class="btn btn-outline-secondary">
                Back
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".toggle-password").forEach(button => {
                button.addEventListener("click", function () {
                    var targetId = this.getAttribute("data-target");
                    var inputField = document.getElementById(targetId);

                    if (inputField.type === "password") {
                        inputField.type = "text";
                        this.innerHTML = "🔒"; // Change icon to indicate visibility
                    } else {
                        inputField.type = "password";
                        this.innerHTML = "👁️"; // Change back to eye icon
                    }
                });
            });
        });
    </script>
}
