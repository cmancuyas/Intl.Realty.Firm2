@using Intl.Realty.Firm.Model.ViewModel.InternalEmailVM

@model CreateInternalEmailWithTabMenuViewModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<div class="page-controller mb-5">
    <a href="@Url.Action("Index","InternalEmail")" class="text-decoration-none back d-flex mb-4">
        <i data-feather="chevron-left"></i><span>Back</span>
    </a>
    <div class="row justify-content-center">
        <div class="col-md-12 card p-4">
            <h1 class="text-blue mb-0">Create Internal Email</h1>
            <hr class="my-4" />
            <form asp-action="Create"
                  asp-controller="InternalEmail"
                  method="post"
                  enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="tab-page">
                    @*                     <ul class="nav nav-tabs" id="internalEmailStatusManagementTab" role="tablist">
                    @foreach (var item in Model.Menus)
                    {
                    <li class="nav-item mx-0">
                    <input type="hidden" id="menuId" name="menuId" value="@item.Id" />
                    <button class="nav-link @item.IsActive"
                    id="@item.Tab"
                    data-bs-toggle="tab"
                    data-bs-target="#@item.Control"
                    type="button"
                    role="tab"
                    aria-controls="@item.Control"
                    aria-selected="@item.IsSelected">
                    @item.Description
                    </button>
                    </li>
                    }
                    </ul> *@
                </div>
                <div class="tab-content p-0" style="background-color:#FFF;padding:0;">

                    <div class="tab-pane active" id="internalEmailDetails" aria-labelledby="internalEmailDetails-tab" style="background-color:white;">

                        <div class="row mb-4">
                            <div class="col-md-6 col-sm-12 mb-3">
                                <div class="form-group">
                                    <label class="control-label fw-bolder">Role Name</label>

                                    @Html.DropDownListFor(x => x.CreateInternalEmail.RoleId, Model.CreateInternalEmail.RoleIEnum, "Select Role...",
                                             new
                                             {
                                                 @class = "form-select",
                                                 @required = "required",
                                             })
                                    @Html.ValidationMessageFor(x => x.CreateInternalEmail.RoleId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-12 mb-4">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label asp-for="CreateInternalEmail.Email" class="control-label fw-bolder">Email Address</label>
                                        <input asp-for="CreateInternalEmail.Email" class="form-control" />
                                        <span asp-validation-for="CreateInternalEmail.Email" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-5" />

                <div class="form-group d-flex justify-content-center gap-4 mobile-ctas">
                    <input type="button" value="Cancel" class="btn btn-secondary cta-button" onclick="window.location.href='@Url.Action("Index", "InternalEmail")'" />
                    @* <button type="reset" class="btn btn-secondary cta-button" onclick="$('.text-danger').hide();">Reset</button> *@
                    <button type="submit" class="btn btn-primary cta-button" onclick="$('.text-danger').show();">Submit</button>
                </div>

            </form>
        </div>
    </div>
</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/viewDataTableUtility.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {

        })



    </script>
}