@using Intl.Realty.Firm.Model.ViewModel.SaleListingVM

@model PreviewSaleListingViewModel
@{
    ViewData["Title"] = "Preview";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}
<div>
    <a href="@Url.Action("Index","SaleListing")" class="text-decoration-none text-blue d-flex mb-4">
        <i data-feather="chevron-left"></i><span>Back</span>
    </a>
    <div class="row">
        <div class="col-md-12 d-flex justify-content-md-between align-items-center">
            <h1 class="text-blue mb-0">SaleListing</h1>
            <div class="d-flex gap-4">
                <button type="button" id="btnMultipleDelete"
                        class="btn btn-danger d-none align-items-center"
                        data-toggle="tooltip"
                        data-bs-placement="left"
                        title="Delete"
                        onclick="OpenMultipleDeleteModal('SaleListing')">
                    <i data-feather="trash-2"></i>
                </button>
                <a asp-action="Create"
                   class="btn btn-primary d-flex align-items-center">
                    <i data-feather="plus" class="w-15px h-auto me-1"></i>Add New
                </a>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <div class="preview-page">
        <div class="row justify-content-center">
            <div class="col-md-10 card p-5 mx-4 ">
                <div class="d-flex justify-content-between">
                    <h2 class="text-blue">Deal Id: @Model.Id</h2>
                    <button type="button" class="btn btn-secondary w-15" id="EditSaleListingBtn"
                            onclick="location.href='@Url.Action("Edit", "SaleListing", new { id = Model.Id,})'"
                            '">
                        Edit
                    </button>
                </div>
                <hr />
                <h4 class="text-blue mb-1">Header</h4>
                <div class="row my-2">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Transaction Type</label>
                            <p>@Model.TransactionType!.Description</p>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Deal Status</label>
                            <p>@Model.DealStatus!.Description</p>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Date Submitted</label>
                            <p>@Model.DateSubmitted</p>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Created By</label>
                            <p>@Model.CreatedByFullName</p>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Created At</label>
                            <p>@Model.CreatedAt</p>
                        </div>
                    </div>
                </div>
                <hr />
                <h4 class="text-blue mb-1">Item</h4>
                    @* // Start of IRFDeal *@
                <div class="row my-2">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Property Address</label>
                            <p>@Model.IRFDeal.PropertyAddress</p>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Final Sale Price</label>
                            <p>@Model.IRFDeal.FinalSalePrice</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Final Closing Date</label>
                            <p>@Model.IRFDeal.FinalClosingDate</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Deposit Amount</label>
                            <p>@Model.IRFDeal.DepositAmount</p>
                        </div>
                    </div>
                </div>

                <div class="row my-2">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Deposit Date</label>
                            <p>@Model.IRFDeal.DepositDate</p>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Buyers Name</label>
                            <p>@Model.IRFDeal.BuyerName</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">LandLord Name</label>
                            <p>@Model.IRFDeal.LandLordName</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Listing Commission Percentage</label>
                            <p>@Model.IRFDeal.ListingCommissionPercentage</p>
                        </div>
                    </div>
                </div>

                <div class="row my-2">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Buying Commission Percentage</label>
                            <p>@Model.IRFDeal.BuyingCommissionPercentage</p>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Listing Agent Name</label>
                            <p>@Model.IRFDeal.ListingAgentName</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Listing Brokerage</label>
                            <p>@Model.IRFDeal.ListingBrokerage</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Listing Brokerage Fax</label>
                            <p>@Model.IRFDeal.ListingBrokerageFax</p>
                        </div>
                    </div>
                </div>

                <div class="row my-2">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Buyer Agent Name</label>
                            <p>@Model.IRFDeal.BuyerAgentName</p>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Buyer Brokerage</label>
                            <p>@Model.IRFDeal.BuyerBrokerage</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Sellers Lawyer</label>
                            <p>@Model.IRFDeal.SellersLawyer</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Sellers Lawyer Address</label>
                            <p>@Model.IRFDeal.SellersLawyerAddress</p>
                        </div>
                    </div>
                </div>

                <div class="row my-2">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Sellers PhoneNumber</label>
                            <p>@Model.IRFDeal.SellersPhoneNumber</p>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Buyers Lawyer</label>
                            <p>@Model.IRFDeal.BuyersLawyer</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Buyers Lawyer Address</label>
                            <p>@Model.IRFDeal.BuyersLawyerAddress</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label fw-bolder">Buyers PhoneNumber</label>
                            <p>@Model.IRFDeal.BuyersPhoneNumber</p>
                        </div>
                    </div>
                </div>
                <hr />
                <h4 class="text-blue mb-1">List of Files associated with this Transaction</h4>
                <div class="row my-2">
                    <div class="table-responsive">
                        <table id="modelTable" class="data-table table w-100">
                            <thead>
                                <tr>
                                    <th class="text-start">File Name</th>
                                    <th class="text-start">File Extension</th>
                                </tr>
                            </thead>
                            <tbody>
                    @{
                        @if (Model.FileUploads!.Count > 0)
                        {
                            @foreach (var item in Model.FileUploads)
                            {
                                <tr>
                                    <td>@item.FileName</td>
                                    <td><div class="attachment-icon">@item.FileExtension</div></td>
                                </tr>
                            }

                        }
                            else
                            {
                                <tr>
                                    <td></td>
                                    <td>No Associated Files Found</td>
                                    <td></td>
                                </tr>
                            }
                        }

                            </tbody>
                        </table>
                    </div>
                </div>

                <hr />
                <div class="row my-2">
                    <div class="form-group">
                        <label asp-for="EditSaleListing.Notes" class="control-label fw-bolder">Notes</label>
                    @Html.TextAreaFor(model => model.Notes, 10, 100, new { @class = "form-control", disabled = "disabled" })

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .blurry {
        filter: blur(3px);
    }

    tfoot {
        display: table-header-group;
    }

</style>

<script>
    $(document).ready(function () {

    });
</script>