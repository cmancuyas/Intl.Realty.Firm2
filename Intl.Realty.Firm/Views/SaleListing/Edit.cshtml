@using Intl.Realty.Firm.Model.Model
@using Intl.Realty.Firm.Model.ViewModel.SaleListingVM
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Newtonsoft.Json

@inject UserManager<ApplicationUser> _userManager;

@model EditSaleListingWithTabMenuViewModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";

    var user = await _userManager.GetUserAsync(User);
    var isAgent = await _userManager.IsInRoleAsync(user!, "Agent");
    var isDealAdmin = await _userManager.IsInRoleAsync(user!, "DealAdmin");
    var isAdmin = await _userManager.IsInRoleAsync(user!, "Admin");
    var isSuperAdmin = await _userManager.IsInRoleAsync(user!, "SuperAdmin");
}

<partial name="~/Views/Shared/Modal/_ConfirmSaveModal.cshtml" />
<partial name="~/Views/Shared/Modal/_ConfirmSubmitModal.cshtml" />
<partial name="~/Views/Shared/Modal/_ConfirmSuccessModal.cshtml" />

<div class="page-controller mb-5">
    @*    <a href="@Url.Action("Index","SaleListing")" class="text-decoration-none text-blue d-flex mb-4">
    <i data-feather="chevron-left"></i><span>Back</span>
    </a> *@
    <a href="##" class="back" onClick="history.go(-1); return false;">
        <i data-feather="chevron-left"></i><span>Back</span>
    </a>
    <div class="row justify-content-center">
        <div class="col-md-12 card mt-4 p-4 b-none bg-none">
            <h1 class="text-blue mb-0">Edit Sale Listing - Deal Id: @Model.EditSaleListingViewModel.DealTransactionNumber - @Model.EditSaleListingViewModel.DealStatus!.Description</h1>
            <hr class="my-4" />
            <form id="ListFormId"
                  asp-action="Edit"
                  asp-controller="SaleListing"
                  method="post"
                  enctype="multipart/form-data">
                <input type="hidden" id="ActionTypeHidden" name="actionType" />

                <input type="hidden" name="EditSaleListingViewModel.RowVersion"
                       value="@Convert.ToBase64String(Model.EditSaleListingViewModel.RowVersion)" />
                <input type="hidden" asp-for="EditSaleListingViewModel.Id" />
                <input type="hidden" asp-for="EditSaleListingViewModel.DealTransactionNumber" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="tab-page">
                    <ul class="nav nav-tabs" id="administrationManagementTab" role="tablist" style="border:none">
                        @foreach (var item in Model.Menus)
                        {
                            <li class="nav-item mx-0">
                                <input type="hidden" id="menuId" name="menuId" value="@item.Id" />
                                <button class="nav-link @item.IsActive"
                                        id="@item.Tab"
                                        data-bs-toggle="tab"
                                        data-bs-target="#@item.Control"
                                        type="button"
                                        role="tab"
                                        aria-controls="@item.Control"
                                        aria-selected="@item.IsSelected">
                                    @item.Description
                                </button>
                            </li>
                        }
                    </ul>
                </div>

                <div class="tab-content" style="border-bottom:none;background-color:white;">


                    <!-- Tab 1: IRF Details - Part 1 -->
                    <div class="tab-pane active" id="irfDetails1" aria-labelledby="irfDetails1-tab" style="background-color:white;">
                        @* Section: Deal Status for Admin *@
                        @{
                            if (isAdmin || isSuperAdmin || isDealAdmin)
                            {
                                @* Deal Status *@
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="control-label fw-bolder">Deal Status</label>
                                            <select id="EditSaleListingViewModel.DealStatusId" name="EditSaleListingViewModel.DealStatusId" class="form-select">
                                                @{
                                                    @if (Model.EditSaleListingViewModel.DealStatusList != null)
                                                    {
                                                        @foreach (var dealStatus in Model.EditSaleListingViewModel.DealStatusList)
                                                        {
                                                            if (dealStatus.Id == Model.EditSaleListingViewModel.DealStatusId)
                                                            {
                                                                <option value="@dealStatus.Id" selected>@dealStatus.Description</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@dealStatus.Id">@dealStatus.Description</option>
                                                            }
                                                        }
                                                    }
                                                }
                                            </select>

                                            @Html.ValidationMessageFor(m => m.EditSaleListingViewModel.DealStatusId, "", new { @class = "text-danger" })

                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <input type="hidden" name="EditSaleListingViewModel.DealStatusId" value="1" />
                            }
                        }
                        <!-- 🏠 Property & Deal Info -->
                        <h4 class="mt-4 text-blue">Property & Deal Information</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.PropertyAddress" class="fw-bolder">Property Address</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.PropertyAddress" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.PropertyAddress" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.UpdatedByFullName" class="fw-bolder">Updated By</label>
                                <input asp-for="EditSaleListingViewModel.UpdatedByFullName" class="form-control" disabled />
                                <span asp-validation-for="EditSaleListingViewModel.UpdatedByFullName" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- 💰 Financial Details -->
                        <h4 class="mt-5 text-blue">Financial Details</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.FinalSalePrice" class="fw-bolder">Final Sale Price</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.FinalSalePrice" class="form-control" type="number" min="0" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.FinalSalePrice" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.FinalClosingDate" class="fw-bolder">Final Closing Date</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.FinalClosingDate" class="form-control" type="date" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.FinalClosingDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.DepositAmount" class="fw-bolder">Deposit Amount</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.DepositAmount" class="form-control" type="number" min="0" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.DepositAmount" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.DepositDate" class="fw-bolder">Deposit Date</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.DepositDate" class="form-control" type="date" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.DepositDate" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- 👤 Buyer Info -->
                        <h4 class="mt-5 text-blue">Buyer Details</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerName" class="fw-bolder">Buyer’s Name</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerName" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerName" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- 👤 Seller Info -->
                        <h4 class="mt-5 text-blue">Seller Details</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerName" class="fw-bolder">Seller’s Name</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerName" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerEmail" class="fw-bolder">Seller’s Email</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerEmail" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerEmail" class="text-danger"></span>
                            </div>
                        </div>


                        <!-- 📊 Commission Info -->
                        <h4 class="mt-5 text-blue">Commission</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <div class="form-group">
                                    <label class="control-label fw-bolder">Listing Commission Signage</label>
                                    <select id="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.Commission.ListingCommissionSign" name="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.Commission.ListingCommissionSign" class="form-select">
                                        @{
                                            @if (Model.EditSaleListingViewModel.SignageIEnum != null)
                                            {
                                                @foreach (var item in Model.EditSaleListingViewModel.SignageIEnum)
                                                {
                                                    int quarter = Convert.ToInt32(item.Value);
                                                    if (quarter == Model.EditSaleListingViewModel.DefaultSignage)
                                                    {
                                                        <option value="@item.Value" selected>@item.Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@item.Value">@item.Text</option>
                                                    }
                                                }
                                            }
                                        }
                                    </select>

                                    @Html.ValidationMessageFor(m => m.EditSaleListingViewModel.EditIRFDealSaleListingViewModel.Commission.ListingCommissionSign, "", new { @class = "text-danger" })

                                </div>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.Commission.ListingCommission" class="fw-bolder">Total Commission</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.Commission.ListingCommission" class="form-control" type="number" min="0" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.Commission.ListingCommission" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <div class="form-group">
                                    <label class="control-label fw-bolder">Buying Commission Signage</label>
                                    <select id="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.Commission.BuyingCommissionSign" name="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.Commission.BuyingCommissionSign" class="form-select">
                                        @{
                                            @if (Model.EditSaleListingViewModel.SignageIEnum != null)
                                            {
                                                @foreach (var item in Model.EditSaleListingViewModel.SignageIEnum)
                                                {
                                                    int quarter = Convert.ToInt32(item.Value);
                                                    if (quarter == Model.EditSaleListingViewModel.DefaultSignage)
                                                    {
                                                        <option value="@item.Value" selected>@item.Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@item.Value">@item.Text</option>
                                                    }
                                                }
                                            }
                                        }
                                    </select>

                                    @Html.ValidationMessageFor(m => m.EditSaleListingViewModel.EditIRFDealSaleListingViewModel.Commission.BuyingCommissionSign, "", new { @class = "text-danger" })

                                </div>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.Commission.BuyingCommission" class="fw-bolder">Co-op Commission</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.Commission.BuyingCommission" class="form-control" type="number" min="0" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.Commission.BuyingCommission" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 2: IRF Details - Part 2 -->
                    <div class="tab-pane" id="irfDetails2" aria-labelledby="irfDetails2-tab" style="background-color:white;">

                        <!-- 🧑‍💼 Buyer Agent & Brokerage Info -->
                        <h4 class="mt-4 text-blue">Buyer’s Agent & Brokerage Info</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerAgentName" class="fw-bolder">Buyer's Agent Name</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerAgentName" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerAgentName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerBrokerage" class="fw-bolder">Buyer's Brokerage</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerBrokerage" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerBrokerage" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerBrokerageFax" class="fw-bolder">Buyer's Brokerage Fax</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerBrokerageFax" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerBrokerageFax" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerBrokeragePhoneNumber" class="fw-bolder">Buyer's Brokerage Phone Number</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerBrokeragePhoneNumber" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerBrokeragePhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerBrokerageEmail" class="fw-bolder">Buyer's Brokage Email</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerBrokerageEmail" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerBrokerageEmail" class="text-danger"></span>
                            </div>
                        </div>
                        <!-- 📜 Buyer Legal Info -->
                        <h4 class="mt-5 text-blue">Buyer’s Legal Info</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerLawyer" class="fw-bolder">Buyer's Lawyer</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerLawyer" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerLawyer" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerLawyerAddress" class="fw-bolder">Buyer's Lawyer Address</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerLawyerAddress" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerLawyerAddress" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerLawyerPhone" class="fw-bolder">Buyer's Lawyer Phone</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerLawyerPhone" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerLawyerPhone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerLawyerEmail" class="fw-bolder">Buyer's Lawyer Email</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerLawyerEmail" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.BuyerDetails.BuyerLawyerEmail" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- 🧾 Seller's Agent & Brokerage Info -->
                        <h4 class="mt-5 text-blue">Seller's Agent & Brokerage Info</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerAgentName" class="fw-bolder">Seller's Agent Name</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerAgentName" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerAgentName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerBrokerage" class="fw-bolder">Seller's Brokerage</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerBrokerage" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerBrokerage" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerBrokerageFax" class="fw-bolder">Seller's Brokerage Fax</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerBrokerageFax" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerBrokerageFax" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerBrokeragePhoneNumber" class="fw-bolder">Seller's Brokerage Phone Number</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerBrokeragePhoneNumber" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerBrokeragePhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerBrokerageEmail" class="fw-bolder">Seller's Brokerage Email</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerBrokerageEmail" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerBrokerageEmail" class="text-danger"></span>
                            </div>
                        </div>
                        <!-- 🧾 Seller & Legal Info -->
                        <h4 class="mt-5 text-blue">Seller's Legal Info</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerLawyer" class="fw-bolder">Seller's Lawyer</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerLawyer" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerLawyer" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerLawyerAddress" class="fw-bolder">Seller's Lawyer Address</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerLawyerAddress" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerLawyerAddress" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerLawyerPhone" class="fw-bolder">Seller's Lawyer Phone Number</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerLawyerPhone" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerLawyerPhone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerLawyerEmail" class="fw-bolder">Seller's Lawyer Email</label>
                                <input asp-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerLawyerEmail" class="form-control" />
                                <span asp-validation-for="EditSaleListingViewModel.EditIRFDealSaleListingViewModel.SellerDetails.SellerLawyerEmail" class="text-danger"></span>
                            </div>

                        </div>
                    </div>

                    <div class="tab-pane" id="viewFileUploads" aria-labelledby="viewFileUploads-tab" style="background-color:white;">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-submit-tab mt-3 bg-white" style="display:block !important">

                                    <div class="table-responsive">
                                        <table class="table table-bordered file-upload-table">
                                            <thead>
                                                <tr>
                                                    <th class="ps-3 p-2" style="width:30%;">Document Type</th>
                                                    <th class="ps-3 p-2" style="width:35%;">Filename</th>
                                                    <th class="ps-3 p-2 text-center" style="width:35%;">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="fileTableBody">
                                                @if (Model.EditSaleListingViewModel.FileUploads != null &&
                                                                                 Model.EditSaleListingViewModel.FileUploads.Any(x => x.IsActive && !x.IsDeleted))
                                                {
                                                    foreach (var fileUpload in Model.EditSaleListingViewModel.FileUploads
                                                        .Where(x => x.IsActive && !x.IsDeleted))
                                                    {
                                                        var docType = Model.EditSaleListingViewModel.DocumentTypeList?
                                                            .FirstOrDefault(dt => dt.Id == fileUpload.DocumentTypeId && !dt.IsDeleted);

                                                        if (docType != null)
                                                        {
                                                            <tr>
                                                                <td class="p-2">@docType.Description</td>
                                                                <td class="p-2 text-break">
                                                                    @(string.IsNullOrWhiteSpace(fileUpload.OriginalFileName)
                                                                        ? fileUpload.FileName
                                                                        : fileUpload.OriginalFileName)
                                                                </td>
                                                                <td class="p-2 text-center">
                                                                    <a asp-action="Download"
                                                                           asp-route-id="@fileUpload.Id"
                                                                           class="btn btn-secondary"
                                                                           target="_blank">
                                                                        Download
                                                                    </a>
                                                                    <button type="button"
                                                                            class="btn btn-danger btn-delete-file"
                                                                            data-file-id="@fileUpload.Id">
                                                                        Delete
                                                                    </button>
                                                                    <a asp-action="PreviewFile"
                                                                           asp-controller="SaleListing"
                                                                           asp-route-id="@fileUpload.Id"
                                                                           class="btn btn-secondary"
                                                                           target="_blank">
                                                                        Preview
                                                                    </a>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="3" class="text-center">No associated files found.</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="table-responsive mt-4">
                                        <table class="table table-bordered file-upload-table" id="tblSavedAdditionalDocuments">
                                            <thead>
                                                <tr>
                                                    <th class="ps-3 p-2" style="width:30%;">Document Name</th>
                                                    <th class="ps-3 p-2" style="width:35%;">Filename</th>
                                                    <th class="ps-3 p-2 text-center" style="width:35%;">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="additionalDocumentTableBody">
                                                @if (Model.EditSaleListingViewModel.SavedAdditionalDocuments != null &&
                                                                                 Model.EditSaleListingViewModel.SavedAdditionalDocuments.Any(x => x.IsActive && !x.IsDeleted))
                                                {
                                                    foreach (var item in Model.EditSaleListingViewModel.SavedAdditionalDocuments
                                                        .Where(x => x.IsActive && !x.IsDeleted))
                                                    {
                                                        <tr id="additionalDocumentRow_@item.Id">
                                                            <td class="p-2 text-break">@item.DocumentName</td>
                                                            <td class="p-2 text-break">@item.OriginalFileName</td>
                                                            <td class="p-2 text-center">
                                                                <a asp-action="DownloadAdditionalDocument"
                                                                       asp-route-id="@item.Id"
                                                                       class="btn btn-secondary"
                                                                       target="_blank">
                                                                    Download
                                                                </a>
                                                                <button type="button"
                                                                        class="btn btn-danger btn-delete-additional-document"
                                                                        data-id="@item.Id">
                                                                    Delete
                                                                </button>
                                                                <a asp-action="PreviewAdditionalDocument"
                                                                       asp-route-id="@item.Id"
                                                                       class="btn btn-secondary"
                                                                       target="_blank">
                                                                    Preview
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="3" class="text-center">No additional documents found.</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane" id="createFileUploads" aria-labelledby="createFileUploads-tab" style="background-color:white;">
                        <div class="row d-flex justify-content-center m-0">
                            <div class="col-md-12">
                                <h5 class="text-blue mb-4">
                                    Please match your uploaded file based on the Document Type for Sale Listing.
                                    <span class="s-required">*</span>
                                </h5>

                                @{
                                    var docAssignments = Model.EditSaleListingViewModel.DocumentTypeAssignmentList
                                        .Where(x => !x.IsDeleted
                                            && x.IsActive
                                            && x.DocumentType != null
                                            && !x.DocumentType.IsDeleted
                                            && x.DocumentType.IsActive)
                                        .ToList();
                                }

                                <table class="table dataTable file-upload-table" id="tblApplicantFiles" width="100%">
                                    <thead>
                                        <tr>
                                            <th style="width:30%;">Document Type</th>
                                            <th style="width:15%;">Is Required?</th>
                                            <th style="width:55%;">Uploaded Document</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < docAssignments.Count; i++)
                                        {
                                            var item = docAssignments[i];
                                            var alreadyUploaded = Model.EditSaleListingViewModel.FileUploads != null &&
                                                                  Model.EditSaleListingViewModel.FileUploads.Any(f =>
                                                                      f.DocumentTypeId == item.DocumentType.Id &&
                                                                      f.IsActive && !f.IsDeleted);

                                            <tr data-document-type-id="@item.DocumentType.Id">
                                                <td style="width:30%">
                                                    @item.DocumentType.Description
                                                    @if (alreadyUploaded)
                                                    {
                                                        <span class="badge bg-success ms-1">File Uploaded</span>
                                                    }
                                                    <input type="hidden"
                                                           name="EditSaleListingViewModel.CreateFileUploadListViewModel.CreateFileUploadsViewModel[@i].DocumentTypeId"
                                                           value="@item.DocumentType.Id" />
                                                </td>
                                                <td id="isRequired">
                                                    @if (item.IsRequired == true)
                                                    {
                                                        <label class="status-active">Required</label>
                                                    }
                                                    else
                                                    {
                                                        <label class="status-inactive pe-cursor">Not Required</label>
                                                    }
                                                </td>
                                                <td>
                                                    <input type="file"
                                                           name="EditSaleListingViewModel.CreateFileUploadListViewModel.CreateFileUploadsViewModel[@i].Files"
                                                           id="fileListDropDown_@i"
                                                           class="file"
                                                           multiple
                                                           data-show-upload="false"
                                                           data-allowed-file-extensions='["pdf","doc","docx","xls","xlsx"]'
                                                           accept=".pdf,.doc,.docx,.xls,.xlsx"
                                                           data-show-caption="true"
                                                           data-show-preview="false"
                                                           data-msg-placeholder="Select {files} for upload..." />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                                <hr class="my-4" />

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <h5 class="text-blue mb-1">Additional Documents</h5>
                                        <p class="text-muted mb-0">
                                            You may add other supporting documents not included in the predefined document types.
                                        </p>
                                    </div>
                                    <button type="button" class="btn btn-primary" id="btnAddAdditionalDocumentRow">
                                        Add Additional Document
                                    </button>
                                </div>

                                <table class="table dataTable file-upload-table" id="tblAdditionalDocuments" width="100%">
                                    <thead>
                                        <tr>
                                            <th style="width:35%;">Document Name</th>
                                            <th style="width:45%;">Upload File</th>
                                            <th style="width:20%;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.EditSaleListingViewModel.AdditionalDocuments != null &&
                                                                 Model.EditSaleListingViewModel.AdditionalDocuments.Any())
                                        {
                                            @for (int i = 0; i < Model.EditSaleListingViewModel.AdditionalDocuments.Count; i++)
                                            {
                                                <tr>
                                                    <td>
                                                        <input type="hidden"
                                                               name="EditSaleListingViewModel.AdditionalDocuments[@i].Id"
                                                               value="@Model.EditSaleListingViewModel.AdditionalDocuments[i].Id" />

                                                        <input type="text"
                                                               name="EditSaleListingViewModel.AdditionalDocuments[@i].DocumentName"
                                                               value="@Model.EditSaleListingViewModel.AdditionalDocuments[i].DocumentName"
                                                               class="form-control"
                                                               placeholder="Enter document name" />
                                                    </td>
                                                    <td>
                                                        <input type="file"
                                                               name="EditSaleListingViewModel.AdditionalDocuments[@i].File"
                                                               class="form-control additional-document-file"
                                                               accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />
                                                    </td>
                                                    <td class="text-center align-middle">
                                                        <button type="button" class="btn btn-danger btnRemoveAdditionalDocumentRow">
                                                            Remove
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td>
                                                    <input type="hidden"
                                                           name="EditSaleListingViewModel.AdditionalDocuments[0].Id"
                                                           value="" />

                                                    <input type="text"
                                                           name="EditSaleListingViewModel.AdditionalDocuments[0].DocumentName"
                                                           class="form-control"
                                                           placeholder="Enter document name" />
                                                </td>
                                                <td>
                                                    <input type="file"
                                                           name="EditSaleListingViewModel.AdditionalDocuments[0].File"
                                                           class="form-control additional-document-file"
                                                           accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />
                                                </td>
                                                <td class="text-center align-middle">
                                                    <button type="button" class="btn btn-danger btnRemoveAdditionalDocumentRow">
                                                        Remove
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane" id="notes" aria-labelledby="notes-tab" style="background-color:white;">
                        <div class="col-md-12 mt-4">
                            <div class="form-group">
                                <label asp-for="EditSaleListingViewModel.Notes" class="control-label fw-bolder">Notes</label>
                                @Html.TextAreaFor(model => model.EditSaleListingViewModel.Notes, 10, 100, new { @class = "form-control" })

                            </div>
                        </div>
                    </div>
                </div>
                @*               <div class="row mb-4">
                <div class="col-md-12">
                <div class="form-check form-switch d-flex align-items-center gap-2">
                <input id="isDeletedCheckbox" class="form-check-input" type="checkbox" asp-for="IsDeleted">
                <label id="lblStatusSoftDelete" class="fw-bolder">Not Deleted</label>
                </div>
                <span asp-validation-for="IsDeleted" class="text-danger"></span>
                </div>
                </div> *@
                <div class="mt-4">
                    @await Html.PartialAsync("~/Views/Shared/Transaction/_EditActionButtons.cshtml", Model.EditSaleListingViewModel.DealStatusId)
                </div>



            </form>
        </div>
    </div>
</div>

<style>
    .file-upload-table {
        table-layout: fixed;
        width: 100%;
        border-collapse: collapse;
    }

        .file-upload-table th,
        .file-upload-table td {
            vertical-align: middle;
            border: 1px solid #dee2e6;
        }

            .file-upload-table td.text-break {
                word-break: break-word;
                overflow-wrap: anywhere;
            }

        .file-upload-table .btn {
            min-width: 82px;
            margin-right: 4px;
        }

        .file-upload-table thead th {
            background-color: #203d57 !important;
            color: #fff !important;
            font-weight: 600;
        }
        #tblAdditionalDocuments td.text-center.align-middle {
            vertical-align: middle !important;
        }
</style>
@section Scripts {
    @* Load ASP.NET Core validation partial *@
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @* JS Utilities & Plugins *@
    <script src="~/js/viewDataTableUtility.js" asp-append-version="true"></script>
    <script src="~/js/submitUtility.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @* Submit Handler Init *@
    <script>
    const documentTypeAssignments = @Html.Raw(JsonConvert.SerializeObject(Model.EditSaleListingViewModel.DocumentTypeAssignmentList));
    const isAdminLike = @((User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("DealAdmin")).ToString().ToLower());

    $(document).ready(function() {
    	initializeSubmitHandlers({
    		formId: "ListFormId", // 🔁 Actual form ID in the DOM
    		dealStatusDropdownSelector: '[name="EditSaleListingViewModel.DealStatusId"]', // 🔁 Matches Razor binding
    		isAdminLike: isAdminLike,
    		fileErrorScrollTargetId: "fileUploads", // 🔁 Scroll target for validation
    		documentTypeAssignment: documentTypeAssignments
    	});
    	$('.btn-delete-file').on('click', function(e) {
    		e.preventDefault();
    		var $btn = $(this);
    		var fileId = $btn.data('file-id');
    		Swal.fire({
    			title: 'Are you sure?',
    			text: "This will permanently delete the file.",
    			icon: 'warning',
    			showCancelButton: true,
    			confirmButtonColor: '#d33',
    			cancelButtonColor: '#aaa',
    			confirmButtonText: 'Yes, delete it!'
    		}).then((result) => {
    			if (result.isConfirmed) {
    				$.ajax({
    					url: '/SaleListing/DeleteFileAjax/' + fileId,
    					type: 'POST',
    					headers: {
    						'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
    					},
    					success: function(res) {
    						if (res.success) {
    							Swal.fire('Deleted!', 'File has been deleted.', 'success').then(() => {
    								location.reload();
    							});
    						} else {
    							Swal.fire('Error!', 'Could not delete the file.', 'error');
    						}
    					}
    				});
    			}
    		});
    	});
    }); 
</script>

<script>
    $(document).ready(function() {

    	function reIndexAdditionalDocumentRows() {
    		$('#tblAdditionalDocuments tbody tr').each(function(index) {
    			$(this).find('input').each(function() {
    				let currentName = $(this).attr('name');
    				if (currentName) {
    					currentName = currentName.replace(
    						/EditSaleListingViewModel\.AdditionalDocuments\[\d+\]/g,
    						'EditSaleListingViewModel.AdditionalDocuments[' + index + ']'
    					);
    					$(this).attr('name', currentName);
    				}
    			});
    		});
    	}

    	function buildAdditionalDocumentRow(rowCount) {
    		return `
                <tr>
                    <td>
                        <input type="hidden"
                        name="EditSaleListingViewModel.AdditionalDocuments[${rowCount}].Id"
                        value="" />
                        <input type="text"
                        name="EditSaleListingViewModel.AdditionalDocuments[${rowCount}].DocumentName"
                        class="form-control"
                        placeholder="Enter document name" />
                    </td>
                    <td>
                        <input type="file"
                        name="EditSaleListingViewModel.AdditionalDocuments[${rowCount}].File"
                        class="form-control additional-document-file"
                        accept=".pdf,.doc,.docx,.xls,.xlsx" />
                    </td>
                    <td class="text-center align-middle">
                        <button type="button" class="btn btn-danger btnRemoveAdditionalDocumentRow">
                            Remove
                        </button>
                    </td>
                </tr>
                `;
    		}

    		$(document)
    			.off('click', '#btnAddAdditionalDocumentRow')
    			.on('click', '#btnAddAdditionalDocumentRow', function(e) {
    				e.preventDefault();

    				let rowCount = $('#tblAdditionalDocuments tbody tr').length;
    				$('#tblAdditionalDocuments tbody').append(buildAdditionalDocumentRow(rowCount));
    			});

    		$(document)
    			.off('click', '.btnRemoveAdditionalDocumentRow')
    			.on('click', '.btnRemoveAdditionalDocumentRow', function(e) {
    				e.preventDefault();

    				const rowCount = $('#tblAdditionalDocuments tbody tr').length;

    				if (rowCount > 1) {
    					$(this).closest('tr').remove();
    					reIndexAdditionalDocumentRows();
    				} else {
    					$(this).closest('tr').find('input[type="text"]').val('');
    					$(this).closest('tr').find('input[type="file"]').val('');
    				}
    			});

    		$(document)
    			.off('click', '.btn-delete-additional-document')
    			.on('click', '.btn-delete-additional-document', function(e) {
    				e.preventDefault();

    				const id = $(this).data('id');

    				Swal.fire({
    					title: 'Are you sure?',
    					text: "This will permanently delete the additional document.",
    					icon: 'warning',
    					showCancelButton: true,
    					confirmButtonColor: '#d33',
    					cancelButtonColor: '#aaa',
    					confirmButtonText: 'Yes, delete it!'
    				}).then((result) => {
    					if (result.isConfirmed) {
    						$.ajax({
    							url: '/SaleListing/DeleteAdditionalDocumentAjax/' + id,
    							type: 'POST',
    							headers: {
    								'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
    							},
    							success: function(res) {
    								if (res.success) {
    									Swal.fire('Deleted!', 'Additional document has been deleted.', 'success')
    										.then(() => {
    											location.reload();
    										});
    								} else {
    									Swal.fire('Error!', res.message || 'Could not delete the additional document.', 'error');
    								}
    							},
    							error: function() {
    								Swal.fire('Error!', 'An error occurred while deleting the additional document.', 'error');
    							}
    						});
    					}
    				});
    			});
    	}); 
</script>
}
