@using Intl.Realty.Firm.Model.ViewModel.ReferAnAgentVM
@model ReferAnAgentViewModel

@{
    ViewData["Title"] = "Refer An Agent";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h4 class="text-blue fw-bold text-center mb-4">Refer an Agent</h4>

                <form id="contactForm" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Your Full Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter your name" required />
                        <span asp-validation-for="Name" class="text-danger fst-italic"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ReferredAgentName" class="form-label fw-semibold">Referred Agent's Name</label>
                        <input asp-for="ReferredAgentName" class="form-control" placeholder="Enter referred agent's name" required />
                        <span asp-validation-for="ReferredAgentName" class="text-danger fst-italic"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ReferredAgentPhone" class="form-label fw-semibold">Referred Agent's Phone Number</label>
                        <input asp-for="ReferredAgentPhone" class="form-control" placeholder="Enter referred agent's phone number" required />
                        <span asp-validation-for="ReferredAgentPhone" class="text-danger fst-italic"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label fw-semibold">Notes (Optional)</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Add any relevant notes..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger fst-italic"></span>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="button" class="btn btn-primary" onclick="sendEmail()">📤 Send Referral</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Spinner -->
<div id="spinner-container" style="display: none;">
    @Html.Partial("~/Views/Shared/_Spinner.cshtml")
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function sendEmail() {
            const formData = {
                Name: $("#Name").val().trim(),
                ReferredAgentName: $("#ReferredAgentName").val().trim(),
                ReferredAgentPhone: $("#ReferredAgentPhone").val().trim(),
                Notes: $("#Notes").val().trim()
            };

            // Basic validation
            if (!formData.Name || !formData.ReferredAgentName || !formData.ReferredAgentPhone) {
                Swal.fire({
                    icon: 'error',
                    title: 'Missing Info',
                    text: "Please fill in your name, the referred agent's name, and phone number.",
                });
                return;
            }

            $("#spinner-container").show();

            $.ajax({
                url: '/ReferAnAgent/SendEmail',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function () {
                    $("#spinner-container").hide();
                    Swal.fire({
                        icon: 'success',
                        title: 'Referral Sent',
                        text: 'Your referral has been successfully submitted!',
                    }).then(() => {
                        $("#contactForm")[0].reset();
                    });
                },
                error: function (xhr) {
                    $("#spinner-container").hide();
                    let errorText = 'Something went wrong. Please try again later.';
                    if (xhr.responseJSON?.errors) {
                        errorText = Object.values(xhr.responseJSON.errors).flat().join('\n');
                    }
                    Swal.fire({
                        icon: 'error',
                        title: 'Submission Failed',
                        text: errorText
                    });
                }
            });
        }
    </script>
}
