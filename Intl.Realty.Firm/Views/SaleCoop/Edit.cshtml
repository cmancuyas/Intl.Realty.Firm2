@using Intl.Realty.Firm.Model.Model
@using Intl.Realty.Firm.Model.ViewModel.SaleCoopVM
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Newtonsoft.Json

@inject UserManager<ApplicationUser> _userManager;

@model EditSaleCoopWithTabMenuViewModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";

    var user = await _userManager.GetUserAsync(User);
    var isAgent = await _userManager.IsInRoleAsync(user!, "Agent");
    var isDealAdmin = await _userManager.IsInRoleAsync(user!, "DealAdmin");
    var isAdmin = await _userManager.IsInRoleAsync(user!, "Admin");
    var isSuperAdmin = await _userManager.IsInRoleAsync(user!, "SuperAdmin");
}

<partial name="~/Views/Shared/Modal/_ConfirmSubmitModal.cshtml" />
<partial name="~/Views/Shared/Modal/_ConfirmSuccessModal.cshtml" />
<partial name="~/Views/Shared/Modal/_ConfirmSaveModal.cshtml" />

<div class="page-controller mb-5">
    @*    <a href="@Url.Action("Index","SaleCoop")" class="text-decoration-none text-blue d-flex mb-4">
    <i data-feather="chevron-left"></i><span>Back</span>
    </a> *@
    <a href="##" class="back" onClick="history.go(-1); return false;">
        <i data-feather="chevron-left"></i><span>Back</span>
    </a>
    <div class="row justify-content-center">
        <div class="col-md-12 card mt-4 p-4 b-none bg-none">
            <h1 class="text-blue mb-0">Edit Sale Coop - Deal Id: @Model.EditSaleCoopViewModel.DealTransactionNumber - @Model.EditSaleCoopViewModel.DealStatus!.Description</h1>
            <hr class="my-4" />
            <form id="ListFormId"
            asp-action="Edit"
            asp-controller="SaleCoop"
            method="post"
            enctype="multipart/form-data">
                <input type="hidden" id="ActionTypeHidden" name="actionType" />

                <input type="hidden" asp-for="EditSaleCoopViewModel.Id" />
                <input type="hidden" asp-for="EditSaleCoopViewModel.DealTransactionNumber" />
                <input type="hidden" name="EditSaleCoopViewModel.RowVersion"
                       value="@Convert.ToBase64String(Model.EditSaleCoopViewModel.RowVersion)" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="tab-page">
                    <ul class="nav nav-tabs" id="administrationManagementTab" role="tablist" style="border:none">
                        @foreach (var item in Model.Menus)
                        {
                            <li class="nav-item mx-0">
                                <input type="hidden" id="menuId" name="menuId" value="@item.Id" />
                                <button class="nav-link @item.IsActive"
                                id="@item.Tab"
                                data-bs-toggle="tab"
                                data-bs-target="#@item.Control"
                                type="button"
                                role="tab"
                                aria-controls="@item.Control"
                                aria-selected="@item.IsSelected">
                                    @item.Description
                                </button>
                            </li>
                        }
                    </ul>
                </div>

                <div class="tab-content" style="border-bottom:none;background-color:white;">


                    <!-- Tab 1: IRF Details - Part 1 -->
                    <div class="tab-pane active" id="irfDetails1" aria-labelledby="irfDetails1-tab" style="background-color:white;">
                        @* Section: Deal Status for Admin *@
                        @{
                            if (isAdmin || isSuperAdmin || isDealAdmin)
                            {
                                @* Deal Status *@
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="control-label fw-bolder">Deal Status</label>
                                            <select id="EditSaleCoopViewModel.DealStatusId" name="EditSaleCoopViewModel.DealStatusId" class="form-select">
                                                @{
                                                    @if (Model.EditSaleCoopViewModel.DealStatusList != null)
                                                    {
                                                        @foreach (var dealStatus in Model.EditSaleCoopViewModel.DealStatusList)
                                                        {
                                                            if (dealStatus.Id == Model.EditSaleCoopViewModel.DealStatusId)
                                                            {
                                                                <option value="@dealStatus.Id" selected>@dealStatus.Description</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@dealStatus.Id">@dealStatus.Description</option>
                                                            }
                                                        }
                                                    }
                                                }
                                            </select>

                                            @Html.ValidationMessageFor(m => m.EditSaleCoopViewModel.DealStatusId, "", new { @class = "text-danger" })

                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <input type="hidden" name="EditSaleCoopViewModel.DealStatusId" value="1" />
                            }
                        }
                        <!-- 🏠 Property & Deal Info -->
                        <h4 class="mt-4 text-blue">Property & Deal Information</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.PropertyAddress" class="fw-bolder">Property Address</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.PropertyAddress" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.PropertyAddress" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.UpdatedByFullName" class="fw-bolder">Updated By</label>
                                <input asp-for="EditSaleCoopViewModel.UpdatedByFullName" class="form-control" disabled />
                                <span asp-validation-for="EditSaleCoopViewModel.UpdatedByFullName" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- 💰 Financial Details -->
                        <h4 class="mt-5 text-blue">Financial Details</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.FinalSalePrice" class="fw-bolder">Final Sale Price</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.FinalSalePrice" class="form-control" type="number" min="0" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.FinalSalePrice" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.FinalClosingDate" class="fw-bolder">Final Closing Date</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.FinalClosingDate" class="form-control" type="date" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.FinalClosingDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.DepositAmount" class="fw-bolder">Deposit Amount</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.DepositAmount" class="form-control" type="number" min="0" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.DepositAmount" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.DepositDate" class="fw-bolder">Deposit Date</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.DepositDate" class="form-control" type="date" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.DepositDate" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- 👤 Buyer Info -->
                        <h4 class="mt-5 text-blue">Buyer Details</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerName" class="fw-bolder">Buyer’s Name</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerName" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerEmail" class="fw-bolder">Buyer’s Email</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerEmail" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerEmail" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- 👤 Seller Info -->
                        <h4 class="mt-5 text-blue">Seller Details</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerName" class="fw-bolder">Seller’s Name</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerName" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerName" class="text-danger"></span>
                            </div>
                        </div>


                        <!-- 📊 Commission Info -->
                        <h4 class="mt-5 text-blue">Commission</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <div class="form-group">
                                    <label class="control-label fw-bolder">Co-op Commission Signage</label>
                                    <select id="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.Commission.BuyingCommissionSign" name="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.Commission.BuyingCommissionSign" class="form-select">
                                        @{
                                            @if (Model.EditSaleCoopViewModel.SignageIEnum != null)
                                            {
                                                @foreach (var item in Model.EditSaleCoopViewModel.SignageIEnum)
                                                {
                                                    int quarter = Convert.ToInt32(item.Value);
                                                    if (quarter == Model.EditSaleCoopViewModel.DefaultSignage)
                                                    {
                                                        <option value="@item.Value" selected>@item.Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@item.Value">@item.Text</option>
                                                    }
                                                }
                                            }
                                        }
                                    </select>

                                    @Html.ValidationMessageFor(m => m.EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.Commission.BuyingCommissionSign, "", new { @class = "text-danger" })

                                </div>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.Commission.BuyingCommission" class="fw-bolder">Co-op Commission</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.Commission.BuyingCommission" class="form-control" type="number" min="0" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.Commission.BuyingCommission" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 2: IRF Details - Part 2 -->
                    <div class="tab-pane" id="irfDetails2" aria-labelledby="irfDetails2-tab" style="background-color:white;">

                        <!-- 🧑‍💼 Buyer Agent & Brokerage Info -->
                        <h4 class="mt-4 text-blue">Buyer’s Agent & Brokerage Info</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerAgentName" class="fw-bolder">Buyer's Agent Name</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerAgentName" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerAgentName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerBrokerage" class="fw-bolder">Buyer's Brokerage</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerBrokerage" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerBrokerage" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerBrokerageFax" class="fw-bolder">Buyer's Brokerage Fax</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerBrokerageFax" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerBrokerageFax" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerBrokeragePhoneNumber" class="fw-bolder">Buyer's Brokerage Phone Number</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerBrokeragePhoneNumber" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerBrokeragePhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerBrokerageEmail" class="fw-bolder">Buyer's Brokage Email</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerBrokerageEmail" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerBrokerageEmail" class="text-danger"></span>
                            </div>
                        </div>
                        <!-- 📜 Buyer Legal Info -->
                        <h4 class="mt-5 text-blue">Buyer’s Legal Info</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerLawyer" class="fw-bolder">Buyer's Lawyer</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerLawyer" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerLawyer" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerLawyerAddress" class="fw-bolder">Buyer's Lawyer Address</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerLawyerAddress" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerLawyerAddress" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerLawyerPhone" class="fw-bolder">Buyer's Lawyer Phone</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerLawyerPhone" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerLawyerPhone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerLawyerEmail" class="fw-bolder">Buyer's Lawyer Email</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerLawyerEmail" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.BuyerDetails.BuyerLawyerEmail" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- 🧾 Seller's Agent & Brokerage Info -->
                        <h4 class="mt-5 text-blue">Seller's Agent & Brokerage Info</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerAgentName" class="fw-bolder">Seller's Agent Name</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerAgentName" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerAgentName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerBrokerage" class="fw-bolder">Seller's Brokerage</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerBrokerage" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerBrokerage" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerBrokerageFax" class="fw-bolder">Seller's Brokerage Fax</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerBrokerageFax" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerBrokerageFax" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerBrokeragePhoneNumber" class="fw-bolder">Seller's Brokerage Phone Number</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerBrokeragePhoneNumber" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerBrokeragePhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerBrokerageEmail" class="fw-bolder">Seller's Brokerage Email</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerBrokerageEmail" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerBrokerageEmail" class="text-danger"></span>
                            </div>
                        </div>
                        <!-- 🧾 Seller & Legal Info -->
                        <h4 class="mt-5 text-blue">Seller's Legal Info</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerLawyer" class="fw-bolder">Seller's Lawyer</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerLawyer" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerLawyer" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerLawyerAddress" class="fw-bolder">Seller's Lawyer Address</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerLawyerAddress" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerLawyerAddress" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerLawyerPhone" class="fw-bolder">Seller's Lawyer Phone Number</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerLawyerPhone" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerLawyerPhone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerLawyerEmail" class="fw-bolder">Seller's Lawyer Email</label>
                                <input asp-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerLawyerEmail" class="form-control" />
                                <span asp-validation-for="EditSaleCoopViewModel.EditIRFDealSaleCoopViewModel.SellerDetails.SellerLawyerEmail" class="text-danger"></span>
                            </div>

                        </div>
                    </div>

                    <div class="tab-pane" id="viewFileUploads" aria-labelledby="viewFileUploads-tab" style="background-color:white;">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-submit-tab mt-3 bg-white" style="display: block !important">
                                    <div class="table-responsive">
                                        <table>
                                            <thead class="bg-blue">
                                                <tr>
                                                    <th class="w-5 text-white ps-3 p-2">Document Type</th>
                                                    <th class="w-5 text-white ps-3 p-2">Filename</th>
                                                    <th class="w-5 text-white ps-3 p-2">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="fileTableBody">
                                                @foreach (var fileUpload in Model.EditSaleCoopViewModel.FileUploads!)
                                                {
                                                    var docType = Model.EditSaleCoopViewModel.DocumentTypeList!
                                                        .FirstOrDefault(dt => dt.Id == fileUpload.DocumentTypeId && !dt.IsDeleted); // add !dt.IsDeleted

                                                    if (docType != null)
                                                    {
                                                        <tr class="border-bottom">
                                                            <td class="p-2">
                                                                <span class="mt-3 ms-2 mb-1">@docType.Description (@docType.Id)</span>
                                                            </td>
                                                            <td class="w-5 ps-2">
                                                                @fileUpload.OriginalFileName
                                                            </td>
                                                            <td class="w-5 ps-2">
                                                                <a asp-action="Download" asp-route-id="@fileUpload.Id" class="btn btn-secondary" target="_blank">
                                                                    Download
                                                                </a>
                                                                <button type="button"
                                                                        class="btn btn-danger btn-delete-file"
                                                                        data-file-id="@fileUpload.Id"
                                                                        data-coop-id="@Model.EditSaleCoopViewModel.Id">
                                                                    Delete
                                                                </button>
                                                                <a asp-action="PreviewFile" asp-route-id="@fileUpload.Id" class="btn btn-secondary" target="_blank">
                                                                    Preview
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>

                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>



                    <div class="tab-pane" id="createFileUploads" aria-labelledby="createFileUploads-tab" style="background-color:white;">
                        <div class="row d-flex justify-content-center m-0">
                            <div class="col-md-12">
                                <h5 class="text-blue mb-4">
                                    Please match your uploaded file based on the Document Type for Sale Listing.
                                    <span class="s-required">*</span>
                                </h5>
                                <table class="table dataTable" id="tblApplicantFiles" width="100%">
                                    <thead>
                                        <tr>
                                            <th style="width: 30%">Document Type</th>
                                            <th>Is Required?</th>
                                            <th>Uploaded Document</th>
                                        </tr>
                                    </thead>
                                    @{
                                        // Convert to list so we can use indices.
                                        var docAssignments = Model.EditSaleCoopViewModel.DocumentTypeAssignmentList
                                        .Where(x => !x.IsDeleted
                                        && x.IsActive
                                        && x.DocumentType != null
                                        && !x.DocumentType.IsDeleted
                                        && x.DocumentType.IsActive)
                                        .ToList();
                                    }
                                    <tbody>
                                        @for (int i = 0; i < docAssignments.Count; i++)
                                        {
                                            var item = docAssignments[i];
                                            <tr data-document-type-id="@item.DocumentType.Id">
                                                <td style="width: 30%">
                                                    @item.DocumentType.Description
                                                    <input type="hidden"
                                                           name="EditSaleCoopViewModel.CreateFileUploadListViewModel.CreateFileUploadsViewModel[@i].DocumentTypeId"
                                                           value="@item.DocumentType.Id" />
                                                </td>
                                                <td id="isRequired">
                                                    @if (item.IsRequired == true)
                                                    {
                                                        <label class="status-active">Required</label>
                                                    }
                                                    else if (item.IsRequired == false)
                                                    {
                                                        <label class="status-inactive pe-cursor">Not Required</label>
                                                    }
                                                </td>
                                                <td>
                                                    <input type="file"
                                                           name="EditSaleCoopViewModel.CreateFileUploadListViewModel.CreateFileUploadsViewModel[@i].Files"
                                                           id="fileListDropDown_@i"
                                                           class="file"
                                                           multiple
                                                           data-show-upload="false"
                                                           data-allowed-file-extensions='["pdf","doc","docx","xls","xlsx"]'
                                                           accept="application/all"
                                                           data-show-caption="true"
                                                           data-show-preview="false"
                                                           data-msg-placeholder="Select {files} for upload..." />
                                                    <!-- Optional: <span style="font-size:11px;color:gray;">Index: @i, DocTypeId: @item.DocumentType.Id</span> -->
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane" id="notes" aria-labelledby="notes-tab" style="background-color:white;">
                        <div class="col-md-12 mt-4">
                            <div class="form-group">
                                <label asp-for="EditSaleCoopViewModel.Notes" class="control-label fw-bolder">Notes</label>
                                @Html.TextAreaFor(model => model.EditSaleCoopViewModel.Notes, 10, 100, new { @class = "form-control" })

                            </div>
                        </div>
                    </div>
                </div>
                @*               <div class="row mb-4">
                <div class="col-md-12">
                <div class="form-check form-switch d-flex align-items-center gap-2">
                <input id="isDeletedCheckbox" class="form-check-input" type="checkbox" asp-for="IsDeleted">
                <label id="lblStatusSoftDelete" class="fw-bolder">Not Deleted</label>
                </div>
                <span asp-validation-for="IsDeleted" class="text-danger"></span>
                </div>
                </div> *@
                <div class="mt-4">
                    @await Html.PartialAsync("~/Views/Shared/Transaction/_EditActionButtons.cshtml", Model.EditSaleCoopViewModel.DealStatusId)
                </div>



            </form>
        </div>
    </div>
</div>




@section Scripts {
    @* ASP.NET Core client-side validation *@
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @* JS Utilities and Plugins *@
    <script src="~/js/viewDataTableUtility.js" asp-append-version="true"></script>
    <script src="~/js/submitUtility.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @* Submit Handler Initialization *@
    <script>
        const documentTypeAssignments = @Html.Raw(JsonConvert.SerializeObject(Model.EditSaleCoopViewModel.DocumentTypeAssignmentList));
        const isAdminLike = @((User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("DealAdmin")).ToString().ToLower());

        $(document).ready(function () {
            initializeSubmitHandlers({
                formId: "ListFormId",
                dealStatusDropdownSelector: '[name="EditSaleCoopViewModel.DealStatusId"]',
                isAdminLike: isAdminLike,
                fileErrorScrollTargetId: "fileUploads",
                documentTypeAssignment: documentTypeAssignments
            });
            
             $('.btn-delete-file').on('click', function (e) {
                    e.preventDefault();
                    var $btn = $(this);
                    var fileId = $btn.data('file-id');
                    var coopId = $btn.data('coop-id');
                    Swal.fire({
                        title: 'Are you sure?',
                        text: "This will permanently delete the file.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#aaa',
                        confirmButtonText: 'Yes, delete it!'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $.ajax({
                                url: '/SaleCoop/DeleteFileAjax/' + fileId,
                                type: 'POST',
                                headers: {
                                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                                },
                                success: function (res) {
                                    if (res.success) {
                                        Swal.fire('Deleted!', 'File has been deleted.', 'success').then(() => {
                                            location.reload(); // reload page to reflect change
                                        });
                                    } else {
                                        Swal.fire('Error!', 'Could not delete the file.', 'error');
                                    }
                                }
                            });
                        }
                    });
                });
        });

    </script>

}
