                        }
                        @if (isAdmin || isSuperAdmin || isDealAdmin || isAgent && Model.EditSaleCoop.DealStatus!.Id == 1) //Saved
                        {
                            <button type="button" id="btnEditRequest" data-bs-toggle="modal" data-bs-target="#sendEditRequestModal" class="btn btn-primary w-15">Edit Request</button>
                            <!-- Button trigger modal -->
                        }
                    }

                    @{
                        @if (isAdmin || isSuperAdmin || isAgent && Model.EditSaleCoop.DealStatus!.Id == 2) //Saved
                        {

                            <button type="button" id="btnSubmit" class="btn btn-primary w-15" onclick="$('.text-danger').show();">Submit</button>
                        }
                    }

                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="sendEditRequestModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Are you sure you want to edit this Deal?</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Click continue to request editing this deal to DealAdmin
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="window.location.href='@Url.Action("SendRequestToDealAdmin", "SaleCoop", new{ dealId = @Model.EditSaleCoop.Id})'">Continue</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/viewdatatableutility.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {

            onBtnSubmit();
            onBtnSave();
            confirmSubmitModal();
            confirmSaveModal();

            $('#isActiveCheckbox').on('click', toggleStatusLabels);
            $('#isDeletedCheckbox').on('click', toggleStatusLabelSoftDelete);

            toggleStatusLabels();
            toggleStatusLabelSoftDelete();
        });

        function filesValidation() {
            var SaleCoopId = '@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.EditSaleCoop.Id))';
            var documentTypeListSerialized = '@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.EditSaleCoop.DocumentTypeList))';
            var documentTypesWithFileUploads = getFileUploads(SaleCoopId);
            var documentTypeList = JSON.parse(documentTypeListSerialized);
            var openModalFlag = true;

            var error = [];
            documentTypeList.forEach(function (item, index) {

                var formFiles = document.forms['ListFormId']['EditSaleCoop.CreateFileUploadListViewModel.CreateFileUploadsViewModel[' + index + '].Files'];

                var documentType = documentTypesWithFileUploads.find(x => x == item.Id);

                if (item.IsRequired == true && formFiles.value != "") {
                    // Do nothing - means valid
                } else if (item.IsRequired != true && formFiles.value == "") {
                    // Do nothing - means valid
                } else if (item.IsRequired != true && formFiles.value != "") {
                    // Do nothing - means valid
                } else if (documentType && item.IsRequired == true) {
                    // Do nothing - means valid
                }
                else {
                    openModalFlag = false;

                    var title = item.Description + " is required.";
                    error.push(title);
                }
            })
            if (error.length > 0) {

                debugger;

                Swal.fire({
                    title: error[0],
                    text: "Please upload the required documents to proceed with the application.",
                    icon: "error",
                    confirmButtonColor: '#203D57'
                });
            }

            return openModalFlag;
        }
    </script>

}