@using Intl.Realty.Firm.Model.Model
@using Intl.Realty.Firm.Model.ViewModel.SaleCoopVM

@model CreateSaleCoopWithTabMenuViewModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}
<partial name="~/Views/Shared/Modal/_ConfirmSubmitModal.cshtml" />
<partial name="~/Views/Shared/Modal/_ConfirmSuccessModal.cshtml" />
<partial name="~/Views/Shared/Modal/_ConfirmSaveModal.cshtml" />
<div class="page-controller mb-5">
    @*     <a href="@Url.Action("Index","SaleCoop")" class="text-decoration-none text-blue d-flex mb-4">
    <i data-feather="chevron-left"></i><span>Back</span>
    </a> *@
    <a href="##" class="back" onClick="history.go(-1); return false;">
        <i data-feather="chevron-left"></i><span>Back</span>
    </a>
    <div class="row justify-content-center">
        <div class="col-md-12 card b-none mt-4 p-4" style="background: transparent;">
            <h1 class="text-blue mb-0">Create Sale Coop</h1>
            <hr class="my-4" />
            <form asp-action="Create"
                  asp-controller="SaleCoop"
                  method="post"
                  enctype="multipart/form-data">
                <input asp-for="CreateSaleCoop.DealTransactionNumber" hidden />
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="tab-page">
                    <ul class="nav nav-tabs" id="consultantStatusManagementTab" role="tablist" style="border:none">
                        @foreach (var item in Model.Menus)
                        {
                            <li class="nav-item mx-0">
                                <input type="hidden" id="menuId" name="menuId" value="@item.Id" />
                                <button class="nav-link @item.IsActive"
                                        id="@item.Tab"
                                        data-bs-toggle="tab"
                                        data-bs-target="#@item.Control"
                                        type="button"
                                        role="tab"
                                        aria-controls="@item.Control"
                                        aria-selected="@item.IsSelected">
                                    @item.Description
                                </button>
                            </li>
                        }
                    </ul>
                </div>
                <div class="tab-content" style="background-color:white;">

                    <div class="tab-pane active" id="irfDetails1" aria-labelledby="irfDetails1-tab" style="background-color:white;">
                        <div class="row">
                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.PropertyAddress" class="control-label fw-bolder">Property Address</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.PropertyAddress" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.PropertyAddress" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreatedByFullName" class="control-label fw-bolder">Created By</label>
                                    <input asp-for="CreateSaleCoop.CreatedByFullName" disabled class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreatedByFullName" class="text-danger"></span>
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.FinalSalePrice" class="control-label fw-bolder">Final Sale Price</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.FinalSalePrice" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.FinalSalePrice" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.FinalClosingDate" class="control-label fw-bolder">Final Closing Date</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.FinalClosingDate" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.FinalClosingDate" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.DepositAmount" class="control-label fw-bolder">Deposit Amount</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.DepositAmount" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.DepositAmount" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.DepositDate" class="control-label fw-bolder">Deposit Date</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.DepositDate" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.DepositDate" class="text-danger"></span>
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.BuyerName" class="control-label fw-bolder">Buyers Name</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.BuyerName" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.BuyerName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.LandLordName" class="control-label fw-bolder">LandLords Name</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.LandLordName" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.LandLordName" class="text-danger"></span>
                                </div>
                            </div>

                        </div>

                        <div class="row">
                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.ListingCommissionPercentage" class="control-label fw-bolder">Listing Commission Percentage</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.ListingCommissionPercentage" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.ListingCommissionPercentage" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.BuyingCommissionPercentage" class="control-label fw-bolder">Buying Commission Percentage</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.BuyingCommissionPercentage" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.BuyingCommissionPercentage" class="text-danger"></span>
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.ListingAgentName" class="control-label fw-bolder">Listing Agent Name</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.ListingAgentName" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.ListingAgentName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.ListingBrokerage" class="control-label fw-bolder">Listing Brokerage</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.ListingBrokerage" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.ListingBrokerage" class="text-danger"></span>
                                </div>
                            </div>

                        </div>
                        <div class="row">


                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.ListingBrokerageFax" class="control-label fw-bolder">Listing Brokerage Fax</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.ListingBrokerageFax" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.ListingBrokerageFax" class="text-danger"></span>
                                </div>
                            </div>


                        </div>

                    </div>

                    <div class="tab-pane" id="irfDetails2" aria-labelledby="irfDetails2-tab" style="background-color:white;">

                        <div class="row">

                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.BuyerAgentName" class="control-label fw-bolder">Buyer Agent Name</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.BuyerAgentName" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.BuyerAgentName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.BuyerBrokerage" class="control-label fw-bolder">Buyer Brokerage</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.BuyerBrokerage" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.BuyerBrokerage" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">

                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.BuyerBrokerageFax" class="control-label fw-bolder">Buyer Brokerage Fax</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.BuyerBrokerageFax" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.BuyerBrokerageFax" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.SellersLawyer" class="control-label fw-bolder">Sellers Lawyer</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.SellersLawyer" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.SellersLawyer" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">

                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.SellersLawyerAddress" class="control-label fw-bolder">Sellers Lawyer Address</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.SellersLawyerAddress" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.SellersLawyerAddress" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.BuyersLawyer" class="control-label fw-bolder">Buyers Lawyer</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.BuyersLawyer" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.BuyersLawyer" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">


                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.SellersPhoneNumber" class="control-label fw-bolder">Sellers Phone Number</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.SellersPhoneNumber" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.SellersPhoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.BuyersLawyerAddress" class="control-label fw-bolder">Buyers Lawyer Address</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.BuyersLawyerAddress" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.BuyersLawyerAddress" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">


                            <div class="col-md-6 mt-4">
                                <div class="form-group">
                                    <label asp-for="CreateSaleCoop.CreateIRFDealViewModel.BuyersPhoneNumber" class="control-label fw-bolder">Buyers PhoneNumber</label>
                                    <input asp-for="CreateSaleCoop.CreateIRFDealViewModel.BuyersPhoneNumber" class="form-control" />
                                    <span asp-validation-for="CreateSaleCoop.CreateIRFDealViewModel.BuyersPhoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane" id="fileUploads" aria-labelledby="fileUploads-tab" style="background-color:white;">
                        <div class="row d-flex justify-content-center m-0">
                            <div class="col-md-12">
                                <h5 class="text-blue mb-4">Please match your uploaded file based on the Document Type for Sale Listing.<span class="s-required">*</span></h5>
                                <table class="table dataTable" id="tblApplicantFiles" width="100%">
                                    <thead>
                                        <tr>
                                            <th style="width: 30%">Document Type</th>
                                            <th>Is Required?</th>
                                            <th>Uploaded Document</th>

                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int i = 0;
                                        }
                                        @foreach (DocumentType item in Model.CreateSaleCoop.DocumentTypeList!)
                                        {
                                            <tr>
                                                <td style="width: 30%">
                                                    @Html.DisplayFor(modelItem => item.Description)
                                                </td>
                                                <input type="hidden"
                                                       asp-for="CreateSaleCoop.CreateFileUploadListViewModel.CreateFileUploadsViewModel[i].DocumentTypeId"
                                                       value="@item.Id" />
                                                <td id="isRequired">
                                                    @if (item.IsRequired == true)
                                                    {
                                                        <label class="status-active">Required</label>
                                                    }
                                                    else if (item.IsRequired == false)
                                                    {
                                                        <label class="status-inactive pe-cursor">Not Required</label>
                                                    }
                                                </td>
                                                <td>
                                                    <input asp-for="CreateSaleCoop.CreateFileUploadListViewModel.CreateFileUploadsViewModel[i].Files"
                                                           id="fileListDropDown_@i"
                                                           type="file"
                                                           class="file"
                                                           multiple
                                                           data-show-upload="false"
                                                           data-allowed-file-extensions='["pdf","doc","docx","xls","xlsx"]'
                                                           accept="application/all"
                                                           data-show-caption="true"
                                                           data-show-preview="false"
                                                           @* onchange="fileSelected(this)" *@
                                                           data-msg-placeholder="Select {files} for upload...">
                                                </td>
                                                @{
                                                    i++;
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                    <div class="tab-pane" id="notes" aria-labelledby="notes-tab" style="background-color:white;">
                        <div class="col-md-12 mt-4">
                            <div class="form-group">
                                <label asp-for="CreateSaleCoop.Notes" class="control-label fw-bolder">Notes</label>
                                @Html.TextAreaFor(model => model.CreateSaleCoop.Notes, 10, 100, new { @class = "form-control" })

                            </div>
                        </div>
                    </div>

                </div>

                <hr class="my-5" />
                <div class="form-group d-flex justify-content-center gap-4">
                    <input type="button" value="Cancel" class="btn btn-secondary w-15" onclick="window.location.href='@Url.Action("Index", "SaleCoop")'" />
                    @* <button type="reset" class="btn btn-secondary w-15" onclick="$('.text-danger').hide();">Reset</button> *@
                    <button type="submit"
                            id="btnSubmit"
                            class="btn btn-primary w-15" onclick="$('.text-danger').show();">
                        Submit
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/viewDataTableUtility.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(document).ready(function () {

            // onBtnSubmitCreate();

            // confirmSubmitModal();

        })


    </script>
}