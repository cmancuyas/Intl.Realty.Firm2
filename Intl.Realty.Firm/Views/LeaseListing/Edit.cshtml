                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.Commission.ListingCommissionPercentage" class="fw-bolder">Listing Commission %</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.Commission.ListingCommissionPercentage" class="form-control" type="number" step="0.01" min="0" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.Commission.ListingCommissionPercentage" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.Commission.BuyingCommissionPercentage" class="fw-bolder">Buying Commission %</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.Commission.BuyingCommissionPercentage" class="form-control" type="number" step="0.01" min="0" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.Commission.BuyingCommissionPercentage" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.ListingInfo.ListingAgentName" class="fw-bolder">Listing Agent Name</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.ListingInfo.ListingAgentName" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.ListingInfo.ListingAgentName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.ListingInfo.ListingBrokerage" class="fw-bolder">Listing Brokerage</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.ListingInfo.ListingBrokerage" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.ListingInfo.ListingBrokerage" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.ListingInfo.ListingBrokerageFax" class="fw-bolder">Listing Brokerage Fax</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.ListingInfo.ListingBrokerageFax" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.ListingInfo.ListingBrokerageFax" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane" id="irfDetails2" aria-labelledby="irfDetails2-tab" style="background-color:white;">

                        <!-- Section: Tenant Representation -->
                        <h4 class="mt-4 text-blue">Tenant Representation</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantAgentName" class="fw-bolder">Tenant Agent Name</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantAgentName" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantAgentName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantBrokerage" class="fw-bolder">Tenant Brokerage</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantBrokerage" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantBrokerage" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantBrokerageFax" class="fw-bolder">Tenant Brokerage Fax</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantBrokerageFax" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantBrokerageFax" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantPhoneNumber" class="fw-bolder">Tenant Phone Number</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantPhoneNumber" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantPhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Section: Landlord Contact -->
                        <h4 class="mt-5 text-blue">Landlord Contact</h4>
                        <div class="row">
