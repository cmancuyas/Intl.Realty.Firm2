@using Intl.Realty.Firm.Model.Model
@using Intl.Realty.Firm.Model.ViewModel.LeaseListingVM
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Newtonsoft.Json

@inject UserManager<ApplicationUser> _userManager;

@model EditLeaseListingWithTabMenuViewModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";

    var user = await _userManager.GetUserAsync(User);
    var isAgent = await _userManager.IsInRoleAsync(user!, "Agent");
    var isDealAdmin = await _userManager.IsInRoleAsync(user!, "DealAdmin");
    var isAdmin = await _userManager.IsInRoleAsync(user!, "Admin");
    var isSuperAdmin = await _userManager.IsInRoleAsync(user!, "SuperAdmin");
}

<partial name="~/Views/Shared/Modal/_ConfirmSubmitModal.cshtml" />
<partial name="~/Views/Shared/Modal/_ConfirmSuccessModal.cshtml" />
<partial name="~/Views/Shared/Modal/_ConfirmSaveModal.cshtml" />

<div class="page-controller mb-5">
    @*    <a href="@Url.Action("Index","LeaseListing")" class="text-decoration-none text-blue d-flex mb-4">
    <i data-feather="chevron-left"></i><span>Back</span>
    </a> *@
    <a href="##" class="back" onClick="history.go(-1); return false;">
        <i data-feather="chevron-left"></i><span>Back</span>
    </a>
    <div class="row justify-content-center">
        <div class="col-md-12 card mt-4 p-4 b-none bg-none">
            <h1 class="text-blue mb-0">Edit Lease Listing - Deal Id: @Model.EditLeaseListingViewModel.DealTransactionNumber - @Model.EditLeaseListingViewModel.DealStatus!.Description</h1>
            <hr class="my-4" />
            <form id="ListFormId"
                  asp-action="Edit"
                  asp-controller="LeaseListing"
                  method="post"
                  enctype="multipart/form-data">
                <input type="hidden" id="ActionTypeHidden" name="actionType" />
                <input type="hidden" name="EditLeaseListingViewModel.RowVersion"
                       value="@Convert.ToBase64String(Model.EditLeaseListingViewModel.RowVersion)" />
                <input type="hidden" asp-for="EditLeaseListingViewModel.Id" />
                <input type="hidden" asp-for="EditLeaseListingViewModel.DealTransactionNumber" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="tab-page">
                    <ul class="nav nav-tabs" id="administrationManagementTab" role="tablist" style="border:none">
                        @foreach (var item in Model.Menus)
                        {
                            <li class="nav-item mx-0">
                                <input type="hidden" id="menuId" name="menuId" value="@item.Id" />
                                <button class="nav-link @item.IsActive"
                                        id="@item.Tab"
                                        data-bs-toggle="tab"
                                        data-bs-target="#@item.Control"
                                        type="button"
                                        role="tab"
                                        aria-controls="@item.Control"
                                        aria-selected="@item.IsSelected">
                                    @item.Description
                                </button>
                            </li>
                        }
                    </ul>
                </div>

                <div class="tab-content" style="border-bottom:none;background-color:white;">

                    <div class="tab-pane active" id="irfDetails1" aria-labelledby="irfDetails1-tab" style="background-color:white;">

                        @{
                            if (isAdmin || isSuperAdmin || isDealAdmin)
                            {
                                @* Deal Status *@
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="control-label fw-bolder">Deal Status</label>
                                            <select id="EditLeaseListing.DealStatusId" name="EditLeaseListingViewModel.DealStatusId" class="form-select">
                                                @{
                                                    @if (Model.EditLeaseListingViewModel.DealStatusList != null)
                                                    {
                                                        @foreach (var dealStatus in Model.EditLeaseListingViewModel.DealStatusList)
                                                        {
                                                            if (dealStatus.Id == Model.EditLeaseListingViewModel.DealStatusId)
                                                            {
                                                                <option value="@dealStatus.Id" selected>@dealStatus.Description</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@dealStatus.Id">@dealStatus.Description</option>
                                                            }
                                                        }
                                                    }
                                                }
                                            </select>

                                            @Html.ValidationMessageFor(m => m.EditLeaseListingViewModel.DealStatusId, "", new { @class = "text-danger" })

                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <input type="hidden" name="EditLeaseListingViewModel.DealStatusId" value="1" />
                            }
                        }

                        <!-- Section: Property Info -->
                        <h4 class="mt-4 text-blue">Property Information</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.PropertyAddress" class="fw-bolder">Property Address</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.PropertyAddress" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.PropertyAddress" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.UpdatedByFullName" class="fw-bolder">Updated By</label>
                                <input asp-for="EditLeaseListingViewModel.UpdatedByFullName" class="form-control" disabled />
                                <span asp-validation-for="EditLeaseListingViewModel.UpdatedByFullName" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Section: Financial Info -->
                        <h4 class="mt-5 text-blue">Financial Information</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.FinalLeasePrice" class="fw-bolder">Final Lease Price</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.FinalLeasePrice" class="form-control" type="number" min="0" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.FinalLeasePrice" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.FinalClosingDate" class="fw-bolder">Final Closing Date</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.FinalClosingDate" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.FinalClosingDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.DepositAmount" class="fw-bolder">Deposit Amount</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.DepositAmount" class="form-control" type="number" min="0" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.DepositAmount" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.DepositDate" class="fw-bolder">Deposit Date</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.DepositDate" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.DepositDate" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Tenant Details -->
                        <h4 class="mt-5 text-blue">Tenant Details</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantName" class="fw-bolder">Tenant's Name</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantName" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantEmailAddress" class="fw-bolder">Tenant's Email</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantEmailAddress" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantEmailAddress" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantPhoneNumber" class="fw-bolder">Tenant's Phone Number</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantPhoneNumber" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantPhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Landlord Info -->
                        <h4 class="mt-5 text-blue">Landlord Info</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordName" class="fw-bolder">Landlord Name</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordName" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordPhoneNumber" class="fw-bolder">Landlord Phone</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordPhoneNumber" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordPhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordEmailAddress" class="fw-bolder">Landlord Email</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordEmailAddress" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordEmailAddress" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Section: Commission & Listing -->
                        <h4 class="mt-5 text-blue">Commission & Listing Info</h4>
                        <div class="row">
                            <!-- Total Commission Signage -->
                            <div class="col-md-6 mt-3">
                                <div class="form-group">
                                    <label class="control-label fw-bolder">Total Commission Signage</label>
                                    <select id="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.Commission.ListingCommissionSign"
                                            name="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.Commission.ListingCommissionSign"
                                            class="form-select">
                                        @if (Model.EditLeaseListingViewModel.SignageIEnum != null)
                                        {
                                            foreach (var item in Model.EditLeaseListingViewModel.SignageIEnum)
                                            {
                                                int signageValue = Convert.ToInt32(item.Value);
                                                if (signageValue == Model.EditLeaseListingViewModel.DefaultSignage)
                                                {
                                                    <option value="@item.Value" selected>@item.Text</option>
                                                }
                                                else
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            }
                                        }
                                    </select>
                                    @Html.ValidationMessageFor(m => m.EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.Commission.ListingCommissionSign, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <!-- Total Commission -->
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.Commission.ListingCommission" class="fw-bolder">Total Commission</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.Commission.ListingCommission" class="form-control" type="number" step="0.01" min="0" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.Commission.ListingCommission" class="text-danger"></span>
                            </div>

                            <!-- Co-op Commission Signage -->
                            <div class="col-md-6 mt-3">
                                <div class="form-group">
                                    <label class="control-label fw-bolder">Co-op Commission Signage</label>
                                    <select id="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.Commission.BuyingCommissionSign"
                                            name="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.Commission.BuyingCommissionSign"
                                            class="form-select">
                                        @if (Model.EditLeaseListingViewModel.SignageIEnum != null)
                                        {
                                            foreach (var item in Model.EditLeaseListingViewModel.SignageIEnum)
                                            {
                                                int signageValue = Convert.ToInt32(item.Value);
                                                if (signageValue == Model.EditLeaseListingViewModel.DefaultSignage)
                                                {
                                                    <option value="@item.Value" selected>@item.Text</option>
                                                }
                                                else
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            }
                                        }
                                    </select>
                                    @Html.ValidationMessageFor(m => m.EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.Commission.BuyingCommissionSign, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <!-- Co-op Buying Commission -->
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.Commission.BuyingCommission" class="fw-bolder">Co-op Buying Commission</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.Commission.BuyingCommission" class="form-control" type="number" step="0.01" min="0" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.Commission.BuyingCommission" class="text-danger"></span>
                            </div>

                            <!-- Listing Agent Name -->
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.ListingInfo.ListingAgentName" class="fw-bolder">Listing Agent Name</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.ListingInfo.ListingAgentName" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.ListingInfo.ListingAgentName" class="text-danger"></span>
                            </div>

                            <!-- Listing Brokerage -->
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.ListingInfo.ListingBrokerage" class="fw-bolder">Listing Brokerage</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.ListingInfo.ListingBrokerage" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.ListingInfo.ListingBrokerage" class="text-danger"></span>
                            </div>

                            <!-- Listing Brokerage Fax -->
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.ListingInfo.ListingBrokerageFax" class="fw-bolder">Listing Brokerage Fax</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.ListingInfo.ListingBrokerageFax" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.ListingInfo.ListingBrokerageFax" class="text-danger"></span>
                            </div>
                        </div>



                    </div>

                    <div class="tab-pane" id="irfDetails2" aria-labelledby="irfDetails2-tab" style="background-color:white;">

                        <!-- Section: Tenant Representation -->
                        <h4 class="mt-4 text-blue">Tenant Representation</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantAgentName" class="fw-bolder">Tenant Agent Name</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantAgentName" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantAgentName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantBrokerage" class="fw-bolder">Tenant Brokerage</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantBrokerage" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantBrokerage" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantBrokerageFax" class="fw-bolder">Tenant Brokerage Fax</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantBrokerageFax" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantBrokerageFax" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantPhoneNumber" class="fw-bolder">Tenant Phone Number</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantPhoneNumber" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantPhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Section: Landlord Contact -->
                        <h4 class="mt-5 text-blue">Landlord Contact</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordPhoneNumber" class="fw-bolder">Landlord Phone Number</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordPhoneNumber" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordPhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordEmailAddress" class="fw-bolder">Landlord Email Address</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordEmailAddress" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordEmailAddress" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane" id="viewFileUploads" aria-labelledby="viewFileUploads-tab" style="background-color:white;">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-submit-tab mt-3 bg-white" style="display:block !important">

                                    <div class="table-responsive">
                                        <table class="table table-bordered file-upload-table">
                                            <thead>
                                                <tr>
                                                    <th class="ps-3 p-2" style="width:30%;">Document Type</th>
                                                    <th class="ps-3 p-2" style="width:35%;">Filename</th>
                                                    <th class="ps-3 p-2 text-center" style="width:35%;">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="fileTableBody">
                                                @if (Model.EditLeaseListingViewModel.FileUploads != null &&
                                                                                 Model.EditLeaseListingViewModel.FileUploads.Any(x => x.IsActive && !x.IsDeleted))
                                                {
                                                    foreach (var fileUpload in Model.EditLeaseListingViewModel.FileUploads
                                                        .Where(x => x.IsActive && !x.IsDeleted))
                                                    {
                                                        var docType = Model.EditLeaseListingViewModel.DocumentTypeList?
                                                            .FirstOrDefault(dt => dt.Id == fileUpload.DocumentTypeId && !dt.IsDeleted);

                                                        if (docType != null)
                                                        {
                                                            <tr>
                                                                <td class="p-2">@docType.Description</td>
                                                                <td class="p-2 text-break">
                                                                    @(string.IsNullOrWhiteSpace(fileUpload.OriginalFileName)
                                                                        ? fileUpload.FileName
                                                                        : fileUpload.OriginalFileName)
                                                                </td>
                                                                <td class="p-2 text-center">
                                                                    <a asp-action="Download"
                                                                           asp-route-id="@fileUpload.Id"
                                                                           class="btn btn-secondary"
                                                                           target="_blank">
                                                                        Download
                                                                    </a>
                                                                    <button type="button"
                                                                            class="btn btn-danger btn-delete-file"
                                                                            data-file-id="@fileUpload.Id">
                                                                        Delete
                                                                    </button>
                                                                    <a asp-action="PreviewFile"
                                                                           asp-controller="LeaseListing"
                                                                           asp-route-id="@fileUpload.Id"
                                                                           class="btn btn-secondary"
                                                                           target="_blank">
                                                                        Preview
                                                                    </a>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="3" class="text-center">No associated files found.</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="table-responsive mt-4">
                                        <table class="table table-bordered file-upload-table" id="tblSavedAdditionalDocuments">
                                            <thead>
                                                <tr>
                                                    <th class="ps-3 p-2" style="width:30%;">Document Name</th>
                                                    <th class="ps-3 p-2" style="width:35%;">Filename</th>
                                                    <th class="ps-3 p-2 text-center" style="width:35%;">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="additionalDocumentTableBody">
                                                @if (Model.EditLeaseListingViewModel.SavedAdditionalDocuments != null &&
                                                                                 Model.EditLeaseListingViewModel.SavedAdditionalDocuments.Any(x => x.IsActive && !x.IsDeleted))
                                                {
                                                    foreach (var item in Model.EditLeaseListingViewModel.SavedAdditionalDocuments
                                                        .Where(x => x.IsActive && !x.IsDeleted))
                                                    {
                                                        <tr id="additionalDocumentRow_@item.Id">
                                                            <td class="p-2 text-break">@item.DocumentName</td>
                                                            <td class="p-2 text-break">@item.OriginalFileName</td>
                                                            <td class="p-2 text-center">
                                                                <a asp-action="DownloadAdditionalDocument"
                                                                       asp-route-id="@item.Id"
                                                                       class="btn btn-secondary"
                                                                       target="_blank">
                                                                    Download
                                                                </a>
                                                                <button type="button"
                                                                        class="btn btn-danger btn-delete-additional-document"
                                                                        data-id="@item.Id">
                                                                    Delete
                                                                </button>
                                                                <a asp-action="PreviewAdditionalDocument"
                                                                       asp-route-id="@item.Id"
                                                                       class="btn btn-secondary"
                                                                       target="_blank">
                                                                    Preview
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="3" class="text-center">No additional documents found.</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane" id="createFileUploads" aria-labelledby="createFileUploads-tab" style="background-color:white;">
                        <div class="row d-flex justify-content-center m-0">
                            <div class="col-md-12">
                                <h5 class="text-blue mb-4">
                                    Please match your uploaded file based on the Document Type for Lease Listing.
                                    <span class="s-required">*</span>
                                </h5>

                                @{
                                    var docAssignments = Model.EditLeaseListingViewModel.DocumentTypeAssignmentList
                                        .Where(x => !x.IsDeleted
                                            && x.IsActive
                                            && x.DocumentType != null
                                            && !x.DocumentType.IsDeleted
                                            && x.DocumentType.IsActive)
                                        .ToList();
                                }

                                <table class="table dataTable file-upload-table" id="tblApplicantFiles" width="100%">
                                    <thead>
                                        <tr>
                                            <th style="width:30%;">Document Type</th>
                                            <th style="width:15%;">Is Required?</th>
                                            <th style="width:55%;">Uploaded Document</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < docAssignments.Count; i++)
                                        {
                                            var item = docAssignments[i];
                                            var alreadyUploaded = Model.EditLeaseListingViewModel.FileUploads != null &&
                                                                  Model.EditLeaseListingViewModel.FileUploads.Any(f =>
                                                                      f.DocumentTypeId == item.DocumentType.Id &&
                                                                      f.IsActive && !f.IsDeleted);

                                            <tr data-document-type-id="@item.DocumentType.Id">
                                                <td style="width:30%">
                                                    @item.DocumentType.Description
                                                    @if (alreadyUploaded)
                                                    {
                                                        <span class="badge bg-success ms-1">File Uploaded</span>
                                                    }
                                                    <input type="hidden"
                                                           name="EditLeaseListingViewModel.CreateFileUploadListViewModel.CreateFileUploadsViewModel[@i].DocumentTypeId"
                                                           value="@item.DocumentType.Id" />
                                                </td>
                                                <td id="isRequired">
                                                    @if (item.IsRequired == true)
                                                    {
                                                        <label class="status-active">Required</label>
                                                    }
                                                    else
                                                    {
                                                        <label class="status-inactive pe-cursor">Not Required</label>
                                                    }
                                                </td>
                                                <td>
                                                    <input type="file"
                                                           name="EditLeaseListingViewModel.CreateFileUploadListViewModel.CreateFileUploadsViewModel[@i].Files"
                                                           id="fileListDropDown_@i"
                                                           class="file"
                                                           multiple
                                                           data-show-upload="false"
                                                           data-allowed-file-extensions='["pdf","doc","docx","xls","xlsx"]'
                                                           accept=".pdf,.doc,.docx,.xls,.xlsx"
                                                           data-show-caption="true"
                                                           data-show-preview="false"
                                                           data-msg-placeholder="Select {files} for upload..." />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                                <hr class="my-4" />

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <h5 class="text-blue mb-1">Additional Documents</h5>
                                        <p class="text-muted mb-0">
                                            You may add other supporting documents not included in the predefined document types.
                                        </p>
                                    </div>
                                    <button type="button" class="btn btn-primary" id="btnAddAdditionalDocumentRow">
                                        Add Additional Document
                                    </button>
                                </div>

                                <table class="table dataTable file-upload-table" id="tblAdditionalDocuments" width="100%">
                                    <thead>
                                        <tr>
                                            <th style="width:35%;">Document Name</th>
                                            <th style="width:45%;">Upload File</th>
                                            <th style="width:20%;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.EditLeaseListingViewModel.AdditionalDocuments != null &&
                                                                 Model.EditLeaseListingViewModel.AdditionalDocuments.Any())
                                        {
                                            @for (int i = 0; i < Model.EditLeaseListingViewModel.AdditionalDocuments.Count; i++)
                                            {
                                                <tr>
                                                    <td>
                                                        <input type="hidden"
                                                               name="EditLeaseListingViewModel.AdditionalDocuments[@i].Id"
                                                               value="@Model.EditLeaseListingViewModel.AdditionalDocuments[i].Id" />

                                                        <input type="text"
                                                               name="EditLeaseListingViewModel.AdditionalDocuments[@i].DocumentName"
                                                               value="@Model.EditLeaseListingViewModel.AdditionalDocuments[i].DocumentName"
                                                               class="form-control"
                                                               placeholder="Enter document name" />
                                                    </td>
                                                    <td>
                                                        <input type="file"
                                                               name="EditLeaseListingViewModel.AdditionalDocuments[@i].File"
                                                               class="form-control additional-document-file"
                                                               accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />
                                                    </td>
                                                    <td class="text-center align-middle">
                                                        <button type="button" class="btn btn-danger btnRemoveAdditionalDocumentRow">
                                                            Remove
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td>
                                                    <input type="hidden"
                                                           name="EditLeaseListingViewModel.AdditionalDocuments[0].Id"
                                                           value="" />

                                                    <input type="text"
                                                           name="EditLeaseListingViewModel.AdditionalDocuments[0].DocumentName"
                                                           class="form-control"
                                                           placeholder="Enter document name" />
                                                </td>
                                                <td>
                                                    <input type="file"
                                                           name="EditLeaseListingViewModel.AdditionalDocuments[0].File"
                                                           class="form-control additional-document-file"
                                                           accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />
                                                </td>
                                                <td class="text-center align-middle">
                                                    <button type="button" class="btn btn-danger btnRemoveAdditionalDocumentRow">
                                                        Remove
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>


                    <div class="tab-pane" id="notes" aria-labelledby="notes-tab" style="background-color:white;">
                        <div class="col-md-12 mt-4">
                            <div class="form-group">
                                <label asp-for="EditLeaseListingViewModel.Notes" class="control-label fw-bolder">Notes</label>
                                @Html.TextAreaFor(model => model.EditLeaseListingViewModel.Notes, 10, 100, new { @class = "form-control" })

                            </div>
                        </div>
                    </div>
                </div>
                @*               <div class="row mb-4">
                <div class="col-md-12">
                <div class="form-check form-switch d-flex align-items-center gap-2">
                <input id="isDeletedCheckbox" class="form-check-input" type="checkbox" asp-for="IsDeleted">
                <label id="lblStatusSoftDelete" class="fw-bolder">Not Deleted</label>
                </div>
                <span asp-validation-for="IsDeleted" class="text-danger"></span>
                </div>
                </div> *@
                <div class="mt-4">
                    @await Html.PartialAsync("~/Views/Shared/Transaction/_EditActionButtons.cshtml", Model.EditLeaseListingViewModel.DealStatusId)
                </div>



            </form>
        </div>
    </div>
</div>
<style>
    .file-upload-table {
        table-layout: fixed;
        width: 100%;
        border-collapse: collapse;
    }

        .file-upload-table th,
        .file-upload-table td {
            vertical-align: middle;
            border: 1px solid #dee2e6;
        }

            .file-upload-table td.text-break {
                word-break: break-word;
                overflow-wrap: anywhere;
            }

        .file-upload-table .btn {
            min-width: 82px;
            margin-right: 4px;
        }

        .file-upload-table thead th {
            background-color: #203d57 !important;
            color: #fff !important;
            font-weight: 600;
        }
</style>
@section Scripts {
    @* ASP.NET Core client-side validation *@
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @* JS Utilities and Plugins *@
    <script src="~/js/viewDataTableUtility.js" asp-append-version="true"></script>
    <script src="~/js/submitUtility.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @* Submit Handler Initialization *@
    <script>
        const documentTypeAssignments = @Html.Raw(JsonConvert.SerializeObject(Model.EditLeaseListingViewModel.DocumentTypeAssignmentList));
        const isAdminLike = @((User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("DealAdmin")).ToString().ToLower());

        $(document).ready(function () {
            initializeSubmitHandlers({
                formId: "ListFormId",
                dealStatusDropdownSelector: '[name="EditLeaseListingViewModel.DealStatusId"]',
                isAdminLike: isAdminLike,
                fileErrorScrollTargetId: "fileUploads",
                documentTypeAssignment: documentTypeAssignments
            });
            $('.btn-delete-file').on('click', function (e) {
                e.preventDefault();
                var $btn = $(this);
                var fileId = $btn.data('file-id');
                Swal.fire({
                    title: 'Are you sure?',
                    text: "This will permanently delete the file.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#aaa',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/LeaseListing/DeleteFileAjax/' + fileId,
                            type: 'POST',
                            headers: {
                                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function (res) {
                                if (res.success) {
                                    Swal.fire('Deleted!', 'File has been deleted.', 'success').then(() => {
                                        location.reload();
                                    });
                                } else {
                                    Swal.fire('Error!', 'Could not delete the file.', 'error');
                                }
                            }
                        });
                    }
                });
            });
        });
    </script>

<script>
    $(document).ready(function () {

        function reIndexAdditionalDocumentRows() {
            $('#tblAdditionalDocuments tbody tr').each(function (index) {
                $(this).find('input').each(function () {
                    let currentName = $(this).attr('name');
                    if (currentName) {
                        currentName = currentName.replace(
                            /EditLeaseListingViewModel\.AdditionalDocuments\[\d+\]/g,
                            'EditLeaseListingViewModel.AdditionalDocuments[' + index + ']'
                        );
                        $(this).attr('name', currentName);
                    }
                });
            });
        }

        function buildAdditionalDocumentRow(rowCount) {
            return `
                <tr>
                    <td>
                        <input type="hidden"
                               name="EditLeaseListingViewModel.AdditionalDocuments[${rowCount}].Id"
                               value="" />
                        <input type="text"
                               name="EditLeaseListingViewModel.AdditionalDocuments[${rowCount}].DocumentName"
                               class="form-control"
                               placeholder="Enter document name" />
                    </td>
                    <td>
                        <input type="file"
                               name="EditLeaseListingViewModel.AdditionalDocuments[${rowCount}].File"
                               class="form-control additional-document-file"
                               accept=".pdf,.doc,.docx,.xls,.xlsx" />
                    </td>
                    <td class="text-center align-middle">
                        <button type="button" class="btn btn-danger btnRemoveAdditionalDocumentRow">
                            Remove
                        </button>
                    </td>
                </tr>
            `;
        }

        $(document)
            .off('click', '#btnAddAdditionalDocumentRow')
            .on('click', '#btnAddAdditionalDocumentRow', function (e) {
                e.preventDefault();

                let rowCount = $('#tblAdditionalDocuments tbody tr').length;
                $('#tblAdditionalDocuments tbody').append(buildAdditionalDocumentRow(rowCount));
            });

        $(document)
            .off('click', '.btnRemoveAdditionalDocumentRow')
            .on('click', '.btnRemoveAdditionalDocumentRow', function (e) {
                e.preventDefault();

                const rowCount = $('#tblAdditionalDocuments tbody tr').length;

                if (rowCount > 1) {
                    $(this).closest('tr').remove();
                    reIndexAdditionalDocumentRows();
                } else {
                    $(this).closest('tr').find('input[type="text"]').val('');
                    $(this).closest('tr').find('input[type="file"]').val('');
                }
            });

        $(document)
            .off('click', '.btn-delete-additional-document')
            .on('click', '.btn-delete-additional-document', function (e) {
                e.preventDefault();

                const id = $(this).data('id');

                Swal.fire({
                    title: 'Are you sure?',
                    text: "This will permanently delete the additional document.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#aaa',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/LeaseListing/DeleteAdditionalDocumentAjax/' + id,
                            type: 'POST',
                            headers: {
                                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function (res) {
                                if (res.success) {
                                    Swal.fire('Deleted!', 'Additional document has been deleted.', 'success')
                                        .then(() => {
                                            location.reload();
                                        });
                                } else {
                                    Swal.fire('Error!', res.message || 'Could not delete the additional document.', 'error');
                                }
                            },
                            error: function () {
                                Swal.fire('Error!', 'An error occurred while deleting the additional document.', 'error');
                            }
                        });
                    }
                });
            });
    });
</script>
}
