                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.PropertyAddress" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.PropertyAddress" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
