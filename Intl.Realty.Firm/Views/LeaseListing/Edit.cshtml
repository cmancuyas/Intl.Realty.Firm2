</div>

<!-- Modal -->
<div class="modal fade" id="sendEditRequestModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Are you sure you want to edit this Deal?</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Click continue to request editing this deal to DealAdmin
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="window.location.href='@Url.Action("SendRequestToDealAdmin", "LeaseListing", new{ dealId = @Model.EditLeaseListing.Id})'">Continue</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/viewdatatableutility.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            onBtnSave();
            onBtnSubmit();

            $('#isActiveCheckbox').on('click', toggleStatusLabels);
            $('#isDeletedCheckbox').on('click', toggleStatusLabelSoftDelete);

            toggleStatusLabels();
            toggleStatusLabelSoftDelete();
        });

        function onBtnSave() {
            $('#btnSave').on('click', function () {
                $('#DealStatusId').val(2); // Set deal status to "Submitted" when saving
                $('#confirmSaveModal').modal('show');
            });

            $(document).on('click', '#btnConfirmSave', function () {
                $('#ListFormId').submit();
            });
        }

        function onBtnSubmit() {
            $('#btnSubmit').on('click', function () {
                if (filesValidation()) {
                    $('#DealStatusId').val(1); // Set deal status to "Saved" when submitting
                    $('#confirmSubmitModal').modal('show');
                }
            });

            $(document).on('click', '#btnConfirmSubmit', function () {
                $('#ListFormId').submit();
            });
        }


        function filesValidation() {
            var LeaseListingId = '@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.EditLeaseListing.Id))';
            var documentTypeList = @Html.Raw(JsonConvert.SerializeObject(Model.EditLeaseListing.DocumentTypeList));
            var openModalFlag = true;

            var error = [];

            var documentTypesWithFileUploads = [];
            $.ajax({
                url: '/LeaseListing/GetDocumentTypesThatHasFileUploads/',
                type: 'GET',
                async: false,
                data: { saleListingId: LeaseListingId },
                success: function (data) {
                    documentTypesWithFileUploads = data;
                }
            });

            documentTypeList.forEach(function (item, index) {
                var formFiles = document.forms['ListFormId']['EditLeaseListing.CreateFileUploadListViewModel.CreateFileUploadsViewModel[' + index + '].Files'];
                var documentType = documentTypesWithFileUploads.find(x => x == item.Id);

                if (
                    (item.IsRequired && formFiles.value !== "") ||
                    (!item.IsRequired && formFiles.value === "") ||
                    (!item.IsRequired && formFiles.value !== "") ||
                    (documentType && item.IsRequired)
                ) {
                    // valid
                } else {
                    openModalFlag = false;
                    var title = item.Description + " is required.";
                    error.push(title);
                }
            });

            if (error.length > 0) {
                Swal.fire({
                    title: error[0],
                    text: "Please upload the required documents to proceed with the application.",
                    icon: "error",
                    confirmButtonColor: '#203D57'
                });
            }

            return openModalFlag;
        }

    </script>
}

