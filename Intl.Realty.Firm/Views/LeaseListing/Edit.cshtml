                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.FinalClosingDate" class="fw-bolder">Final Closing Date</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.FinalClosingDate" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.FinalClosingDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.DepositAmount" class="fw-bolder">Deposit Amount</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.DepositAmount" class="form-control" type="number" min="0" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.DepositAmount" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.DepositDate" class="fw-bolder">Deposit Date</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.DepositDate" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.DepositDate" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Tenant Details -->
                        <h4 class="mt-5 text-blue">Tenant Details</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantName" class="fw-bolder">Tenant's Name</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantName" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantEmailAddress" class="fw-bolder">Tenant's Email</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantEmailAddress" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.TenantDetails.TenantEmailAddress" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
