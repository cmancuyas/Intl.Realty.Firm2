                    }

                    @{
                        @if (isAdmin || isSuperAdmin || isAgent && Model.EditLeaseListing.DealStatus!.Id == 2) //Saved
                        {

                            <button type="button" id="btnSubmit" class="btn btn-primary w-15" onclick="$('.text-danger').show();">Submit</button>
                        }
                    }

                </div>
            </form>
        </div>
