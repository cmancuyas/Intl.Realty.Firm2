                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordPhoneNumber" class="fw-bolder">Landlord Phone Number</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordPhoneNumber" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordPhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordEmailAddress" class="fw-bolder">Landlord Email Address</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordEmailAddress" class="form-control" />
