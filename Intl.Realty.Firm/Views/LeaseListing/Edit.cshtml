                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordName" class="fw-bolder">Landlord Name</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordName" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordPhoneNumber" class="fw-bolder">Landlord Phone</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordPhoneNumber" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordPhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordEmailAddress" class="fw-bolder">Landlord Email</label>
                                <input asp-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordEmailAddress" class="form-control" />
                                <span asp-validation-for="EditLeaseListingViewModel.EditIRFDealLeaseListingViewModel.LandLordDetails.LandLordEmailAddress" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Section: Commission & Listing -->
