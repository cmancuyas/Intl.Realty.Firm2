@using Intl.Realty.Firm.Model.Model
@using Intl.Realty.Firm.Model.ViewModel.LeaseListingVM
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Newtonsoft.Json

@inject UserManager<ApplicationUser> _userManager;

@model EditLeaseListingWithTabMenuViewModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";

    var user = await _userManager.GetUserAsync(User);
    var isAgent = await _userManager.IsInRoleAsync(user!, "Agent");
    var isDealAdmin = await _userManager.IsInRoleAsync(user!, "DealAdmin");
    var isAdmin = await _userManager.IsInRoleAsync(user!, "Admin");
    var isSuperAdmin = await _userManager.IsInRoleAsync(user!, "SuperAdmin");
}

<partial name="~/Views/Shared/Modal/_ConfirmSubmitModal.cshtml" />
<partial name="~/Views/Shared/Modal/_ConfirmSuccessModal.cshtml" />
<partial name="~/Views/Shared/Modal/_ConfirmSaveModal.cshtml" />

<div class="page-controller mb-5">
    @*    <a href="@Url.Action("Index","LeaseListing")" class="text-decoration-none text-blue d-flex mb-4">
    <i data-feather="chevron-left"></i><span>Back</span>
    </a> *@
    <a href="##" class="back" onClick="history.go(-1); return false;">
        <i data-feather="chevron-left"></i><span>Back</span>
    </a>
    <div class="row justify-content-center">
        <div class="col-md-12 card mt-4 p-4 b-none bg-none">
            <h1 class="text-blue mb-0">Edit Lease Listing - Deal Id: @Model.EditLeaseListingViewModel.DealTransactionNumber - @Model.EditLeaseListingViewModel.DealStatus!.Description</h1>
            <hr class="my-4" />
            <form id="ListFormId"
                  asp-action="Edit"
                  asp-controller="LeaseListing"
                  method="post"
                  enctype="multipart/form-data">
                <input type="hidden" id="ActionTypeHidden" name="actionType" />
                <input type="hidden" name="EditLeaseListingViewModel.RowVersion"
                       value="@Convert.ToBase64String(Model.EditLeaseListingViewModel.RowVersion)" />
                <input type="hidden" asp-for="EditLeaseListingViewModel.Id" />
                <input type="hidden" asp-for="EditLeaseListingViewModel.DealTransactionNumber" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="tab-page">
                    <ul class="nav nav-tabs" id="administrationManagementTab" role="tablist" style="border:none">
                        @foreach (var item in Model.Menus)
                        {
                            <li class="nav-item mx-0">
                                <input type="hidden" id="menuId" name="menuId" value="@item.Id" />
                                <button class="nav-link @item.IsActive"
                                        id="@item.Tab"
                                        data-bs-toggle="tab"
                                        data-bs-target="#@item.Control"
                                        type="button"
                                        role="tab"
                                        aria-controls="@item.Control"
                                        aria-selected="@item.IsSelected">
                                    @item.Description
                                </button>
                            </li>
                        }
                    </ul>
                </div>

                <div class="tab-content" style="border-bottom:none;background-color:white;">

                    <div class="tab-pane active" id="irfDetails1" aria-labelledby="irfDetails1-tab" style="background-color:white;">

                        @{
                            if (isAdmin || isSuperAdmin || isDealAdmin)
                            {
                                @* Deal Status *@
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="control-label fw-bolder">Deal Status</label>
                                            <select id="EditLeaseListing.DealStatusId" name="EditLeaseListingViewModel.DealStatusId" class="form-select">
                                                @{
                                                    @if (Model.EditLeaseListingViewModel.DealStatusList != null)
                                                    {
                                                        @foreach (var dealStatus in Model.EditLeaseListingViewModel.DealStatusList)
                                                        {
                                                            if (dealStatus.Id == Model.EditLeaseListingViewModel.DealStatusId)
                                                            {
                                                                <option value="@dealStatus.Id" selected>@dealStatus.Description</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@dealStatus.Id">@dealStatus.Description</option>
                                                            }
                                                        }
                                                    }
                                                }
                                            </select>

                                            @Html.ValidationMessageFor(m => m.EditLeaseListingViewModel.DealStatusId, "", new { @class = "text-danger" })

                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <input type="hidden" name="EditLeaseListingViewModel.DealStatusId" value="1" />
                            }
                        }

                        <!-- Section: Property Info -->
