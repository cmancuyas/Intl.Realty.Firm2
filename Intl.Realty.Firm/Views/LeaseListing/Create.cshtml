@using Intl.Realty.Firm.Model.Model
@using Intl.Realty.Firm.Model.ViewModel.LeaseListingVM
@using Intl.Realty.Firm.Model.ViewModel.Shared
@using Newtonsoft.Json

@model CreateLeaseListingWithTabMenuViewModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}
<partial name="~/Views/Shared/Modal/_ConfirmSubmitModal.cshtml" />
<partial name="~/Views/Shared/Modal/_ConfirmSuccessModal.cshtml" />
<partial name="~/Views/Shared/Modal/_ConfirmSaveModal.cshtml" />
<div class="page-controller mb-5">
    @*     <a href="@Url.Action("Index","LeaseListing")" class="text-decoration-none text-blue d-flex mb-4">
    <i data-feather="chevron-left"></i><span>Back</span>
    </a> *@
    <a href="##" class="back" onClick="history.go(-1); return false;">
        <i data-feather="chevron-left"></i><span>Back</span>
    </a>
    <div class="row justify-content-center">
        <div class="col-md-12 card b-none mt-4 p-4" style="background: transparent;">
            <h1 class="text-blue mb-0">Create Lease Listing</h1>
            <hr class="my-4" />
            <form id="ListFormId"
                  asp-action="Create"
                  asp-controller="LeaseListing"
                  method="post"
                  enctype="multipart/form-data">
                <input type="hidden" id="ActionTypeHidden" name="actionType" />
                <input asp-for="CreateLeaseListingViewModel.DealTransactionNumber" hidden />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" name="CreateLeaseListingViewModel.RowVersion"
                       value="@Convert.ToBase64String(Model.CreateLeaseListingViewModel.RowVersion)" />
                <div class="tab-page">
                    <!-- Dropdown for Mobile -->
                    <div class="dropdown d-md-none mb-3">
                        <button class="btn btn-primary dropdown-toggle"
                                type="button"
                                id="tabDropdown"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            @Model.Menus.FirstOrDefault(m => m.IsTrue)?.Description Menu
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="tabDropdown">
                            @foreach (var item in Model.Menus)
                            {
                                <li>
                                    <button class="dropdown-item"
                                            data-bs-target="#@item.Control"
                                            data-tab-id="@item.Tab"
                                            data-route="@item.Control">
                                        @item.Description
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- Tab for Desktop -->
                    <ul class="nav nav-tabs" id="leaseListingTab" role="tablist" style="border:none">
                        @foreach (var item in Model.Menus)
                        {
                            <li class="nav-item mx-0">
                                <input type="hidden" id="menuId" name="menuId" value="@item.Id" />
                                <button class="nav-link @item.IsActive"
                                        id="@item.Tab"
                                        data-bs-toggle="tab"
                                        data-bs-target="#@item.Control"
                                        type="button"
                                        role="tab"
                                        aria-controls="@item.Control"
                                        aria-selected="@item.IsSelected">
                                    @item.Description
                                </button>
                            </li>
                        }
                    </ul>

                </div>
                <div class="tab-content" style="background-color:white;">

                    <div class="tab-pane active" id="irfDetails1" aria-labelledby="irfDetails1-tab" style="background-color:white;">

                        <!-- Section: Property Info -->
                        <h4 class="mt-4 text-blue">Property Information</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.PropertyAddress" class="fw-bolder">Property Address</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.PropertyAddress" class="form-control" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.PropertyAddress" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreatedByFullName" class="fw-bolder">Created By</label>
                                <input asp-for="CreateLeaseListingViewModel.CreatedByFullName" class="form-control" disabled />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreatedByFullName" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Section: Financial Info -->
                        <h4 class="mt-5 text-blue">Financial Information</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.FinalLeasePrice" class="fw-bolder">Final Lease Price</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.FinalLeasePrice" class="form-control" type="number" min="0" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.FinalLeasePrice" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.FinalClosingDate" class="fw-bolder">Final Closing Date</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.FinalClosingDate" class="form-control" type="date" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.FinalClosingDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.DepositAmount" class="fw-bolder">Deposit Amount</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.DepositAmount" class="form-control" type="number" min="0" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.DepositAmount" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.DepositDate" class="fw-bolder">Deposit Date</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.DepositDate" class="form-control" type="date" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.DepositDate" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Tenant Details -->
                        <h4 class="mt-5 text-blue">Tenant Details</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantName" class="fw-bolder">Tenant's Name</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantName" class="form-control" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantEmailAddress" class="fw-bolder">Tenant's Email</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantEmailAddress" class="form-control" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantEmailAddress" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantPhoneNumber" class="fw-bolder">Tenant's Phone Number</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantPhoneNumber" class="form-control" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantPhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Landlord Info -->
                        <h4 class="mt-5 text-blue">Landlord Info</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.LandLordDetails.LandLordName" class="fw-bolder">Landlord Name</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.LandLordDetails.LandLordName" class="form-control" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.LandLordDetails.LandLordName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.LandLordDetails.LandLordPhoneNumber" class="fw-bolder">Landlord Phone</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.LandLordDetails.LandLordPhoneNumber" class="form-control" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.LandLordDetails.LandLordPhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.LandLordDetails.LandLordEmailAddress" class="fw-bolder">Landlord Email</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.LandLordDetails.LandLordEmailAddress" class="form-control" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.LandLordDetails.LandLordEmailAddress" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Section: Commission & Listing -->
                        <h4 class="mt-5 text-blue">Commission & Listing Info</h4>
                        <div class="row">
                            <!-- Total Commission Signage -->
                            <div class="col-md-6 mt-3">
                                <div class="form-group">
                                    <label class="control-label fw-bolder">Total Commission Signage</label>
                                    <select id="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.Commission.ListingCommissionSign"
                                            name="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.Commission.ListingCommissionSign"
                                            class="form-select">
                                        @if (Model.CreateLeaseListingViewModel.SignageIEnum != null)
                                        {
                                            foreach (var item in Model.CreateLeaseListingViewModel.SignageIEnum)
                                            {
                                                int signageValue = Convert.ToInt32(item.Value);
                                                if (signageValue == Model.CreateLeaseListingViewModel.DefaultSignage)
                                                {
                                                    <option value="@item.Value" selected>@item.Text</option>
                                                }
                                                else
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            }
                                        }
                                    </select>
                                    @Html.ValidationMessageFor(m => m.CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.Commission.ListingCommissionSign, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <!-- Total Commission -->
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.Commission.ListingCommission" class="fw-bolder">Total Commission</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.Commission.ListingCommission" class="form-control" type="number" step="0.01" min="0" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.Commission.ListingCommission" class="text-danger"></span>
                            </div>

                            <!-- Co-op Commission Signage -->
                            <div class="col-md-6 mt-3">
                                <div class="form-group">
                                    <label class="control-label fw-bolder">Co-op Commission Signage</label>
                                    <select id="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.Commission.BuyingCommissionSign"
                                            name="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.Commission.BuyingCommissionSign"
                                            class="form-select">
                                        @if (Model.CreateLeaseListingViewModel.SignageIEnum != null)
                                        {
                                            foreach (var item in Model.CreateLeaseListingViewModel.SignageIEnum)
                                            {
                                                int signageValue = Convert.ToInt32(item.Value);
                                                if (signageValue == Model.CreateLeaseListingViewModel.DefaultSignage)
                                                {
                                                    <option value="@item.Value" selected>@item.Text</option>
                                                }
                                                else
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            }
                                        }
                                    </select>
                                    @Html.ValidationMessageFor(m => m.CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.Commission.BuyingCommissionSign, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <!-- Co-op Buying Commission -->
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.Commission.BuyingCommission" class="fw-bolder">Co-op Buying Commission</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.Commission.BuyingCommission" class="form-control" type="number" step="0.01" min="0" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.Commission.BuyingCommission" class="text-danger"></span>
                            </div>

                            <!-- Listing Agent Name -->
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.ListingInfo.ListingAgentName" class="fw-bolder">Listing Agent Name</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.ListingInfo.ListingAgentName" class="form-control" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.ListingInfo.ListingAgentName" class="text-danger"></span>
                            </div>

                            <!-- Listing Brokerage -->
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.ListingInfo.ListingBrokerage" class="fw-bolder">Listing Brokerage</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.ListingInfo.ListingBrokerage" class="form-control" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.ListingInfo.ListingBrokerage" class="text-danger"></span>
                            </div>

                            <!-- Listing Brokerage Fax -->
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.ListingInfo.ListingBrokerageFax" class="fw-bolder">Listing Brokerage Fax</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.ListingInfo.ListingBrokerageFax" class="form-control" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.ListingInfo.ListingBrokerageFax" class="text-danger"></span>
                            </div>
                        </div>



                    </div>

                    <div class="tab-pane" id="irfDetails2" aria-labelledby="irfDetails2-tab" style="background-color:white;">

                        <!-- Section: Tenant Representation -->
                        <h4 class="mt-4 text-blue">Tenant Representation</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantAgentName" class="fw-bolder">Tenant Agent Name</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantAgentName" class="form-control" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantAgentName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantBrokerage" class="fw-bolder">Tenant Brokerage</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantBrokerage" class="form-control" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantBrokerage" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantBrokerageFax" class="fw-bolder">Tenant Brokerage Fax</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantBrokerageFax" class="form-control" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantBrokerageFax" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantPhoneNumber" class="fw-bolder">Tenant Phone Number</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantPhoneNumber" class="form-control" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.TenantDetails.TenantPhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Section: Landlord Contact -->
                        <h4 class="mt-5 text-blue">Landlord Contact</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.LandLordDetails.LandLordPhoneNumber" class="fw-bolder">Landlord Phone Number</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.LandLordDetails.LandLordPhoneNumber" class="form-control" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.LandLordDetails.LandLordPhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.LandLordDetails.LandLordEmailAddress" class="fw-bolder">Landlord Email Address</label>
                                <input asp-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.LandLordDetails.LandLordEmailAddress" class="form-control" />
                                <span asp-validation-for="CreateLeaseListingViewModel.CreateIRFDealLeaseListingViewModel.LandLordDetails.LandLordEmailAddress" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane" id="fileUploads" aria-labelledby="fileUploads-tab" style="background-color:white;">
                        <div class="row d-flex justify-content-center m-0">
                            <div class="col-md-12">
                                <h5 class="text-blue mb-4">
                                    Please match your uploaded file based on the Document Type for Lease Listing.
                                    <span class="s-required">*</span>
                                </h5>

                                <div class="table-responsive">
                                    <table class="table dataTable file-upload-table" id="tblApplicantFiles" width="100%">
                                        <thead>
                                            <tr>
                                                <th style="width:30%">Document Type</th>
                                                <th style="width:15%">Is Required?</th>
                                                <th style="width:55%">Uploaded Document</th>
                                            </tr>
                                        </thead>

                                        @{
                                            var docAssignments = Model.CreateLeaseListingViewModel.DocumentTypeAssignmentList
                                                .Where(x => !x.IsDeleted
                                                    && x.IsActive
                                                    && x.DocumentType != null
                                                    && !x.DocumentType.IsDeleted
                                                    && x.DocumentType.IsActive)
                                                .ToList();
                                        }

                                        <tbody>
                                            @for (int i = 0; i < docAssignments.Count; i++)
                                            {
                                                var item = docAssignments[i];

                                                <tr data-document-type-id="@item.DocumentType.Id">
                                                    <td class="text-break" style="width:30%">
                                                        @item.DocumentType.Description
                                                        <input type="hidden"
                                                               name="CreateLeaseListingViewModel.CreateFileUploadListViewModel.CreateFileUploadsViewModel[@i].DocumentTypeId"
                                                               value="@item.DocumentType.Id" />
                                                    </td>

                                                    <td id="isRequired">
                                                        @if (item.IsRequired)
                                                        {
                                                            <label class="status-active">Required</label>
                                                        }
                                                        else
                                                        {
                                                            <label class="status-inactive pe-cursor">Not Required</label>
                                                        }
                                                    </td>

                                                    <td>
                                                        <input type="file"
                                                               name="CreateLeaseListingViewModel.CreateFileUploadListViewModel.CreateFileUploadsViewModel[@i].Files"
                                                               id="fileListDropDown_@i"
                                                               class="file"
                                                               multiple
                                                               data-show-upload="false"
                                                               data-allowed-file-extensions='["pdf","doc","docx","xls","xlsx"]'
                                                               accept="application/all"
                                                               data-show-caption="true"
                                                               data-show-preview="false"
                                                               data-msg-placeholder="Select {files} for upload..." />
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <hr class="my-4" />

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <h5 class="text-blue mb-1">Additional Documents</h5>
                                        <p class="text-muted mb-0">
                                            You may add other supporting documents not included in the predefined document types.
                                        </p>
                                    </div>
                                    <button type="button" class="btn btn-primary" id="btnAddAdditionalDocumentRow">
                                        Add Additional Document
                                    </button>
                                </div>

                                <div class="table-responsive">
                                    <table class="table dataTable file-upload-table" id="tblAdditionalDocuments" width="100%">
                                        <thead>
                                            <tr>
                                                <th style="width:35%">Document Name</th>
                                                <th style="width:45%">Upload File</th>
                                                <th style="width:20%">Action</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @if (Model.CreateLeaseListingViewModel.AdditionalDocuments != null &&
                                                                         Model.CreateLeaseListingViewModel.AdditionalDocuments.Any())
                                            {
                                                @for (int i = 0; i < Model.CreateLeaseListingViewModel.AdditionalDocuments.Count; i++)
                                                {
                                                    <tr>
                                                        <td>
                                                            <input type="hidden"
                                                                   name="CreateLeaseListingViewModel.AdditionalDocuments[@i].Id"
                                                                   value="@Model.CreateLeaseListingViewModel.AdditionalDocuments[i].Id" />

                                                            <input type="text"
                                                                   name="CreateLeaseListingViewModel.AdditionalDocuments[@i].DocumentName"
                                                                   value="@Model.CreateLeaseListingViewModel.AdditionalDocuments[i].DocumentName"
                                                                   class="form-control"
                                                                   placeholder="Enter document name" />
                                                        </td>

                                                        <td>
                                                            <input type="file"
                                                                   name="CreateLeaseListingViewModel.AdditionalDocuments[@i].File"
                                                                   class="form-control additional-document-file"
                                                                   accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />
                                                        </td>

                                                        <td class="text-center align-middle">
                                                            <button type="button" class="btn btn-danger btnRemoveAdditionalDocumentRow">
                                                                Remove
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td>
                                                        <input type="hidden"
                                                               name="CreateLeaseListingViewModel.AdditionalDocuments[0].Id"
                                                               value="" />

                                                        <input type="text"
                                                               name="CreateLeaseListingViewModel.AdditionalDocuments[0].DocumentName"
                                                               class="form-control"
                                                               placeholder="Enter document name" />
                                                    </td>

                                                    <td>
                                                        <input type="file"
                                                               name="CreateLeaseListingViewModel.AdditionalDocuments[0].File"
                                                               class="form-control additional-document-file"
                                                               accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />
                                                    </td>

                                                    <td class="text-center align-middle">
                                                        <button type="button" class="btn btn-danger btnRemoveAdditionalDocumentRow">
                                                            Remove
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>

                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="tab-pane" id="notes" aria-labelledby="notes-tab" style="background-color:white;">
                        <div class="col-md-12 mt-4">
                            <div class="form-group">
                                <label asp-for="CreateLeaseListingViewModel.Notes" class="control-label fw-bolder">Notes</label>
                                @Html.TextAreaFor(model => model.CreateLeaseListingViewModel.Notes, 10, 100, new { @class = "form-control" })

                            </div>
                        </div>
                    </div>

                </div>

                <hr class="my-5" />
                @{
                    var buttonModel = new CreateActionButtonsViewModel
                    {
                        ControllerName = "LeaseListing",
                        ShowSave = true,
                        ShowSubmit = true,
                        ShowCancel = true
                    };
                }

                @await Html.PartialAsync("~/Views/Shared/Transaction/_CreateActionButtons.cshtml", buttonModel)

            </form>
        </div>
    </div>
</div>
<style>
