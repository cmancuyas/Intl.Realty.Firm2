@using Intl.Realty.Firm.Model.Model
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> _signInManager;
@inject UserManager<ApplicationUser> _userManager;

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Intl.Realty.Firm</title>

    <!-- Styles -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/3.0.2/css/buttons.bootstrap.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.min.css" crossorigin="anonymous">

    <!-- Fileinput Plugin -->
    <link href="https://cdn.jsdelivr.net/gh/kartik-v/bootstrap-fileinput@5.5.0/css/fileinput.min.css" media="all" rel="stylesheet" />

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.11.8/dist/umd/popper.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.1/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/kartik-v/bootstrap-fileinput@5.5.0/js/fileinput.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/feather.min.js" type="text/javascript"></script>
</head>
<body>

    <partial name="~/Views/Shared/_SidebarItems.cshtml" />

    <div class="top-bar">
        <div class="top-bar-container shadow-sm d-flex">
            <div class="d-flex align-items-center justify-content-between mx-4 w-100">
                <div class="d-flex flex-row align-items-center gap-2">
                    <!-- Additional Content Placeholder -->
                </div>
                <div class="d-flex align-items-center gap-4">
                    <a href="#" class="text-decoration-none">
                        <i class="bi bi-bell-fill text-blue"></i>
                    </a>
                    <div class="d-flex flex-column justify-content-end roles">
                        @{
                            var user = await _userManager.GetUserAsync(User);
                            if (user != null)
                            {
                                var roles = await _userManager.GetRolesAsync(user);
                                <span id="DisplayFullName" class="fw-bolder text-end name-role">@user.FirstName @user.LastName</span>
                                <span id="DisplayName" class="small text-end">@user.Email</span>
                                <span id="DisplayRole" class="small text-end">
                                    @foreach (var item in roles)
                                    {
                                        <span class="badge" style="background-color:@(item == "SuperAdmin" ? "red" : item == "Admin" ? "blue" : item == "Agent" ? "orange" : "green")">
                                            @item
                                        </span>
                                    }
                                </span>
                            }
                        }
                    </div>
                    <div class="d-flex">
                        <img src="~/files/img/avatar-blank.png" class="avatar" id="avatar" width="40" height="40" onerror="this.src='~/files/img/avatar-default.png';" />
                        <div class="dropdown">
                            <button class="bg-transparent b-none px-0" data-bs-toggle="dropdown" aria-label="User Menu" aria-haspopup="true" aria-expanded="false">
                                <i data-feather="chevron-down" class="text-secondary"></i>
                            </button>
                            <div class="dropdown-menu text-center text-secondary">
                                <a class="dropdown-item py-2" asp-action="Index" asp-controller="UserProfile" asp-route-id="@user?.Id">View Profile</a>
                                <a class="dropdown-item py-2" asp-action="Logout" asp-controller="Account">Sign Out</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <main role="main" class="main pb-5">
        <div class="main-container px-4 pt-4 mb-5">
            @RenderBody()
        </div>
    </main>

    <footer class="footer text-muted pt-3 ms-4 w-100 text-center">
        © 2024 International Realty Firm
    </footer>

    <script>
        $(document).ready(function () {
            feather.replace();
            // $(".select2").select2();
        });
    </script>

    @await Html.PartialAsync("_NotificationPartial.cshtml")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
