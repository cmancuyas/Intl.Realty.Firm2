@using Intl.Realty.Firm.Model.Model
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> signInManager;

<!-- Off-Canvas Menu -->
<div id="off-canvas-menu" class="off-canvas-menu">
    <aside>
        <div class="h-auto d-flex align-items-center justify-content-center me-1 mt-4 logo-container">
            <img src="~/files/img/logo-irf-white.png" alt="INTLRealtyFirm Logo" class="img-fluid w-75" />
        </div>
        <div class="nav-bar-container">
            <ul id="navItems" class="navbar-nav mt-5">
                @if (signInManager.IsSignedIn(User) && (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.Claims.Any(c => c.Type == System.Security.Claims.ClaimTypes.Role)))
                {
                    <li id="dashboardNavItem" class="nav-item mx-2 mt-2 mb-1 rounded">
                        <a class="nav-link text-decoration-none d-flex align-items-center gap-3 ms-2 me-2 fw-bolder" asp-controller="Home" asp-action="Dashboard">
                            <i data-feather="grid" data-toggle="tooltip" data-bs-placement="right" title="Dashboard"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                }
                @if (signInManager.IsSignedIn(User) && (User.IsInRole("SuperAdmin") ||
                User.IsInRole("Admin")))
                {

                    @* Customers *@
                    <li id="dashboardNavItem" class="nav-item mx-2 mt-2 mb-1 rounded">
                        <a class="nav-link text-decoration-none d-flex align-items-center gap-3 ms-2 me-2 fw-bolder" asp-controller="Customer" asp-action="Index">
                            <i data-feather="user" data-toggle="tooltip" data-bs-placement="right" title="Customer"></i>
                            <span>My Customers</span>
                        </a>
                    </li>

                    @* Administrator *@
                    <li id="administratorNavItem" class="nav-item mx-2 mt-2 mb-1 rounded pe-cursor">
                        <a id="administratorNavLink" class="nav-link text-decoration-none d-flex align-items-center gap-3 ms-2 me-2 fw-bolder">
                            <i data-feather="key" data-toggle="tooltip" data-bs-placement="right" title="Administrator"></i>
                            <span class="flex-grow-1">Administrator</span>
                            <i data-feather="chevron-right" class="caret w-15px"></i>
                        </a>
                    </li>
                }
                else
                {

                }
                <li class="administratorSubNavItem sub-nav-item">
                    <ul class="list-unstyled">
                        <li>
                            <a class="sub-nav-link" asp-controller="User" asp-action="Index">
                                <span>Account Management</span>
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="administratorSubNavItem sub-nav-item">
                    <ul class="list-unstyled">
                        <li>
                            <a class="sub-nav-link" asp-controller="TransactionType" asp-action="Index">
                                <span>Transaction Management</span>
                            </a>
                        </li>
                    </ul>
                </li>

                @if (signInManager.IsSignedIn(User) && (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.Claims.Any(c => c.Type == System.Security.Claims.ClaimTypes.Role)))
                {
                    @* Upload New Transaction  *@
                    <li id="transactionManagementNavItem" class="nav-item mx-2 mt-2 mb-1 rounded pe-cursor">
                        <a id="transactionManagementNavLink" class="nav-link text-decoration-none d-flex align-items-center gap-3 ms-2 me-2 fw-bolder">
                            <i data-feather="file" data-toggle="tooltip" data-bs-placement="right" title="TransactionManagement"></i>
                            <span class="flex-grow-1">Upload New Transaction</span>
                            <i data-feather="chevron-right" class="caret w-15px"></i>
                        </a>
                    </li>
                    <li class="transactionManagementSubNavItem sub-nav-item">
                        <ul class="list-unstyled">
                            <li>
                                <a class="sub-nav-link" asp-controller="SaleListing" asp-action="Index">
                                    <span>Sale Listing</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="transactionManagementSubNavItem sub-nav-item">
                        <ul class="list-unstyled">
                            <li>
                                <a class="sub-nav-link" asp-controller="SaleCoop" asp-action="Index">
                                    <span>Sale Co-op</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="transactionManagementSubNavItem sub-nav-item">
                        <ul class="list-unstyled">
                            <li>
                                <a class="sub-nav-link" asp-controller="LeaseListing" asp-action="Index">
                                    <span>Lease Listing</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="transactionManagementSubNavItem sub-nav-item">
                        <ul class="list-unstyled">
                            <li>
                                <a class="sub-nav-link" asp-controller="LeaseCoop" asp-action="Index">
                                    <span>Lease Co-op</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                }
                @* Information Packages  *@
                <li id="informationPackageManagementNavItem" class="nav-item mx-2 mt-2 mb-1 rounded pe-cursor">
                    <a id="informationPackageManagementNavLink" class="nav-link text-decoration-none d-flex align-items-center gap-3 ms-2 me-2 fw-bolder">
                        <i data-feather="credit-card" data-toggle="tooltip" data-bs-placement="right" title="InformationPackageManagement"></i>
                        <span class="flex-grow-1">IRF Preferred Partners</span>
                        <i data-feather="chevron-right" class="caret w-15px"></i>
                    </a>
                </li>
                <li class="informationPackageManagementSubNavItem sub-nav-item">
                    <ul class="list-unstyled">
                        <li>
                            <a class="sub-nav-link" asp-controller="BusinessCard" asp-action="Index">
                                <span>Business Cards & Signs</span>
                            </a>
                        </li>
                    </ul>
                </li>
                <li class="informationPackageManagementSubNavItem sub-nav-item">
                    <ul class="list-unstyled">
                        <li>
                            <a class="sub-nav-link" asp-controller="CommissionAdvance" asp-action="Index">
                                <span>Apply for Commission Advance</span>
                            </a>
                        </li>
                    </ul>
                </li>
                <li class="informationPackageManagementSubNavItem sub-nav-item">
                    <ul class="list-unstyled">
                        <li>
                            <a class="sub-nav-link" asp-controller="IRFMortgage" asp-action="Index">
                                <span>IRF Mortgage Program</span>
                            </a>
                        </li>
                    </ul>
                </li>
                <li class="informationPackageManagementSubNavItem sub-nav-item">
                    <ul class="list-unstyled">
                        <li>
                            <a class="sub-nav-link" asp-controller="IRFLead" asp-action="Index">
                                <span>IRF Leads</span>
                            </a>
                        </li>
                    </ul>
                </li>
                <li class="informationPackageManagementSubNavItem sub-nav-item">
                    <ul class="list-unstyled">
                        <li>
                            <a class="sub-nav-link" asp-controller="IRFBrandedWebsite" asp-action="Index">
                                <span>IRF Branded Website</span>
                            </a>
                        </li>
                    </ul>
                </li>
                <li class="informationPackageManagementSubNavItem sub-nav-item">
                    <ul class="list-unstyled">
                        <li>
                            <a class="sub-nav-link" href="~/files/img/pdfs/Powerhouse-IRF-Referral-Program.pdf" target="_blank" rel="noopener noreferrer">
                                <span>Property Management</span>
                            </a>
                        </li>
                    </ul>
                </li>

                @* Training (expandable)  *@
                <li id="trainingNavItem" class="nav-item mx-2 mt-2 mb-1 rounded pe-cursor">
                    <a id="trainingNavLink" class="nav-link text-decoration-none d-flex align-items-center gap-3 ms-2 me-2 fw-bolder">
                        <i data-feather="award" data-toggle="tooltip" data-bs-placement="right" title="Training"></i>
                        <span class="flex-grow-1">Training</span>
                        <i data-feather="chevron-right" class="caret w-15px"></i>
                    </a>
                </li>
                <li class="trainingSubNavItem sub-nav-item">
                    <ul class="list-unstyled">
                        <li>
                            <a class="sub-nav-link" asp-controller="Training" asp-action="Index">
                                <span>Training &amp; resources</span>
                            </a>
                        </li>
                    </ul>
                </li>
                <li class="trainingSubNavItem sub-nav-item">
                    <ul class="list-unstyled">
                        <li>
                            <a class="sub-nav-link" asp-controller="ScheduleB" asp-action="Index">
                                <span>IRF Schedule B</span>
                            </a>
                        </li>
                    </ul>
                </li>

                @* Refer an Agent  *@
                <li id="referAnAgentNavItem" class="nav-item mx-2 mt-2 mb-1 rounded">
                    <a class="nav-link text-decoration-none d-flex align-items-center gap-3 ms-2 me-2 fw-bolder" href="/ReferAnAgent">
                        <i data-feather="user-plus" data-toggle="tooltip" data-bs-placement="right" title="ReferAnAgent"></i>
                        <span>Refer An Agent</span>
                    </a>
                </li>

            </ul>
        </div>
    </aside>
</div>