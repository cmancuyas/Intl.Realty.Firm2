@using Intl.Realty.Firm.Model.ViewModel

@{
    ViewData["Title"] = "Error";
}

@if (Model.ErrorTitle == null)
{
    <h1 class="text-danger">Error.</h1>
    <h3 class="text-danger">
        An error occurred while processing your request.
        The support team is notified and we are working on the fix
    </h3>

    <h5>Please contact us on admin@intlrealty.com</h5>

    <div class="alert alert-danger">
        <h5>Exception Path</h5>
        <hr />
        <p>@ViewBag.ExceptionPath</p>
    </div>

    <div class="alert alert-danger">
        <h5>Exception Stack Trace</h5>
        <hr />
        <p>@ViewBag.StackTrace</p>
    </div>

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }


}
else
{
    <h1 class="text-danger">@Model.ErrorTitle</h1>
    <h6 class="text-danger">@Model.ErrorMessage</h6>
}