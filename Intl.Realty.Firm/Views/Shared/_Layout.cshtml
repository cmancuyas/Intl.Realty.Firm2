@using Intl.Realty.Firm.Models
@using Microsoft.Extensions.Options
@inject IOptions<GoogleCaptchaConfig> GoogleCaptchaConfig
@{
    var title = ViewData["Title"]?.ToString() ?? "";
    var isAuthPage =
        title == "Login" ||
        title == "Register" ||
        title == "Login Issue Support" ||
        title == "Forgot Password" ||
        title == "Reset Password" ||
        title == "User Agreement" ||
        title == "Data Privacy Statement";
    var enableRecaptcha =
        title == "Login" ||
        title == "Register" ||
        title == "Login Issue Support";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>International Realty Firm - @ViewData["Title"]</title>

    <!-- Styles -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main role="main">
        @RenderBody()
    </main>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.11.8/dist/umd/popper.min.js"
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.1/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Local scripts -->
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/feather.min.js" asp-append-version="true"></script>
    @if (!isAuthPage)
    {
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    }

    @* ✅ Load reCAPTCHA v3 only when needed *@
    @if (enableRecaptcha)
    {
        <script src="https://www.google.com/recaptcha/api.js?render=@GoogleCaptchaConfig.Value.SiteKey"></script>

        <script>
            document.addEventListener("DOMContentLoaded", function () {

                const siteKey = '@GoogleCaptchaConfig.Value.SiteKey';
                const pageTitle = '@(ViewData["Title"]?.ToString() ?? "")';

                const isLogin = pageTitle === "Login";
                const isRegister = pageTitle === "Register";
                const isLoginIssue = pageTitle === "Login Issue Support";

                const form = document.querySelector("form");
                if (!form) return;

                const tokenField =
                    isLogin ? document.getElementById("LoginToken") :
                    isRegister ? document.getElementById("RegisterViewModelToken") :
                    isLoginIssue ? document.getElementById("LoginIssueToken") :
                    null;

                if (!tokenField) return;

                const actionName =
                    isLogin ? "login" :
                    isRegister ? "register" :
                    isLoginIssue ? "login_issue" :
                    "submit";

                async function refreshToken() {
                    return new Promise((resolve) => {
                        grecaptcha.ready(function () {
                            grecaptcha.execute(siteKey, { action: actionName })
                                .then(function (token) {
                                    tokenField.value = token;
                                    resolve(token);
                                })
                                .catch(function (err) {
                                    console.error("❌ reCAPTCHA error:", err);
                                    tokenField.value = "";
                                    resolve("");
                                });
                        });
                    });
                }

                // Warm up an initial token; always refresh again on submit (tokens expire ~2 minutes).
                refreshToken();
                setInterval(refreshToken, 110000);

                // Always refresh token immediately before submit (v3 tokens expire ~2 minutes).
                let isSubmitting = false;
                form.addEventListener("submit", async function (e) {
                    if (isSubmitting) return;

                    e.preventDefault();

                    const submitBtn = form.querySelector('button[type="submit"], input[type="submit"]');
                    if (submitBtn) submitBtn.disabled = true;

                    try {
                        await refreshToken();
                        if (!tokenField.value) {
                            alert("Captcha could not be verified. Please refresh the page and try again.");
                            if (submitBtn) submitBtn.disabled = false;
                            return;
                        }

                        isSubmitting = true;
                        form.submit();
                    } catch (err) {
                        console.error("reCAPTCHA submit error:", err);
                        alert("Captcha could not be verified. Please refresh the page and try again.");
                        if (submitBtn) submitBtn.disabled = false;
                    }
                });
            });
        </script>
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            feather.replace();
        });
    </script>
    @if (!isAuthPage)
    {
    <script type="module">
        import {onLCP, onINP, onCLS} from 'https://unpkg.com/web-vitals@4?module';

        function send(metric) {
          navigator.sendBeacon('/cwv', JSON.stringify({
            name: metric.name,
            value: metric.value,
            rating: metric.rating,
            id: metric.id,
            url: location.pathname,
            ts: Date.now()
          }));
        }

        onLCP(send);
        onINP(send);
        onCLS(send);
    </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
