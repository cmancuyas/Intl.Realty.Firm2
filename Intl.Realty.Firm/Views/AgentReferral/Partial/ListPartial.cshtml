@using Intl.Realty.Firm.Model.ViewModel.AgentReferralVM

@model AgentReferralListPartialViewModel

<div>
    <form id="ListFormId" method="POST" enctype="application/x-www-form-urlencoded">
    </form>
    <div class="row">
        <div class="col-md-12 d-flex justify-content-between align-items-center">
            <h1 class="text-blue mb-0">Agent Referals</h1>
            <div class="d-flex gap-4">
                <button type="button" id="btnMultipleDelete"
                        class="btn btn-danger d-none align-items-center"
                        data-toggle="tooltip"
                        data-bs-placement="left"
                        title="Delete"
                        onclick="OpenMultipleDeleteModal('AgentReferral')">
                    <i data-feather="trash-2"></i>
                </button>
@*                 <a asp-action="Create"
                   class="btn btn-primary d-flex align-items-center">
                    <i data-feather="plus" class="w-15px h-auto me-1"></i>Add New
                </a> *@
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <div class="tab-page">

        <!-- Dropdown for Mobile -->
        <div class="dropdown d-md-none mb-3">
            <button class="btn btn-primary dropdown-toggle"
                    type="button"
                    id="tabDropdown"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                @Model.Menus.FirstOrDefault(m => m.IsTrue)?.Description Menu
            </button>
            <ul class="dropdown-menu" aria-labelledby="tabDropdown">
                @foreach (var item in Model.Menus)
                {
                    <li>
                        <button class="dropdown-item"
                                data-bs-target="#@item.Control"
                                data-tab-id="@item.Tab"
                                data-route="@item.Control">
                            @item.Description
                        </button>
                    </li>
                }
            </ul>
        </div>

        <!-- Tab for Desktop -->
        <ul class="nav nav-tabs" id="usersManagementTab" role="tablist">
            @foreach (var item in Model.Menus)
            {
                <li class="nav-item mx-0">
                    <input type="hidden" id="menuId" name="menuId" value="@item.Id" />
                    <button class="nav-link @item.IsActive"
                            id="@item.Tab"
                            data-bs-toggle="tab"
                            data-bs-target="#@item.Control"
                            type="button"
                            role="tab"
                            aria-controls="@item.Control"
                            aria-selected="@item.IsSelected">
                        @item.Description
                    </button>
                </li>
            }
        </ul>

        <div class="tab-content">
            <div class="tab-pane active" id="AgentReferrals" aria-labelledby="AgentReferrals-tab">
                <div class="table-responsive">
                    <table id="modelTable" class="data-table table">
                        <thead>
                            <tr>
                                <th class="text-center w-5"><input id="select_all" type="checkbox" class="column-checkbox no-sort no-search" data-toggle="tooltip" data-bs-placement="left" title="Select all"></th>
                                @* <th class="text-start">@Html.DisplayCodeFor(model => model.Id)</th> *@
                                <th class="text-start">Referrer Name</th>
                                <th class="text-start">Referrer Phone</th>
                                <th class="text-start">Referred Agent Name</th>
                                <th class="text-start">Referred Agent Phone</th>
                                <th class="text-start">Action</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>
<style>
    .blurry {
        filter: blur(3px);
    }

    tfoot {
        display: table-header-group;
    }

</style>
<script src="~/js/viewDataTableUtility.js" asp-append-version="true"></script>
<script>
    $(document).ready(function () {

        feather.replace();
        $('[data-toggle="tooltip"]').tooltip();
        debugger;
        BindDataTable();

        // AddSearchBoxPerColumn();

        TabSelections();

        MultipleDelete();

        SearchBoxSettings();

        CheckboxSelect();

        $('#btnConfirmDelete').click(function () {
            $('#deleteConfirmModal').modal('hide');
            window.location.href = window.location.href.split('?')[0] + '?deleteSuccess=true';
        });

        $("#cancelBtn").click(function () {
            closeModal();
        });

        handleToastrNotification('addSuccess', 'New AgentReferral added successfully!');
        handleToastrNotification('editSuccess', 'AgentReferral updated successfully!');
        handleToastrNotification('deleteSuccess', 'Selection deleted successfully!');

    }); // End of document ready


        function BindDataTable() {

        let debounceTimer;

        // Destroy previous DataTable if exists
        if ($.fn.DataTable.isDataTable('#modelTable')) {
            $('#modelTable').DataTable().destroy();
        }

        table = $("#modelTable").DataTable({

            preDrawCallback: function () {
                $('#modelTable tbody').hide();
            },

            drawCallback: function () {
                $('#modelTable tbody td').addClass("blurry");
                $('#modelTable tbody').fadeIn(800);

                setTimeout(function () {
                    $('#modelTable tbody td').removeClass("blurry");
                }, 400);
            },

            // Design Assets
            stateSave: true,
            autoWidth: true,

            // ServerSide Setups
            processing: true,
            serverSide: true,

            lengthMenu: [
                [5, 10, 25, 50, 100, -1],
                [5, 10, 25, 50, 100, "All"]
            ],

            pageLength: 10,
            pagingType: "full_numbers",

            // Search
            searching: {
                regex: true
            },

            language: {
                infoFiltered: "",
                processing:
                    '<div class="lds-ellipsis"><div></div><div></div><div></div><div></div></div>'
            },

            // Export Buttons
            dom: 'lBfrtip',

            buttons: [
                {
                    text: 'Excel',
                    action: function () {
                        exportToExcel('AgentReferral');
                    }
                },
                {
                    text: 'CSV',
                    action: function () {
                        exportToCsv('AgentReferral');
                    }
                }
            ],

            // Ajax
            ajax: {
                url: "/AgentReferral/GetAgentReferralList",
                type: "POST",
                contentType: "application/json",
                dataType: "json",
                data: function (d) {
                    return JSON.stringify(d);
                }
            },

            // Columns
            columns: [
                {
                    data: null,
                    className: "text-center",
                    orderable: false,
                    searchable: false,
                    render: function (data, type, full) {
                        return '<input type="checkbox" class="row-checkbox no-sort no-search" name="selectedRows" value="' + full.id + '">';
                    }
                },

                {
                    data: "referrerName",
                    title: "Referrer Name"
                },

                {
                    data: "referrerPhone",
                    title: "Referrer Phone"
                },

                {
                    data: "referredAgentName",
                    title: "Referred Agent Name"
                },

                {
                    data: "referredAgentPhone",
                    title: "Referred Agent Phone"
                },

                {
                    data: null,
                    title: "Action",
                    orderable: false,
                    searchable: false,
                    render: function (data, type, full) {
                        return "#'>Preview</a>";
                    }
                }
            ],

            // Column Definitions
            columnDefs: [
                {
                    targets: "trim",
                    render: function (data, type) {

                        if (data == null)
                            return "";

                        if (type === "display")
                            return strtrunc(data, 10);

                        return data;
                    }
                },
                {
                    targets: "date-type",
                    type: "date-eu"
                }
            ]
        });

        // Debounced Search
        $('#search-input')
            .off('input')
            .on('input', function () {

                clearTimeout(debounceTimer);

                debounceTimer = setTimeout(function () {
                    table.search($('#search-input').val()).draw();
                }, 300);
            });
    }


    function strtrunc(str, num) {
        if (str.length > num) {
            return str.slice(0, num) + "...";
        }
        else {
            return str;
        }
    }

    function edit(rowContext) {
        if (table) {
            var data = table.row($(rowContext).parents("tr")).data();
            // alert("Example showing row edit with id: " + data["id"] + ", name: " + data["name"]);

            var id = data["id"];
            let parameters = { id: id };
            $.ajax({
                url: '/AgentReferral/Edit/' + id,
                type: 'GET',
                data: parameters,
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                success: function (data) {
                    window.location.href = "@Url.Action("Edit", "AgentReferral")" + "/" + id;
                }
            });

        }
    }

    function preview(rowContext) {
        if (table) {
            var data = table.row($(rowContext).parents("tr")).data();
            // alert("Example showing row edit with id: " + data["id"] + ", name: " + data["name"]);

            var id = data["id"];
            let parameters = { id: id };
            $.ajax({
                url: '/AgentReferral/Preview/' + id,
                type: 'GET',
                data: parameters,
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                success: function (data) {
                    window.location.href = "@Url.Action("Preview", "AgentReferral")" + "/" + id;
                }
            });

        }
    }

</script>