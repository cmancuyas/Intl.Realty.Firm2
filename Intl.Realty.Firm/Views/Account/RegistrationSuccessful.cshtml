@{
    ViewData["Title"] = "Registration Successful";
    var registeredEmail = TempData["RegisteredEmail"] as string;
    var emailSent = TempData["ConfirmationEmailSent"] as bool? ?? false;
    var emailWarning = TempData["EmailWarning"] as string;
    var successMessage = TempData["SuccessMessage"] as string;
}

<div class="row m-0 p-0 page-login">
    <div class="col-md-6 col-sm-12 page-login-container left-part">
        <img src="~/files/img/logo-irf-default.jpg" alt="Logo" class="img-fluid logo-login" />
    </div>
    <div class="col-md-6 col-sm-12 page-login-container right-part text-center">
        <h2 class="fw-bolder text-center mb-md-5 mb-4 text-success">
            Registration Successful
        </h2>

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success w-75 mx-auto" role="alert">
                @successMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(emailWarning))
        {
            <div class="alert alert-warning w-75 mx-auto" role="alert">
                @emailWarning
            </div>
        }
        else if (emailSent)
        {
            <p class="fw-medium text-center w-75 mx-auto">
                Registration completed successfully. A confirmation email
                @if (!string.IsNullOrWhiteSpace(registeredEmail))
                {
                    <text>was sent to <strong>@registeredEmail</strong></text>
                }
                else
                {
                    <text>was sent</text>
                }
                . Please check your inbox and spam folder.
            </p>
        }
        else
        {
            <p class="fw-medium text-center w-75 mx-auto">
                Registration completed successfully. You can now log in using your credentials.
            </p>
        }

        <hr />

        @if (!string.IsNullOrWhiteSpace(registeredEmail))
        {
            <div class="container-fluid w-75 px-0 mb-3">
                <p class="text-muted mb-2">Didn't get the email?</p>
                <form method="post" asp-action="ResendRegistrationEmail" asp-controller="Account" class="d-inline">
                    <input type="hidden" name="email" value="@registeredEmail" />
                    <button type="submit" class="btn btn-outline-primary cta mx-2">
                        Resend Confirmation Email
                    </button>
                </form>
            </div>
        }

        <div class="container-fluid w-75 px-0">
            <div class="row justify-content-center">
                <div class="col-md-12 text-center">
                    <a class="btn btn-secondary cta mx-2" asp-action="Login" asp-controller="Account">
                        Go to Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
