@{
    ViewData["Title"] = "User Agreement";
    Layout = "_Layout";
}

<div class="container py-5">
    <h1 class="h3 fw-bold mb-3">IRF Connect — User Agreement</h1>

    <p>
        By creating an IRF Connect account, you acknowledge that you are registering for access to
        systems operated by or on behalf of <strong>International Realty Firm, Inc.</strong>
    </p>

    <h2 class="h5 fw-bold mt-4">Account use</h2>
    <p>
        Your account is for authorized business use related to International Realty Firm activities.
        You are responsible for maintaining the confidentiality of your login credentials and for
        activity under your account.
    </p>

    <h2 class="h5 fw-bold mt-4">Contact</h2>
    <p>
        Questions about account terms or access:
        <a href="mailto:support@irfconnect.com">support@irfconnect.com</a>
    </p>

    <p class="text-muted small mt-4 mb-0">
        Approved legal terms are being finalized. This page provides context about account registration
        on IRF Connect. Contact support if you need the current agreement document.
    </p>

    <p class="mt-4 mb-0">
        <a asp-controller="Account" asp-action="Register">Back to registration</a>
    </p>
</div>
