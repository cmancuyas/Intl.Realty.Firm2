@{
    ViewData["Title"] = "Forgot Password Confirmation";
    Layout = "_Layout";
}
<container>

    <div class="row m-0 p-0 page-login">
        <div class="col-md-6 min-vh-100 d-flex flex-column align-items-center justify-content-center left-part">
            <img src="~/files/img/logo-irf-default.jpg" alt="Logo" class="img-fluid logo-login" />
        </div>
        <div class="col-md-6 d-flex flex-column align-items-center justify-content-center right-part text-center">
            <h2 class="fw-bolder mb-md-4 text-success">
                Forgot Password
            </h2>
            <p class="fw-medium w-75 mx-auto">
                If an account exists with the email you provided, we have sent instructions on how to reset your password.
                Please check your inbox and follow the steps to regain access to your account.
            </p>
            <hr class="w-75 my-4" />
            <a asp-action="Login" asp-controller="Account" class="btn btn-primary px-4">
                Return to Login
            </a>
        </div>
    </div>
</container>
