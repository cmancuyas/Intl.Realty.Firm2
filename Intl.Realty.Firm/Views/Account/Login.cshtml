@using Intl.Realty.Firm.Model.ViewModel.AccountVM
@using Intl.Realty.Firm.Models
@using Microsoft.Extensions.Options
@inject IOptions<GoogleCaptchaConfig> GoogleCaptchaConfig
@model LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<container>
    <div class="row m-0 p-0 page-login">
        <div class="col-md-6 col-sm-12 page-login-container left-part m-none">
            <img src="~/files/img/logo-irf-default.jpg" alt="Logo" class="img-fluid logo-login" />
        </div>
        <div class="col-md-6 col-sm-12 page-login-container right-part">
            <div class="col-sm-12 mb-5 text-center x-none">
                <img src="~/files/img/logo-irf-default.jpg" alt="Logo" class="img-fluid logo-login" />
            </div>

            <h3 class="fw-bolder text-center mb-md-5 m-none">
                International Realty Firm
            </h3>

            @* ✅ Show success message after password reset *@
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }


            <div class="d-width mb-md-2 mb-2">
                @using (Html.BeginForm("Login", "Account", FormMethod.Post))
                {
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="form-group mb-4">
                        <label class="fw-bolder" for="Email">Email Address</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @id = "email", @name = "email", @placeholder = "Please enter email" })
                        <span asp-validation-for="Email" class="text-danger fst-italic"></span>
                    </div>

                    <div class="form-group mb-1">
                        <label class="fw-bolder" for="password">Password</label>
                        <div class="input-group">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", @id = "password", @name = "password", @placeholder = "Please enter password" })
                            <button class="btn" type="button" id="password-toggle">
                                <i data-feather="eye" type="button"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger fst-italic"></span>
                    </div>

                    <div class="d-flex justify-content-end mb-md-5 mb-5">
                        <a href="@Url.Action("ForgotPassword", "Account")" class="text-decoration-none cta-sign-up">Forgot Password</a>
                    </div>

                    <input type="submit" value="Sign in" class="btn btn-primary w-100" />
                }
            </div>

            <div class="d-flex gap-1">
                <span class="text-secondary">Don't have an account?</span>
                <a href="@Url.Action("Register", "Account")" class="text-decoration-none cta-sign-up">Sign Up</a>
            </div>
        </div>
    </div>
</container>

<script src="https://code.jquery.com/jquery-3.7.1.js" integrity="sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4=" crossorigin="anonymous"></script>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            feather.replace();

            // ✅ Toggle password visibility
            $("#password-toggle").click(function () {
                var passwordInput = $("#password");
                var passwordToggle = $(this).find("i");

                if (passwordInput.attr("type") === "password") {
                    passwordInput.attr("type", "text");
                } else {
                    passwordInput.attr("type", "password");
                }
            });
        });
    </script>

}
}