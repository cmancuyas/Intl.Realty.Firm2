@using Intl.Realty.Firm.Model.ViewModel.AccountVM
@using Intl.Realty.Firm.Models
@using Microsoft.Extensions.Options
@inject IOptions<GoogleCaptchaConfig> GoogleCaptchaConfig
@model LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<container>
    <div class="row page-login m-0 p-0">
        <div class="col-md-6 col-sm-12 page-login-container left-part m-none">
            <img src="~/files/img/logo-irf-default.jpg" alt="Logo" class="img-fluid logo-login" />
        </div>

        <div class="col-md-6 col-sm-12 page-login-container right-part">
            <div class="col-sm-12 x-none mb-5 text-center">
                <img src="~/files/img/logo-irf-login.webp"
                     width="200"
                     height="160"
                     class="img-fluid"
                     alt="International Realty Firm logo"
                     decoding="async"
                     fetchpriority="high" />
            </div>

            <h3 class="fw-bolder mb-md-5 m-none text-center">
                International Realty Firm
            </h3>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="d-width mb-md-2 mb-2">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>🚫 @error.ErrorMessage</div>
                        }
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Login" asp-controller="Account" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- reCAPTCHA v3 token (populated by _Layout.cshtml) -->
                    <input type="hidden" id="LoginToken" name="token" />

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="form-group mb-4">
                        <label asp-for="Email" class="fw-bolder"></label>
                        <input asp-for="Email" class="form-control" placeholder="Please enter email" />
                        <span asp-validation-for="Email" class="text-danger fst-italic"></span>
                    </div>

                    <div class="form-group mb-1">
                        <label asp-for="Password" class="fw-bolder"></label>
                        <div class="input-group">
                            <input asp-for="Password" class="form-control" placeholder="Please enter password" />
                            <button class="btn" type="button" id="password-toggle">
                                <i data-feather="eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger fst-italic"></span>
                    </div>

                    <!-- Remember me + Forgot password -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label"></label>
                        </div>
                        <a asp-action="ForgotPassword" asp-controller="Account" class="text-decoration-none cta-sign-up">
                            Forgot Password?
                        </a>
                    </div>

                    <!-- Submit -->
                    <button type="submit" id="submitBtn" class="btn btn-primary w-100">
                        <span id="spinner" class="spinner-border spinner-border-sm d-none me-2"
                              role="status" aria-hidden="true"></span>
                        Sign in
                    </button>
                </form>
            </div>

            <div class="d-flex mt-3 gap-1">
                <span class="text-secondary">Don't have an account?</span>
                <a asp-action="Register" asp-controller="Account" class="text-decoration-none cta-sign-up">
                    Sign Up
                </a>
            </div>

            <div class="d-flex justify-content-center mt-5">
                <div class="login-help-text text-center">
                    Having trouble logging in?
                    <a asp-controller="Account"
                       asp-action="DetailedInstructions"
                       class="text-decoration-none">
                        Click here to see detailed instructions
                    </a>
                </div>
            </div>

        </div>
    </div>
</container>

<style>
    .login-help-text {
        font-size: 0.875rem;
        color: #4a4a4a;
    }
</style>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>

    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {

            feather.replace();

            // Toggle password visibility
            $("#password-toggle").on("click", function () {
                const input = $("#Password");
                input.attr("type", input.attr("type") === "password" ? "text" : "password");
            });

            const form = $("form");
            const submitBtn = $("#submitBtn");
            const spinner = $("#spinner");

            form.on("submit", function () {
                if (form.valid()) {
                    spinner.removeClass("d-none");
                    submitBtn.prop("disabled", true);
                }
            });
        });
    </script>
}
