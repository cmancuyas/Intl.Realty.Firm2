@using Intl.Realty.Firm.Model.ViewModel.AccountVM
@using Intl.Realty.Firm.Models
@using Microsoft.Extensions.Options
@inject IOptions<GoogleCaptchaConfig> GoogleCaptchaConfig
@model LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<container>
    <div class="row m-0 p-0 page-login">
        <div class="col-md-6 col-sm-12 page-login-container left-part m-none">
            <img src="~/files/img/logo-irf-default.jpg" alt="Logo" class="img-fluid logo-login" />
        </div>

        <div class="col-md-6 col-sm-12 page-login-container right-part">
            <div class="col-sm-12 mb-5 text-center x-none">
                <img src="~/files/img/logo-irf-default.jpg" alt="Logo" class="img-fluid logo-login" />
            </div>

            <h3 class="fw-bolder text-center mb-md-5 m-none">
                International Realty Firm
            </h3>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="d-width mb-md-2 mb-2">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>🚫 @error.ErrorMessage</div>
                        }
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form asp-action="Login" asp-controller="Account" method="post" novalidate>
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="form-group mb-4">
                        <label asp-for="Email" class="fw-bolder"></label>
                        <input asp-for="Email" class="form-control" placeholder="Please enter email" />
                        <span asp-validation-for="Email" class="text-danger fst-italic"></span>
                    </div>

                    <div class="form-group mb-1">
                        <label asp-for="Password" class="fw-bolder"></label>
                        <div class="input-group">
                            <input asp-for="Password" class="form-control" placeholder="Please enter password" />
                            <button class="btn" type="button" id="password-toggle">
                                <i data-feather="eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger fst-italic"></span>
                    </div>

                    @* ✅ Remember me + Forgot password aligned *@
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label"></label>
                        </div>
                        <a asp-action="ForgotPassword" asp-controller="Account" class="text-decoration-none cta-sign-up">Forgot Password?</a>
                    </div>

                    @* ✅ Sign in button with spinner placeholder *@
                    <button type="submit" id="submitBtn" class="btn btn-primary w-100">
                        <span class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true" id="spinner"></span>
                        Sign in
                    </button>
                </form>
            </div>

            <div class="d-flex gap-1 mt-3">
                <span class="text-secondary">Don't have an account?</span>
                <a asp-action="Register" asp-controller="Account" class="text-decoration-none cta-sign-up">Sign Up</a>
            </div>
            <div class="d-flex gap-1 mt-5">
                <p class="text-center w-100 login-help-text" style="font-size: 0.875rem; color: #4a4a4a;">
                    Having trouble logging in?
                    <a asp-controller="Account" asp-action="DetailedInstructions" style="color: #1a73e8; text-decoration: none;">
                        Click here to see detailed instructions
                    </a>
                </p>
            </div>

        </div>
    </div>
</container>
<styles>
    .login-help-text {
    font-size: 0.875rem;
    color: #4a4a4a;
    margin-top: 2.5rem;
    }

</styles>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        console.log("✅ Scripts section loaded");

        $(document).ready(function () {
            console.log("✅ DOM is ready");

            feather.replace();
            console.log("✅ Feather icons replaced");

            // Toggle password visibility
            $("#password-toggle").click(function () {
                const passwordInput = $("#Password");
                const isPassword = passwordInput.attr("type") === "password";
                passwordInput.attr("type", isPassword ? "text" : "password");

                console.log(`👁 Password visibility toggled: ${isPassword ? "showing" : "hiding"} password`);
            });

            const form = $("form");
            const submitBtn = $("#submitBtn");
            const spinner = $("#spinner");

            if (form.length) {
                console.log("✅ Login form found");

                form.on("submit", function (e) {
                    console.log("📝 Form submitted");

                    if (!form.valid()) {
                        console.warn("⚠️ Client-side validation failed");

                        const errors = $(".field-validation-error");
                        console.log(`🚨 Found ${errors.length} validation error(s)`);

                        errors.each(function () {
                            console.log("❌", $(this).text());
                        });
                    } else {
                        console.log("✅ Client-side validation passed");

                        // ✅ Show spinner and disable button
                        spinner.removeClass("d-none");
                        submitBtn.prop("disabled", true);
                    }
                });
            } else {
                console.warn("⚠️ No form element found");
            }
        });
    </script>
}
