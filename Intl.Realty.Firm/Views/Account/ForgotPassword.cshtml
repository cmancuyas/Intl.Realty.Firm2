@using Intl.Realty.Firm.Model.ViewModel.AccountVM

@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "ForgotPassword";
    Layout = "_Layout";
}
<container>

    <div class="row m-0 p-0 page-login">
        <div class="col-md-6 min-vh-100 d-flex flex-column align-items-center justify-content-center left-part">
            <img src="~/files/img/logo-irf-default.jpg" alt="Logo" class="img-fluid logo-login" />
        </div>
        <div class="col-md-6 d-flex flex-column align-items-center justify-content-center right-part">
            <h2 class="fw-bolder text-center mb-md-5">
                Reset Password
            </h2>
            <p class="fw-medium text-center w-75">Don't worry! It happens to the best of us. Simply enter your email address below, and we'll send you a link to reset your password.</p>
            <hr />
            <div class="container-fluid w-75 px-0">
                <div class="row">
                    <div class="col-md-12">
                        <form method="post">
                            <div class="form-group mb-3">
                                <label asp-for="Email">Email Address</label>
                                <input asp-for="Email" class="form-control" placeholder="Enter Your Email Address Here" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <button type="submit" class="btn btn-primary fr" asp-action="ForgotPassword">Send Reset Link</button>
                            <button type="button" class="btn btn-secondary fr me-3" onclick="window.location.href='@Url.Action("Login", "Account")'">Go back to Login</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</container>