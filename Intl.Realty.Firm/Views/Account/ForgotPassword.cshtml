@using Intl.Realty.Firm.Model.ViewModel.AccountVM

@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
}
<container>

    <div class="row m-0 p-0 page-login">
        <div class="col-md-6 col-sm-12 page-login-container left-part">
            <img src="~/files/img/logo-irf-default.jpg" alt="Logo" class="img-fluid logo-login" />
        </div>
        <div class="col-md-6 col-sm-12 page-login-container right-part">
            <h2 class="fw-bolder text-center mb-md-5 mb-4">
                Reset Your Password
            </h2>
            <p class="fw-medium text-center w-75 mx-auto">
                Forgot your password? No worries. Enter your email address below, and we'll send you a secure link to reset it.
            </p>
            <hr />
            <div class="container-fluid w-75 px-0">
                <div class="row">
                    <div class="col-md-12">
                        <form method="post">
                            <div class="form-group mb-4">
                                <label asp-for="Email">Email Address</label>
                                <input asp-for="Email" class="form-control" placeholder="Enter your email address" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="d-flex gap-3">
                                <button type="submit" class="btn btn-primary cta" asp-action="ForgotPassword">
                                    Send Reset Link
                                </button>
                                <button type="button" class="btn btn-secondary cta" onclick="window.location.href='@Url.Action("Login", "Account")'">
                                    Back to Login
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</container>
