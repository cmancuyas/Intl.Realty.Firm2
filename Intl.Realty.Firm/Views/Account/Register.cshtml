@using Intl.Realty.Firm.Model.ViewModel.AccountVM

@model RegisterViewModel

<container>
    <form asp-action="Register" asp-controller="Account" method="post">

        <input type="hidden" id="RegisterViewModelToken" name="Token" />

        <div class="row m-0 p-0 page-registration">
            <div class="col-md-4 col-sm-12 page-registration-container left-part m-none">
            </div>
            <div class="col-md-8 col-sm-12 page-registration-container right-part">
                <div class="d-flex flex-column w-80">
                    <div class="w-100">
                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="mb-5">
                            <h3 class="page-title fw-bolder mb-0">Please enter your details</h3>
                        </div>

                        <label class="fw-bolder">Full Name</label>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.TextBoxFor(m => m.FirstName,
                                         new
                                         {
                                             @class = "form-control",
                                             @id = "firstName",
                                             @name = "firstName",
                                             @placeholder = "First Name"
                                         })
                                @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-6 mb-3">
                                @Html.TextBoxFor(m => m.LastName,
                                         new
                                         {
                                             @class = "form-control",
                                             @id = "lastName",
                                             @name = "lastName",
                                             @placeholder = "Last Name"
                                         })
                                @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label class="fw-bolder">Email Address</label>
                                @Html.TextBoxFor(m => m.Email,
                                         new
                                         {
                                             @class = "form-control",
                                             @id = "emailAddress",
                                             @name = "emailAddress",
                                             @placeholder = "example@domain.com",
                                             @type = "email"
                                         }
                                         )
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-12">
                                <label class="fw-bolder">Contact Number</label>
                                @Html.TextBoxFor(m => m.Phone,
                                         new
                                         {
                                             @class = "form-control",
                                             @id = "contactNumber",
                                             @name = "contactNumber",
                                             @placeholder = "(+1) 999 999 9999"
                                         })
                                @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="fw-bolder">Password</label>
                                @Html.TextBoxFor(m => m.Password,
                                         new
                                         {
                                             @class = "form-control",
                                             @id = "Password",
                                             @name = "Password",
                                             @type = "password"
                                         })
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="fw-bolder">Confirm Password</label>
                                @Html.TextBoxFor(m => m.ConfirmPassword,
                                         new
                                         {
                                             @class = "form-control",
                                             @id = "ConfirmPassword",
                                             @name = "ConfirmPassword",
                                             @type = "password"
                                         })
                                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-check">
                            <label class="form-check-label" for="togglePassword">
                                <input class="form-check-input" type="checkbox" value="" id="togglePassword">
                                Show Password
                            </label>
                        </div>

                        <div class="form-check mt-4">
                            <label class="form-check-label" for="userAgreement">
                                @Html.CheckBoxFor(m => m.UserAgreement, new { @class = "form-check-input" })

                                <span class="text-danger">
                                    By creating an account, you agree to our <a href="#" class="text-danger">User Agreement</a> and have read and acknowledged the <a href="#" class="text-danger">Data Privacy Statement</a>.
                                </span>
                            </label>
                            @Html.ValidationMessageFor(m => m.UserAgreement, "", new { @class = "text-danger" })
                        </div>

                        <div class="row mt-5">
                            <div class="col-md-12 cta-controls">
                                <button type="button" id="loginBtn" class="btn btn-secondary cta ms-3" onclick="window.location.href='@Url.Action("Login", "Account")'">Go back to Login</button>
                                <button type="submit" id="submitBtn" class="btn btn-primary cta btnSubmit ms-3">Sign Up</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</container>


<script src="https://code.jquery.com/jquery-3.7.1.js" integrity="sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4=" crossorigin="anonymous"></script>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            feather.replace();
            togglePassword();
            // toggleUserAgreementCheckBox();
        });

        function toggleUserAgreementCheckBox()
        {
            $('#UserAgreement').click(function(){
                if (this.checked) {
                    $(this).attr("value", "true");
                } else {
                    $(this).attr("value", "false");
                }
            })
        }

        function togglePassword() {
            $('#togglePassword').click(function () {
                var type = $(this).is(':checked') ? 'text' : 'password';

                $('#Password, #ConfirmPassword').attr('type', type);
            });
        }

    </script>
}