@using Intl.Realty.Firm.Model.ViewModel.Account

@model RegisterViewModel

<container>
    <form asp-action="Register" asp-controller="Account" method="post">
        <div class="row m-0 p-0 page-registration">
            <div class="col-md-4 min-vh-100 d-flex flex-column align-items-center justify-content-center left-part">
            </div>
            <div class="col-md-8 d-flex align-items-center justify-content-center right-part">
                <div class="d-flex flex-column w-75">
                    <div class="w-100">
                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="mb-4">
                                <h5 class="fw-bolder mb-0">Please enter your details</h5>
                            </div>
                            <label class="fw-bolder">Full Name</label>
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    @Html.TextBoxFor(m => m.FirstName,
                                             new
                                             {
                                                 @class = "form-control",
                                                 @id = "firstName",
                                                 @name = "firstName",
                                                 @placeholder = "First Name"
                                             })
                                    @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-md-6">
                                    @Html.TextBoxFor(m => m.MiddleName,
                                             new
                                             {
                                                 @class = "form-control",
                                                 @id = "middleName",
                                                 @name = "middleName",
                                                 @placeholder = "Middle Name (Optional)"
                                             })
                                    @Html.ValidationMessageFor(m => m.MiddleName, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="row mb-5">
                                <div class="col-md-6">
                                    @Html.TextBoxFor(m => m.LastName,
                                             new
                                             {
                                                 @class = "form-control",
                                                 @id = "lastName",
                                                 @name = "lastName",
                                                 @placeholder = "Last Name"
                                             })
                                    @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-md-6">
                                    @Html.TextBoxFor(m => m.Suffix,
                                             new
                                             {
                                                 @class = "form-control",
                                                 @id = "suffix",
                                                 @name = "suffix",
                                                 @placeholder = "Suffix (Optional)"
                                             })
                                    @Html.ValidationMessageFor(m => m.Suffix, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <label class="fw-bolder">Contact Number</label>
                                    @Html.TextBoxFor(m => m.Phone,
                                             new
                                             {
                                                 @class = "form-control",
                                                 @id = "contactNumber",
                                                 @name = "contactNumber",
                                                 @placeholder = "(+1) 999 999 9999"
                                             })
                                    @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                                </div>
                            </div>
                 
             

                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <label class="fw-bolder">Email Address</label>
                                    @Html.TextBoxFor(m => m.Email,
                                             new
                                             {
                                                 @class = "form-control",
                                                 @id = "emailAddress",
                                                 @name = "emailAddress",
                                                 @placeholder = "example@domain.com",
                                                 @type = "email"
                                             }
                                             )
                                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <label class="fw-bolder">Password</label>
                                    @Html.TextBoxFor(m => m.Password,
                                             new
                                             {
                                                 @class = "form-control",
                                                 @id = "Password",
                                                 @name = "Password",
                                                 @type = "password"
                                             })
                                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <label class="fw-bolder">Confirm Password</label>
                                    @Html.TextBoxFor(m => m.ConfirmPassword,
                                             new
                                             {
                                                 @class = "form-control",
                                                 @id = "ConfirmPassword",
                                                 @name = "ConfirmPassword",
                                                 @type = "password"
                                             })
                                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-check mt-2">
                                <label class="form-check-label" for="togglePassword">
                                    <input class="form-check-input" type="checkbox" value="" id="togglePassword">
                                    Show Password
                                </label>
                            </div>

                 
                            <div class="form-check">
                                <label class="form-check-label" for="userAgreement">
                                    <input asp-for="UserAgreement" class="form-check-input" type="checkbox">
                                    <span class="small text-secondary">
                                        By creating an account, you agree to our <a href="#" class="link-secondary">User Agreement</a> and have read and acknowledged the <a href="#" class="link-secondary">Data Privacy Statement</a>.
                                    </span>
                                </label>
                            @Html.ValidationMessageFor(m => m.UserAgreement, "", new { @class = "text-danger" })
                            </div>
              
                        <div class="row mt-5">
                            <div class="col-md-12 cta-controls">
                                <button type="button" id="loginBtn" class="btn btn-secondary w-25 ms-3" onclick="window.location.href='@Url.Action("Login", "Account")'">Go back to Login</button>
                                <button type="reset"  id="resetBtn"  class="btn btn-secondary w-25 ms-3" onclick="$('.text-danger').hide();">Reset</button>
                                <button type="submit" id="submitBtn" class="btn btn-primary w-25 btnSubmit ms-3">Sign Up</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal fade" id="successModal" tabindex="-1" role="dialog" aria-labelledby="successModalLabel" aria-hidden="true" data-backdrop="static">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-body d-flex flex-column align-items-center py-5">
                        <div class="text-white bg-blue p-4 rounded-circle border-icon">
                            <i data-feather="mail" width="100" height="100"></i>
                        </div>
                        <h1 class="text-blue fw-bolder pt-3">Check your email</h1>
                        <span class="fw-bolder">An email confirmation has been sent to your inbox</span>
                    </div>
                    <div class="d-flex justify-content-center mb-5">
                        <button type="button" class="btn btn-primary w-25" id="btnRedirectLogin">Confirm</button>
                    </div>
                </div>
            </div>
        </div>

    </form>
    </div>
</container>


<script src="https://code.jquery.com/jquery-3.7.1.js" integrity="sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4=" crossorigin="anonymous"></script>
<script>
    $(document).ready(function () {
        feather.replace();
        togglePassword();

    });

    function togglePassword() {
        $('#togglePassword').click(function () {
            var type = $(this).is(':checked') ? 'text' : 'password';

            $('#Password, #ConfirmPassword').attr('type', type);
        });
    }

</script>