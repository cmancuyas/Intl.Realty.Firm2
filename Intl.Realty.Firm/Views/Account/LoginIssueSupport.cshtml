@using Intl.Realty.Firm.Model.ViewModel.AccountVM
@model SupportViewModel

@{
    ViewData["Title"] = "Login Issue Support";
    Layout = "_Layout";
}

<container>
    <div class="row m-0 p-0 page-login">
        <div class="col-md-6 col-sm-12 page-login-container left-part">
            <img src="~/files/img/logo-irf-default.jpg" alt="Logo" class="img-fluid logo-login" />
        </div>
        <div class="col-md-6 col-sm-12 page-login-container right-part">
            <h2 class="fw-bolder text-center mb-3">
                Please tell us more about your login issue!
            </h2>
            <p class="text-center text-muted w-75 mx-auto mb-4" style="font-size: 0.95rem;">
                We kindly request that all inquiries submitted via this form be those pertaining to login issues. For any other issues, please login and submit a request. All unrelated inquiries submitted via this form will not be addressed.
            </p>

            <div class="container-fluid w-75 px-0">
                <div class="row">
                    <div class="col-md-12">
                        <form method="post" asp-action="SubmitLoginIssue" id="supportForm">
                            <div class="form-group mb-3">
                                <label for="email" class="form-label">Email Address <span class="text-danger">*</span></label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="you@example.com" required />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label for="description" class="form-label">Description <span class="text-danger">*</span></label>
                                <textarea asp-for="Description" class="form-control" rows="4" minlength="15" placeholder="Please describe your login issue in detail..." required></textarea>
                                <small class="form-text text-muted">Your response must be at least 15 characters.</small>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 mt-2" id="submitBtn">
                                <span id="btnText">Submit</span>
                                <span id="spinner" class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</container>

@section Scripts {
    <script>
        document.getElementById("supportForm").addEventListener("submit", function () {
            const btn = document.getElementById("submitBtn");
            const spinner = document.getElementById("spinner");
            const btnText = document.getElementById("btnText");

            btn.disabled = true;
            spinner.classList.remove("d-none");
            btnText.textContent = "Submitting...";
        });
    </script>
}
