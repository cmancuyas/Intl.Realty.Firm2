@{
    ViewData["Title"] = "Data Privacy Statement";
    Layout = "_Layout";
}

<div class="container py-5">
    <h1 class="h3 fw-bold mb-3">IRF Connect — Data Privacy Statement</h1>

    <p>
        IRF Connect is the account portal for <strong>International Realty Firm, Inc.</strong>
        agents and other authorized users.
    </p>

    <h2 class="h5 fw-bold mt-4">Information we collect when you register</h2>
    <ul>
        <li>Your name</li>
        <li>Email address</li>
        <li>Contact phone number</li>
        <li>Account password (stored using industry-standard hashing; never stored in plain text)</li>
    </ul>

    <h2 class="h5 fw-bold mt-4">Why we collect this information</h2>
    <p>
        This information is used to create and manage your IRF Connect account, verify your identity,
        communicate account-related messages, and provide access to International Realty Firm systems
        you are authorized to use.
    </p>

    <h2 class="h5 fw-bold mt-4">Contact</h2>
    <p>
        Questions about your personal information or this statement:
        <a href="mailto:support@irfconnect.com">support@irfconnect.com</a>
    </p>

    <p class="text-muted small mt-4 mb-0">
        A full legal privacy policy is being finalized. This page describes the data collected on the
        registration form and how it is used. Contact support if you need additional details.
    </p>

    <p class="mt-4 mb-0">
        <a asp-controller="Account" asp-action="Register">Back to registration</a>
    </p>
</div>
