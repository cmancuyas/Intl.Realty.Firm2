@{
    ViewData["Title"] = "IRF Schedule B";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<div class="training">
    <h1>IRF Schedule B</h1>

    <div class="container-fluid py-4 p-0">
        <div class="alert alert-info mb-4">
            <b>Reminder:</b> It is mandatory to always include the IRF Schedule B on all listings. When you add or edit a listing on your board’s MLS, attach Schedule B in the listing’s attachments section.
        </div>

        <p>
            Please log in to your real estate board’s MLS and select add/edit on the left side menu. You can then enter the information from the MLS data sheet and upload photos. Attach our Schedule B to the attachments section of your listing.
        </p>

        <hr />

        <h2 class="h5">Listing upload help</h2>
        <p class="mb-3">Short video on how to upload your listing:</p>
        <a href="https://youtu.be/6EQUJyoGkNQ" target="_blank" rel="noopener noreferrer" class="btn btn-primary me-2 mb-2">Watch tutorial</a>
        <a href="http://edge.brokerbay.com/" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary mb-2">Log in to BrokerBay</a>
        <p class="text-muted small mt-2 mb-0">Or use the BrokerBay icon from the TRREB homepage (log into TRREB first).</p>

        <hr />

        <h2 class="h5">Need the Schedule B file?</h2>
        <p class="mb-3">
            If you do not have a current copy, email <a href="mailto:reception@internationalrealtyfirm.com?subject=IRF%20Schedule%20B%20request" class="training-link"><b>reception@internationalrealtyfirm.com</b></a> with the subject line &quot;IRF Schedule B request&quot; and the team will send it to you.
        </p>
        <p class="text-muted small mb-0">
            Additional training resources are on <b>Training</b> → <b>Training &amp; resources</b> in the left menu.
        </p>
    </div>
</div>
