@{
    ViewData["Title"] = "Commission Advance";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<h1>Commission Advances</h1>

<div class="commission-advance container-fluid">
    <div class="container py-5 px-0">

        <div class="row option-1 mt-4 mb-5">
            <div class="col-lg-12 col-md-10 col-sm-12">
                <h2 class="fw-bold mb-3">1st Option for Commission Advances</h2>
                <p>
                    It is no longer necessary to wait until after the closing date to receive your commission on any of your transactions! For a small fee, our partner advance company, <b>AccessEasyFunds</b> - <a href="www.accesseasyfunds.com" target="_blank">www.accesseasyfunds.com</a> - is the largest real estate advance firm in the industry. They are able to lend on residential and commercial, as well as pre-construction!
                </p>
                <p>Access your commission immediately instead of waiting, by visiting and signing up here:</p>
                <ul>
                    <li>
                        If first time, please set up an account – <a href="https://www.accesseasyfunds.com/application/new-customers/" target="_blank">www.accesseasyfunds.com/application/new-customers</a>
                    </li>
                    <li>
                        Existing Clients submit new advance requests - <a href="https://www.accesseasyfunds.com/application/existing-customers" target="_blank">www.accesseasyfunds.com/application/existing-customers</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="row option-2">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <h2 class="fw-bold mb-3">2nd Option for Commission Advances</h2>
                <p><img src="/files/img/option-2.png" class="img-fluid rounded"></p>
            </div>
        </div>

    </div>
</div>

