@{
    ViewData["Title"] = "Business Card";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<div class="business-card">

    <h1>Business Card</h1>

    <div class="container-fluid py-5 p-0">
        <div class="accordion" id="trainingAccordion">
            <!-- Commission Processing -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingOne">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                        Business Cards and Signs
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#trainingAccordion">
                    <div class="accordion-body px-5">
                        <div class="row mt-4 mb-5">
                            <div class="col-lg-12 col-sm-12">
                                <h3 class="fw-bold mb-5">Business Cards and Signs</h3>
                                <p>
                                    Order by emailing <a href="mailto:info@vectormind.ca" class="training-link">info@vectormind.ca</a> (please allow 1-2 days for response by email, they are very busy supplying our agents)
                                </p>
                                <p>
                                    <b>For your sign installation</b> we recommend to order online here: <a href="https://thesigninstallers.com/" target="_blank" class="training-link">https://thesigninstallers.com</a>
                                </p>
                                <p class="px-0 mt-5"><img src="/files/img/business-cards.png" class="img-fluid"></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Brokerage RECO Registration #: 4799095 (for RECO renewals) -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingTwo">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                        Real Estate Photography
                    </button>
                </h2>
                <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#trainingAccordion">
                    <div class="accordion-body px-5">
                        <div class="row mt-4 mb-5">
                            <div class="col-lg-12 col-sm-12">
                                <h3 class="fw-bold mb-5">Odyssey3D & International Realty Firm Partnership</h3>
                                <p>
                                    <b>Why Us?</b>
                                </p>
                                <ul>
                                    <li class="mb-2">
                                        We offer a one-stop-shop for everything a listing would need to be marketed and sold online <a href="http://www.odyssey3d.ca/" target="_blank" class="training-link">Check out our website</a> or <a href="https://youtu.be/WNQzNxnAtSU" target="_blank" class="training-link">Watch this video</a>
                                    </li>
                                    <li class="mb-2">
                                        We are ranked #1 in Toronto for Matterport 3D Virtual Tour Volume in 2020.
                                     </li>
                                    <li class="mb-2">
                                        We are the Highest Rated Toronto Virtual Tour Provider with <a href="https://www.google.com/search?q=odyssey3d&oq=odyssey3d+&aqs=chrome.0.69i59j0j46i175i199j69i60l3j69i61l2.1814j0j4&sourceid=chrome&ie=UTF-8#lrd=0x882b2e2faa35a74f:0x849d2abd4803c613,1,,," target="_blank" class="training-link">5 Star Google Review Score</a>
                                    </li>
                                    <li class="mb-2">
                                        We service all areas covered all the way from Barrie to Hamilton, to Oshawa, and in between with no distance fees <a href="https://www.google.com/maps/d/u/0/edit?mid=17tjeb-AuAZLTECY4LRDRrugJU1Fn8yWn&usp=sharing" target="_blank" class="training-link">See here for our coverage map</a>.
                                    </li>
                                </ul>

                                <p class="mt-5 mb-0">
                                    <b>How will IRF Realtors Benefit?</b>
                                </p>
                                <p class="px-0 mb-0">
                                    <img src="/files/img/real-estate-photography.png" class="img-fluid">
                                </p>
                                <ul>
                                    <li class="mb-2">
                                        IRF Realtors get access to the full range of Odyssey3D services at preferred rates (see <a href="http://www.odyssey3d.ca/" target="_blank" class="training-link">www.Odyssey3D.ca</a> for all services and demos)
                                    </li>
                                    <li class="mb-2">
                                        Every IRF Realtor gets $50 welcome e-gift card
                                    </li>
                                    <li class="mb-2">
                                        <p class="mb-2">Every IRF Realtor gets 6% off on all their shoots (8%off after 5 shoots; 10% off after 10</p>
                                        <ol>
                                            <li>IRF50 - $50 off (1st order only)</li>
                                            <li>IRF6 - 6% off</li>
                                            <li>IRF8 - 8% off</li>
                                            <li>IRF10 - 10% off</li>
                                        </ol>
                                    </li>
                                    <li class="mb-2">
                                        Free Professional Heads Shots for all Agents at 1 Major Brokerage Event Every Year - Post Pandemic
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {

        });

    </script>
}