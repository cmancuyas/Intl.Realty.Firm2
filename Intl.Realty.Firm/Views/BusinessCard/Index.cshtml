@{
    ViewData["Title"] = "Business Card";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<div class="business-card">

    <h1>Business Card</h1>

    <div class="container-fluid py-5 p-0">
        <div class="accordion" id="businessCardsAccordion">
            <!-- Business Cards and Signs -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingOne">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                        Business Cards and Signs
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#businessCardsAccordion">
                    <div class="accordion-body px-5">
                        <div class="row mt-4 mb-5">
                            <div class="col-lg-12 col-sm-12">
                                <h3 class="fw-bold mb-5">Business Cards and Signs</h3>
                                <p>
                                    Order by emailing <a href="mailto:info@vectormind.ca" class="training-link">info@vectormind.ca</a> (please allow 1-2 days for response by email, they are very busy supplying our agents)
                                </p>
                                <p>
                                    <b>For your sign installation</b> we recommend to order online here: <a href="https://thesigninstallers.com/" target="_blank" class="training-link">https://thesigninstallers.com</a>
                                </p>
                                <p class="px-0 mt-5"><img src="/files/img/business-cards.png" class="img-fluid"></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>


@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {

        });

    </script>
}
