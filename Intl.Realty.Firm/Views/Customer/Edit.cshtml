@using Intl.Realty.Firm.Model.ViewModel.CustomerVM

@model EditCustomerWithTabMenuViewModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<div class="page-controller mb-5">
    <a href="@Url.Action("Index","Customer")" class="text-decoration-none back d-flex mb-4">
        <i data-feather="chevron-left"></i><span>Back</span>
    </a>

    <div class="row justify-content-center">
        <div class="col-md-12 card p-4">
            <h1 class="text-blue mb-0">Edit Customer</h1>
            <hr class="my-4" />
            <form asp-action="Edit"
                  asp-controller="Customer"
                  method="post"
                  enctype="multipart/form-data">
                <input type="hidden" asp-for="EditCustomer.Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>




                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="EditCustomer.FirstName" class="control-label fw-bolder">First Name</label>
                            <input asp-for="EditCustomer.FirstName" class="form-control" />
                            <span asp-validation-for="EditCustomer.FirstName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="EditCustomer.LastName" class="control-label fw-bolder">Last Name</label>
                            <input asp-for="EditCustomer.LastName" class="form-control" />
                            <span asp-validation-for="EditCustomer.LastName" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="EditCustomer.Email" class="control-label fw-bolder"></label>
                            <input asp-for="EditCustomer.Email" class="form-control" />
                            <span asp-validation-for="EditCustomer.Email" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="EditCustomer.TelephoneNumber" class="control-label fw-bolder">Telephone Number</label>
                            <input asp-for="EditCustomer.TelephoneNumber" class="form-control" />
                            <span asp-validation-for="EditCustomer.TelephoneNumber" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="EditCustomer.Address" class="control-label fw-bolder"></label>
                            <input asp-for="EditCustomer.Address" class="form-control" />
                            <span asp-validation-for="EditCustomer.Address" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                @*               <div class="row mb-4">
                <div class="col-md-12">
                <div class="form-check form-switch d-flex align-items-center gap-2">
                <input id="isDeletedCheckbox" class="form-check-input" type="checkbox" asp-for="IsDeleted">
                <label id="lblStatusSoftDelete" class="fw-bolder">Not Deleted</label>
                </div>
                <span asp-validation-for="IsDeleted" class="text-danger"></span>
                </div>
                </div> *@
                <hr class="my-5" />
                <div class="form-group d-flex justify-content-center gap-4">
                    <input type="button" value="Cancel" class="btn btn-secondary w-15" onclick="window.location.href='@Url.Action("Index", "Customer")'" />
                    @* <button type="reset" class="btn btn-secondary w-15" onclick="$('.text-danger').hide();">Reset</button> *@
                    <button type="submit" class="btn btn-primary w-15" onclick="$('.text-danger').show();">Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script type="text/javascript">
        $(document).ready(function () {

            $('#isActiveCheckbox').on('click', toggleStatusLabels);
            $('#isDeletedCheckbox').on('click', toggleStatusLabelSoftDelete);

            toggleStatusLabels();
            toggleStatusLabelSoftDelete();
        });

        function toggleStatusLabels() {
            if ($('#isActiveCheckbox').is(':checked')) {
                $('#lblStatus').css('color', '#0d6efd').text("Active");
            } else {
                $('#lblStatus').css('color', '#bfbfbf').text("Inactive");
            }
        }
        function toggleStatusLabelSoftDelete() {

            if ($('#isDeletedCheckbox').is(':checked')) {
                $('#lblStatusSoftDelete').css('color', '#0d6efd').text("IsDeleted");
            } else {
                $('#lblStatusSoftDelete').css('color', '#bfbfbf').text("NotDeleted");
            }
        }
    </script>

}