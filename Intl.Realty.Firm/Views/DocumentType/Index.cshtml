@using Intl.Realty.Firm.Model.ViewModel.DocumentTypeVM

@model IEnumerable<DocumentTypeViewModel>

@{
    ViewData["Title"] = "DocumentType";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<div>
    <div class="c-content" id="ListPartialContainer">
        <div class="d-flex justify-content-center">
            @{
                @await Html.PartialAsync("~/Views/Shared/_Spinner.cshtml");
            }
        </div>
    </div>
    <div id="DeleteModalContainer"></div>
    <div id="DeleteMultipleModalContainer"></div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $('#ListPartialContainer').load('/DocumentType/ListPartialView');
        });
        function OpenDeleteModal(id) {
            $('#DeleteModalContainer').load('/DocumentType/DeleteModal/' + id, function () {
                $("#deleteConfirmModal").modal("show");
            });
        }
        function ShowDetails(id) {
            $('#item-' + id).addClass('c-show-hidden');
        }
        function HideDetails(id) {
            $('#item-' + id).removeClass('c-show-hidden');
        }
    </script>
}