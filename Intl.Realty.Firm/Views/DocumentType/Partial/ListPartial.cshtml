@using Intl.Realty.Firm.Model.ViewModel.DocumentTypeVM

@model DocumentTypeListPartialViewModel

<div>
    <form id="ListFormId" method="POST" enctype="application/x-www-form-urlencoded">
    </form>
    <div class="row">
        <div class="col-md-12 d-flex justify-content-between align-items-center">
            <h1 class="text-blue mb-0">Document Type</h1>
            <div class="d-flex gap-4">
                <button type="button" id="btnMultipleDelete"
                        class="btn btn-danger d-none align-items-center"
                        data-toggle="tooltip"
                        data-bs-placement="left"
                        title="Delete"
                        onclick="OpenMultipleDeleteModal('DocumentType')">
                    <i data-feather="trash-2"></i>
                </button>
                <a asp-action="Create"
                   class="btn btn-primary d-flex align-items-center">
                    <i data-feather="plus" class="w-15px h-auto me-1"></i>Add New
                </a>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <!-- Dropdown for Mobile -->
    <div class="dropdown d-md-none mb-3">
        <button class="btn btn-primary dropdown-toggle"
                type="button"
                id="tabDropdown"
                data-bs-toggle="dropdown"
                aria-expanded="false">
            @Model.Menus.FirstOrDefault(m => m.IsTrue)?.Description Menu
        </button>
        <ul class="dropdown-menu" aria-labelledby="tabDropdown">
            @foreach (var item in Model.Menus)
            {
                <li>
                    <button class="dropdown-item"
                            data-bs-target="#@item.Control"
                            data-tab-id="@item.Tab"
                            data-route="@item.Control">
                        @item.Description
                    </button>
                </li>
            }
        </ul>
    </div>

    <!-- Tab for Desktop -->
    <div class="tab-page">
        <ul class="nav nav-tabs" id="transactionManagementTabs" role="tablist">
            @foreach (var item in Model.Menus)
            {
                <li class="nav-item mx-0">
                    <input type="hidden" id="menuId" name="menuId" value="@item.Id" />
                    <button class="nav-link @item.IsActive"
                            id="@item.Tab"
                            data-bs-toggle="tab"
                            data-bs-target="#@item.Control"
                            type="button"
                            role="tab"
                            aria-controls="@item.Control"
                            aria-selected="@item.IsSelected">
                        @item.Description
                    </button>
                </li>
            }
        </ul>

        <div class="tab-content">
            <div class="tab-pane active" id="documentTypes" aria-labelledby="documentTypes-tab">
                <div class="table-responsive">
                    <table id="modelTable" class="data-table table">
                        <thead>
                            <tr>
                                <th class="text-center w-5"><input id="select_all" type="checkbox" class="column-checkbox no-sort no-search" data-toggle="tooltip" data-bs-placement="left" title="Select all"></th>
                                <th class="text-start">Code</th>
                                <th class="text-start">Description</th>
                                <th class="text-start">Action</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>
<style>
    .blurry {
        filter: blur(3px);
    }

    tfoot {
        display: table-header-group;
    }

</style>
<script src="~/js/viewDataTableUtility.js" asp-append-version="true"></script>
<script>
    $(document).ready(function () {

        feather.replace();
        $('[data-toggle="tooltip"]').tooltip();

        BindDataTable();

        // AddSearchBoxPerColumn();

        TabSelections();

        MultipleDelete();

        SearchBoxSettings();

        CheckboxSelect();

        $('#btnConfirmDelete').click(function () {
            $('#deleteConfirmModal').modal('hide');
            window.location.href = window.location.href.split('?')[0] + '?deleteSuccess=true';
        });

        $("#cancelBtn").click(function () {
            closeModal();
        });

        handleToastrNotification('addSuccess', 'New DocumentType added successfully!');
        handleToastrNotification('editSuccess', 'DocumentType updated successfully!');
        handleToastrNotification('deleteSuccess', 'Selection deleted successfully!');

    }); // End of document ready


    function BindDataTable() {
        let debounceTimer;

        // Destroy previous DataTable if exists
        if ($.fn.DataTable.isDataTable('#modelTable')) {
            $('#modelTable').DataTable().destroy();
        }

        table = $("#modelTable").DataTable({
            preDrawCallback: function () {
                $('#modelTable tbody').hide();
            },
            drawCallback: function () {
                $('#modelTable tbody td').addClass("blurry");
                $('#modelTable tbody').fadeIn(800);
                setTimeout(() => {
                    $('#modelTable tbody td').removeClass("blurry");
                }, 400);
            },

            stateSave: true,
            autoWidth: true,

            processing: true,
            serverSide: true,
            lengthMenu: [[5, 10, 25, 50, 100, -1], [5, 10, 25, 50, 100, "All"]],
            pageLength: 10,
            pagingType: "full_numbers",

            searching: { regex: true },
            language: {
                infoFiltered: "",
                processing: '<div class="lds-ellipsis"><div></div><div></div><div></div><div></div></div>'
            },

            dom: 'lBfrtip',
            buttons: [
                {
                    text: 'Excel',
                    action: function () {
                        exportToExcel('DocumentType');
                    }
                },
                {
                    text: 'CSV',
                    action: function () {
                        exportToCsv('DocumentType');
                    }
                }
            ],

            ajax: {
                url: "/DocumentType/GetDocumentTypeList",
                type: "POST",
                contentType: "application/json",
                dataType: "json",
                data: function (data) {
                    return JSON.stringify(data);
                }
            },

            columns: [
                {
                    data: null,
                    className: 'text-center',
                    orderable: false,
                    searchable: false,
                    render: function (data, type, full) {
                        return `<input type="checkbox" class="row-checkbox" name="selectedRows" value="${full.id}">`;
                    }
                },
                { data: "code" },
                { data: "description", title: "Description" },
                {
                    data: null,
                    className: "text-center text-nowrap",
                    orderable: false,
                    searchable: false,
                    render: function () {
                        return `<a class='btn btn-secondary me-1' href='#' onclick='preview(this)'>Preview</a><a class='btn btn-secondary' href='#' onclick='edit(this)'>Edit</a>`;
                    }
                }
            ]
        });

        // Debounced search input
        $('#search-input').on('input', function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(function () {
                table.search($('#search-input').val()).draw();
            }, 300);
        });
    }



    function strtrunc(str, num) {
        if (str.length > num) {
            return str.slice(0, num) + "...";
        }
        else {
            return str;
        }
    }

    function edit(rowContext) {
        if (table) {
            var data = table.row($(rowContext).parents("tr")).data();
            // alert("Example showing row edit with id: " + data["id"] + ", name: " + data["name"]);

            var id = data["id"];
            let parameters = { id: id };
            $.ajax({
                url: '/DocumentType/Edit/' + id,
                type: 'GET',
                data: parameters,
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                success: function (data) {
                    window.location.href = "@Url.Action("Edit", "DocumentType")" + "/" + id;
                }
            });

        }
    }

    function preview(rowContext) {
        if (table) {
            var data = table.row($(rowContext).parents("tr")).data();
            // alert("Example showing row edit with id: " + data["id"] + ", name: " + data["name"]);

            var id = data["id"];
            let parameters = { id: id };
            $.ajax({
                url: '/DocumentType/Preview/' + id,
                type: 'GET',
                data: parameters,
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                success: function (data) {
                    window.location.href = "@Url.Action("Preview", "DocumentType")" + "/" + id;
                }
            });

        }
    }

</script>