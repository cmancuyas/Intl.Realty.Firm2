@using Intl.Realty.Firm.Model.ViewModel.DocumentTypeVM

@model EditDocumentTypeWithTabMenuViewModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<div class="mb-5">
    <a href="@Url.Action("Index","DocumentType")" class="text-decoration-none text-blue d-flex mb-4">
        <i data-feather="chevron-left"></i><span>Back</span>
    </a>

    <div class="row justify-content-center">
        <div class="col-md-8 card p-4">
            <h1 class="text-blue mb-0">Edit DocumentType</h1>
            <hr class="my-4" />
            <form asp-action="Edit"
                  asp-controller="DocumentType"
                  method="post"
                  enctype="multipart/form-data">
                <input type="hidden" asp-for="EditDocumentType.Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="tab-page">
@*                     <ul class="nav nav-tabs" id="administrationManagementTab" role="tablist">
                        @foreach (var item in Model.Menus)
                        {
                            <li class="nav-item mx-0">
                                <input type="hidden" id="menuId" name="menuId" value="@item.Id" />
                                <button class="nav-link @item.IsActive"
                                        id="@item.Tab"
                                        data-bs-toggle="tab"
                                        data-bs-target="#@item.Control"
                                        type="button"
                                        role="tab"
                                        aria-controls="@item.Control"
                                        aria-selected="@item.IsSelected">
                                    @item.Description
                                </button>
                            </li>
                        }
                    </ul> *@
                </div>

                <div class="tab-content" style="border-bottom:none;background-color:white;">

                    <div class="tab-pane active" id="departmentDetails" aria-labelledby="departmentDetails-tab" style="background-color:white;">

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="EditDocumentType.Code" class="control-label fw-bolder"></label>
                                    <input asp-for="EditDocumentType.Code" class="form-control" />
                                    <span asp-validation-for="EditDocumentType.Code" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="EditDocumentType.Description" class="control-label fw-bolder"></label>
                                    <input asp-for="EditDocumentType.Description" class="form-control" />
                                    <span asp-validation-for="EditDocumentType.Description" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-12">
                                <div class="form-check form-switch d-flex align-items-center gap-2">
                                    <input id="isActiveCheckbox" class="form-check-input" type="checkbox" asp-for="EditDocumentType.IsActive">
                                    <label id="lblStatus" class="fw-bolder">Active</label>
                                </div>
                                <span asp-validation-for="EditDocumentType.IsActive" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-md-12">
                                <div class="form-check form-switch d-flex align-items-center gap-2">
                                    <input id="isRequiredCheckbox" class="form-check-input" type="checkbox" asp-for="EditDocumentType.IsRequired">
                                    <label id="lblDocumentTypeStatus" class="fw-bolder">Required</label>
                                </div>
                                <span asp-validation-for="EditDocumentType.IsRequired" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                </div>
                @*               <div class="row mb-4">
                <div class="col-md-12">
                <div class="form-check form-switch d-flex align-items-center gap-2">
                <input id="isDeletedCheckbox" class="form-check-input" type="checkbox" asp-for="IsDeleted">
                <label id="lblStatusSoftDelete" class="fw-bolder">Not Deleted</label>
                </div>
                <span asp-validation-for="IsDeleted" class="text-danger"></span>
                </div>
                </div> *@
                <hr class="my-5" />
                <div class="form-group d-flex justify-content-center gap-4">
                    <input type="button" value="Cancel" class="btn btn-secondary w-15" onclick="window.location.href='@Url.Action("Index", "DocumentType")'" />
                    <button type="reset" class="btn btn-secondary w-15" onclick="$('.text-danger').hide();">Reset</button>
                    <button type="submit" class="btn btn-primary w-15" onclick="$('.text-danger').show();">Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script type="text/javascript">
        $(document).ready(function () {

            $('#isActiveCheckbox').on('click', toggleStatusLabels);
            $('#isDeletedCheckbox').on('click', toggleStatusLabelSoftDelete);

            toggleStatusLabels();
            toggleStatusLabelSoftDelete();
        });

        function toggleStatusLabels() {
            if ($('#isActiveCheckbox').is(':checked')) {
                $('#lblStatus').css('color', '#0d6efd').text("Active");
            } else {
                $('#lblStatus').css('color', '#bfbfbf').text("Inactive");
            }
        }
        function toggleStatusLabelSoftDelete() {

            if ($('#isDeletedCheckbox').is(':checked')) {
                $('#lblStatusSoftDelete').css('color', '#0d6efd').text("IsDeleted");
            } else {
                $('#lblStatusSoftDelete').css('color', '#bfbfbf').text("NotDeleted");
            }
        }
    </script>

}