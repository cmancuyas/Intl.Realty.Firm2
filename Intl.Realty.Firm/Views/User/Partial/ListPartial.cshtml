                success: function (data) {
                    window.location.href = "@Url.Action("Preview", "User")" + "/" + id;
                }
            });

        }
    }
    function manageUserRoles(rowContext) {
        if (table) {
            var data = table.row($(rowContext).parents("tr")).data();
            // alert("Example showing row edit with id: " + data["id"] + ", name: " + data["name"]);
            var id = data["id"];
            let parameters = { id: id };
            $.ajax({
                url: '/User/ManageUserRoles/' + id,
                type: 'GET',
                data: parameters,
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                success: function (data) {
                    window.location.href = "@Url.Action("ManageUserRoles", "User")" + "/" + id;
                }
            });

        }
    }
    function manageUserClaims(rowContext) {
        if (table) {
            var data = table.row($(rowContext).parents("tr")).data();
            // alert("Example showing row edit with id: " + data["id"] + ", name: " + data["name"]);

            var id = data["id"];
            let parameters = { id: id };
            $.ajax({
                url: '/User/ManageUserClaims/' + id,
                type: 'GET',
                data: parameters,
                contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                success: function (data) {
                    window.location.href = "@Url.Action("ManageUserClaims", "User")" + "/" + id;
                }
            });

        }
    }
</script>