@using Intl.Realty.Firm.Model.ViewModel.UserVM

@model UserListPartialWithTabMenuViewModel

<div>
    <form id="ListFormId" method="POST" enctype="application/x-www-form-urlencoded">
    </form>
    <div class="row">
        <div class="col-md-12 d-flex justify-content-between align-items-center">
            <h1 class="text-blue mb-0">Users</h1>
            <div class="d-flex gap-4">
                <button type="button" id="btnMultipleDelete"
                        class="btn btn-danger d-none align-items-center"
                        data-toggle="tooltip"
                        data-bs-placement="left"
                        title="Delete"
                        onclick="OpenMultipleDeleteModalAsJson('User')">
                    <i data-feather="trash-2"></i>
                </button>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <div class="tab-page">

        <!-- Dropdown for Mobile -->
        <div class="dropdown d-md-none mb-3">
            <button class="btn btn-primary dropdown-toggle"
                    type="button"
                    id="tabDropdown"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                @Model.Menus.FirstOrDefault(m => m.IsTrue)?.Description Menu
            </button>
            <ul class="dropdown-menu" aria-labelledby="tabDropdown">
                @foreach (var item in Model.Menus)
                {
                    <li>
                        <button class="dropdown-item"
                                data-bs-target="#@item.Control"
                                data-tab-id="@item.Tab"
                                data-route="@item.Control">
                            @item.Description
                        </button>
                    </li>
                }
            </ul>
        </div>

        <!-- Tab for Desktop -->
        <ul class="nav nav-tabs" id="usersManagementTab" role="tablist">
            @foreach (var item in Model.Menus)
            {
                <li class="nav-item mx-0">
                    <input type="hidden" id="menuId" name="menuId" value="@item.Id" />
                    <button class="nav-link @item.IsActive"
                            id="@item.Tab"
                            data-bs-toggle="tab"
                            data-bs-target="#@item.Control"
                            type="button"
                            role="tab"
                            aria-controls="@item.Control"
                            aria-selected="@item.IsSelected">
                        @item.Description
                    </button>
                </li>
            }
        </ul>

        <div class="tab-content">
            <div class="tab-pane active" id="users" aria-labelledby="users-tab">
                <div class="table-responsive">
                    <table id="modelTable" class="data-table table">
                        <thead>
                            <tr>
                                <th class="text-center w-5">
                                    <input id="select_all" type="checkbox" class="column-checkbox no-sort no-search" data-toggle="tooltip" data-bs-placement="left" title="Select all">
                                </th>
                                <th class="text-start">FirstName</th>
                                <th class="text-start">LastName</th>
                                <th class="text-start">Email</th>
                                <th class="text-start">Email Status</th>
                                <th class="text-start">Action</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="resetPasswordModalLabel">Reset User Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="resetPasswordModalContent">
                    <p>Reset password for: <span id="resetUserEmail"></span></p>
                </div>
                <div id="resetPasswordModalResult" style="display:none;">
                    <div class="alert alert-success">
                        <strong>New Password:</strong> <code id="generatedPassword"></code><br>
                        <small>Copy and provide this password to the user. It will not be shown again.</small>
                    </div>
                </div>
                <div id="resetPasswordModalError" class="alert alert-danger" style="display:none;"></div>
            </div>
            <div class="modal-footer" id="resetPasswordModalFooter">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmResetPasswordBtn" class="btn btn-danger">Generate New Password</button>
            </div>
        </div>
    </div>
</div>

<style>
    .blurry {
        filter: blur(3px);
    }

    tfoot {
        display: table-header-group;
    }
</style>

<script src="~/js/viewDataTableUtility.js" asp-append-version="true"></script>

<script>
    $(document).ready(function () {
        feather.replace();
        $('[data-toggle="tooltip"]').tooltip();

        BindDataTable();
        TabSelections();
        MultipleDelete();
        SearchBoxSettings();
        CheckboxSelect();

        $('#btnConfirmDelete').click(function () {
            $('#deleteConfirmModal').modal('hide');
            window.location.href = window.location.href.split('?')[0] + '?deleteSuccess=true';
        });

        $("#cancelBtn").click(function () {
            closeModal();
        });

        handleToastrNotification('addSuccess', 'New User added successfully!');
        handleToastrNotification('editSuccess', 'User updated successfully!');
        handleToastrNotification('deleteSuccess', 'Selection deleted successfully!');
    });

    function BindDataTable() {
        if ($.fn.DataTable.isDataTable('#modelTable')) {
            $('#modelTable').DataTable().destroy();
        }

        table = $("#modelTable").DataTable({
            stateSave: true,
            autoWidth: true,
            processing: true,
            serverSide: true,
            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]], // Default options
            pageLength: 10, // Default pagination size
            pagingType: "full_numbers",
            searching: { regex: true },
            "language": {
                "infoFiltered": "",
                "processing": '<div class="lds-ellipsis"><div></div><div></div><div></div><div></div></div>'
            },
            dom: 'lBfrtip',
            buttons: [
                { text: 'Excel', action: function () { exportToExcel('User'); } },
                { text: 'CSV', action: function () { exportToCsv('User'); } }
            ],
            ajax: {
                url: "/User/GetUserList",
                type: "POST",
                contentType: "application/json",
                dataType: "json",
                data: function (data) {
                    let stringify = JSON.stringify(data);
                    return stringify;
                }
            },
            columns: [
                {
                    targets: 0,
                    data: "id",
                    className: 'text-center',
                    render: function (data) {
                        return data ? `<input type="checkbox" class="row-checkbox" value="${data}">` : "";
                    },
                    orderable: false
                },
                { data: "firstName", title: "Firstname", render: data => data && data !== "N/A" ? data : "-" },
                { data: "lastName", title: "Lastname", render: data => data && data !== "N/A" ? data : "-" },
                { data: "email", title: "Email", render: data => data && data !== "N/A" ? data : "-" },
                {
                    data: "emailStatus",
                    title: "Email Status",
                    render: function (data, type, row) {
                        const statusMap = {
                            1: { class: "status-ongoing", label: "Confirmed" },
                            2: { class: "status-pending", label: "Not Confirmed" },
                            3: { class: "status-reviewed", label: "Rejected" },
                            4: { class: "status-inactive", label: "Cancelled" }
                        };

                        const status = statusMap[row.emailStatusId] || { class: "status-unknown", label: "Unknown" };
                        const description = row.emailStatusDescription || status.label;

                        return `<p><label class="${status.class} pe-cursor">${description}</label></p>`;
                    }
                },

                {
                    targets: 4,
                    data: "id",
                    render: function (data, type, row) {
                        return data ? `
                            <a class='btn btn-secondary' href='#' onclick='preview(this)'>Preview</a>
                            <a class='btn btn-secondary' href='#' onclick='edit(this)'>Edit</a>
                            <a class='btn btn-secondary' href='#' onclick='manageUserRoles(this)'>Manage Roles</a>
                            <a class='btn btn-secondary' href='#' onclick='manageUserClaims(this)'>Manage Claims</a>
                            <a class='btn btn-danger' href='#' onclick='showResetPasswordModal("${data}", "${row.email}")'>Reset Password</a>
                        ` : "-";
                    },
                    orderable: false
                }


            ]
        });
    }


    // Functions for User Actions
    function edit(rowContext) {
        var data = table.row($(rowContext).parents("tr")).data();
        if (!data || !data.id) {
            console.error("Edit action failed: No valid user ID found");
            return;
        }
        window.location.href = "/User/Edit/" + data.id;
    }

    function preview(rowContext) {
        var data = table.row($(rowContext).parents("tr")).data();
        if (!data || !data.id) {
            console.error("Preview action failed: No valid user ID found");
            return;
        }
        window.location.href = "/User/Preview/" + data.id;
    }

    function manageUserRoles(rowContext) {
        var data = table.row($(rowContext).parents("tr")).data();
        if (!data || !data.id) {
            console.error("Manage Roles action failed: No valid user ID found");
            return;
        }
        window.location.href = "/User/ManageUserRoles/" + data.id;
    }

    function manageUserClaims(rowContext) {
        var data = table.row($(rowContext).parents("tr")).data();
        if (!data || !data.id) {
            console.error("Manage Claims action failed: No valid user ID found");
            return;
        }
        window.location.href = "/User/ManageUserClaims/" + data.id;
    }

</script>