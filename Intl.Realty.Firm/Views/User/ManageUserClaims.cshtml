@using Intl.Realty.Firm.Model.ViewModel.UserVM

@model ManageUserClaimsViewModel

@{
    ViewData["Title"] = "Manage User Claims";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<div class="mb-5">
    <a href="@Url.Action("Index","User")" class="text-decoration-none text-blue d-flex mb-4">
        <i data-feather="chevron-left"></i><span>Back</span>
    </a>

    <div class="row justify-content-center">
        <div class="col-md-8 card p-4">
            <h1 class="text-blue mb-0">Manage User Claims</h1>
            <hr class="my-4" />
            <form method="post">
                <input type="hidden" asp-for="@Model.UserId" />
                <div class="card">
                    <div class="card-body">
                        @for (int i = 0; i < Model.Claims.Count; i++)
                        {
                            <div class="form-check m-1">
                                <input type="hidden" asp-for="@Model.Claims[i].ClaimType" />
                                <input asp-for="@Model.Claims[i].IsSelected" class="form-check-input" />
                                <label class="form-check-label" asp-for="@Model.Claims[i].IsSelected">
                                    @Model.Claims[i].ClaimType
                                </label>
                            </div>
                        }
                        <div asp-validation-summary="All" class="text-danger"></div>
                    </div>
                    <div class="card-footer">
                        <input type="submit" value="Update" class="btn btn-primary" style="width:auto" />
                        <a asp-action="Index" asp-route-id="@Model.UserId"
                           class="btn btn-primary" style="width:auto">Cancel</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>