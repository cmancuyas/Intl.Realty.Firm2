@using Intl.Realty.Firm.Model.Model
@using Intl.Realty.Firm.Model.ViewModel.LeaseCoopVM
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Newtonsoft.Json

@inject UserManager<ApplicationUser> _userManager;

@model EditLeaseCoopWithTabMenuViewModel

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";

    var user = await _userManager.GetUserAsync(User);
    var isAgent = await _userManager.IsInRoleAsync(user!, "Agent");
    var isDealAdmin = await _userManager.IsInRoleAsync(user!, "DealAdmin");
    var isAdmin = await _userManager.IsInRoleAsync(user!, "Admin");
    var isSuperAdmin = await _userManager.IsInRoleAsync(user!, "SuperAdmin");
}

<partial name="~/Views/Shared/Modal/_ConfirmSubmitModal.cshtml" />
<partial name="~/Views/Shared/Modal/_ConfirmSuccessModal.cshtml" />
<partial name="~/Views/Shared/Modal/_ConfirmSaveModal.cshtml" />

<div class="page-controller mb-5">
    @*    <a href="@Url.Action("Index","LeaseCoop")" class="text-decoration-none text-blue d-flex mb-4">
    <i data-feather="chevron-left"></i><span>Back</span>
    </a> *@
    <a href="##" class="back" onClick="history.go(-1); return false;">
        <i data-feather="chevron-left"></i><span>Back</span>
    </a>
    <div class="row justify-content-center">
        <div class="col-md-12 card mt-4 p-4 b-none bg-none">
            <h1 class="text-blue mb-0">Edit Lease Co-op - Deal Id: @Model.EditLeaseCoopViewModel.DealTransactionNumber - @Model.EditLeaseCoopViewModel.DealStatus!.Description</h1>
            <hr class="my-4" />
            <form id="ListFormId"
                  asp-action="Edit"
                  asp-controller="LeaseCoop"
                  method="post"
                  enctype="multipart/form-data">

                <input type="hidden" id="ActionTypeHidden" name="actionType" />
                <input type="hidden" asp-for="EditLeaseCoopViewModel.Id" />
                <input type="hidden" asp-for="EditLeaseCoopViewModel.DealTransactionNumber" />
                <input type="hidden" name="EditLeaseCoopViewModel.RowVersion"
                       value="@Convert.ToBase64String(Model.EditLeaseCoopViewModel.RowVersion)" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="tab-page">
                    <ul class="nav nav-tabs" id="administrationManagementTab" role="tablist" style="border:none">
                        @foreach (var item in Model.Menus)
                        {
                            <li class="nav-item mx-0">
                                <input type="hidden" id="menuId" name="menuId" value="@item.Id" />
                                <button class="nav-link @item.IsActive"
                                        id="@item.Tab"
                                        data-bs-toggle="tab"
                                        data-bs-target="#@item.Control"
                                        type="button"
                                        role="tab"
                                        aria-controls="@item.Control"
                                        aria-selected="@item.IsSelected">
                                    @item.Description
                                </button>
                            </li>
                        }
                    </ul>
                </div>

                <div class="tab-content" style="border-bottom:none;background-color:white;">

                    <div class="tab-pane active" id="irfDetails1" aria-labelledby="irfDetails1-tab" style="background-color:white;">

                        @{
                            if (isAdmin || isSuperAdmin || isDealAdmin)
                            {
                                @* Deal Status *@
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="control-label fw-bolder">Deal Status</label>
                                            <select id="EditLeaseCoopViewModel.DealStatusId" name="EditLeaseCoopViewModel.DealStatusId" class="form-select">
                                                @{
                                                    @if (Model.EditLeaseCoopViewModel.DealStatusList != null)
                                                    {
                                                        @foreach (var dealStatus in Model.EditLeaseCoopViewModel.DealStatusList)
                                                        {
                                                            if (dealStatus.Id == Model.EditLeaseCoopViewModel.DealStatusId)
                                                            {
                                                                <option value="@dealStatus.Id" selected>@dealStatus.Description</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@dealStatus.Id">@dealStatus.Description</option>
                                                            }
                                                        }
                                                    }
                                                }
                                            </select>

                                            @Html.ValidationMessageFor(m => m.EditLeaseCoopViewModel.DealStatusId, "", new { @class = "text-danger" })

                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <input type="hidden" name="EditLeaseCoopViewModel.DealStatusId" value="1" />
                            }
                        }

                        <!-- Property & Deal Info -->
                        <h4 class="mt-4 text-blue">Property & Deal Info</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.PropertyAddress" class="fw-bolder">Property Address</label>
                                <input asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.PropertyAddress" class="form-control" />
                                <span asp-validation-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.PropertyAddress" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseCoopViewModel.UpdatedByFullName" class="fw-bolder">Updated By</label>
                                <input asp-for="EditLeaseCoopViewModel.UpdatedByFullName" disabled class="form-control" />
                                <span asp-validation-for="EditLeaseCoopViewModel.UpdatedByFullName" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Financial Details -->
                        <h4 class="mt-5 text-blue">Financial Details</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.FinalLeasePrice" class="fw-bolder">Final Lease Price</label>
                                <input asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.FinalLeasePrice" class="form-control" type="number" min="0" />
                                <span asp-validation-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.FinalLeasePrice" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.FinalClosingDate" class="fw-bolder">Final Closing Date</label>
                                <input asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.FinalClosingDate" class="form-control" type="date" />
                                <span asp-validation-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.FinalClosingDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.DepositAmount" class="fw-bolder">Deposit Amount</label>
                                <input asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.DepositAmount" class="form-control" type="number" min="0" />
                                <span asp-validation-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.DepositAmount" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.DepositDate" class="fw-bolder">Deposit Date</label>
                                <input asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.DepositDate" class="form-control" type="date" />
                                <span asp-validation-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.DepositDate" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Tenant Details -->
                        <h4 class="mt-5 text-blue">Tenant Details</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.TenantDetails.TenantName" class="fw-bolder">Tenant's Name</label>
                                <input asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.TenantDetails.TenantName" class="form-control" />
                                <span asp-validation-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.TenantDetails.TenantName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.TenantDetails.TenantEmailAddress" class="fw-bolder">Tenant's Email</label>
                                <input asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.TenantDetails.TenantEmailAddress" class="form-control" />
                                <span asp-validation-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.TenantDetails.TenantEmailAddress" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.TenantDetails.TenantPhoneNumber" class="fw-bolder">Tenant's Phone Number</label>
                                <input asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.TenantDetails.TenantPhoneNumber" class="form-control" />
                                <span asp-validation-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.TenantDetails.TenantPhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Landlord Info -->
                        <h4 class="mt-5 text-blue">Landlord Info</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.LandLordDetails.LandLordName" class="fw-bolder">Landlord Name</label>
                                <input asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.LandLordDetails.LandLordName" class="form-control" />
                                <span asp-validation-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.LandLordDetails.LandLordName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.LandLordDetails.LandLordPhoneNumber" class="fw-bolder">Landlord Phone</label>
                                <input asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.LandLordDetails.LandLordPhoneNumber" class="form-control" />
                                <span asp-validation-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.LandLordDetails.LandLordPhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.LandLordDetails.LandLordEmailAddress" class="fw-bolder">Landlord Email</label>
                                <input asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.LandLordDetails.LandLordEmailAddress" class="form-control" />
                                <span asp-validation-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.LandLordDetails.LandLordEmailAddress" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Commission -->
                        <h4 class="mt-5 text-blue">Commission</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.Commission.BuyingCommissionPercentage" class="fw-bolder">Buying Commission %</label>
                                <input asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.Commission.BuyingCommissionPercentage" type="number" class="form-control" />
                                <span asp-validation-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.Commission.BuyingCommissionPercentage" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Listing Info -->
                        <h4 class="mt-5 text-blue">Listing Info</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.ListingInfo.ListingAgentName" class="fw-bolder">Listing Agent Name</label>
                                <input asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.ListingInfo.ListingAgentName" class="form-control" />
                                <span asp-validation-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.ListingInfo.ListingAgentName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.ListingInfo.ListingBrokerage" class="fw-bolder">Listing Brokerage</label>
                                <input asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.ListingInfo.ListingBrokerage" class="form-control" />
                                <span asp-validation-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.ListingInfo.ListingBrokerage" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.ListingInfo.ListingBrokerageFax" class="fw-bolder">Listing Brokerage Fax</label>
                                <input asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.ListingInfo.ListingBrokerageFax" class="form-control" />
                                <span asp-validation-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.ListingInfo.ListingBrokerageFax" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane" id="irfDetails2" aria-labelledby="irfDetails2-tab" style="background-color:white;">
                        <!-- Tenant Agent Info -->
                        <h4 class="mt-4 text-blue">Tenant's Agent & Brokerage Info</h4>
                        <div class="row">
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.TenantDetails.TenantAgentName" class="fw-bolder">Tenant Agent Name</label>
                                <input asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.TenantDetails.TenantAgentName" class="form-control" />
                                <span asp-validation-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.TenantDetails.TenantAgentName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.TenantDetails.TenantBrokerage" class="fw-bolder">Tenant Brokerage</label>
                                <input asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.TenantDetails.TenantBrokerage" class="form-control" />
                                <span asp-validation-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.TenantDetails.TenantBrokerage" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mt-3">
                                <label asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.TenantDetails.TenantBrokerageFax" class="fw-bolder">Tenant Brokerage Fax</label>
                                <input asp-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.TenantDetails.TenantBrokerageFax" class="form-control" />
                                <span asp-validation-for="EditLeaseCoopViewModel.EditIRFDealLeaseCoopViewModel.TenantDetails.TenantBrokerageFax" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane" id="viewFileUploads" aria-labelledby="viewFileUploads-tab" style="background-color:white;">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-submit-tab mt-3 bg-white" style="display: block !important">
                                    <div class="table-responsive">
                                        <table>
                                            <thead class="bg-blue">
                                                <tr>
                                                    <th class="w-5 text-white ps-3 p-2">Document Type</th>
                                                    <th class="w-5 text-white ps-3 p-2">Filename</th>
                                                    <th class="w-5 text-white ps-3 p-2">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="fileTableBody">

                                                @foreach (DocumentType item in Model.EditLeaseCoopViewModel.DocumentTypeList!)
                                                {
                                                    <tr class="border-bottom">
                                                        <td class="p-2">
                                                            <span class="mt-3 ms-2 mb-1">@item.Description</span>
                                                        </td>
                                                        @{
                                                            var filesWithDocumentTypeId = Model.EditLeaseCoopViewModel.FileUploads!.Where(x => x.DocumentTypeId == item.Id);

                                                            if (filesWithDocumentTypeId != null)
                                                            {
                                                                @foreach (var fileUpload in filesWithDocumentTypeId)
                                                                {
                                                                    <td class="w-5 ps-2">
                                                                        @fileUpload.OriginalFileName
                                                                    </td>

                                                                    <td class="w-5 ps-2">
                                                                        <a asp-action="Download" asp-route-id="@fileUpload.Id" class="btn btn-secondary" data-position-id="@fileUpload.Id">
                                                                            Download
                                                                        </a>
                                                                        <a id="btnDeleteFile" asp-action="DeleteFile" asp-controller="LeaseCoop" asp-route-id="@fileUpload.Id" class="btn btn-secondary" data-position-id="@fileUpload.Id">
                                                                            Delete
                                                                        </a>
                                                                        <a id="btnDeleteFile" asp-action="PreviewFile" asp-controller="LeaseCoop" asp-route-id="@fileUpload.Id" class="btn btn-secondary" data-position-id="@fileUpload.Id">
                                                                            Preview
                                                                        </a>
                                                                    </td>
                                                                }
                                                            }
                                                        }
                                                    </tr>
                                                }

                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="tab-pane" id="createFileUploads" aria-labelledby="createFileUploads-tab" style="background-color:white;">
                        <div class="row d-flex justify-content-center m-0">
                            <div class="col-md-12">
                                <h5 class="text-blue mb-4">Please match your uploaded file based on the Document Type for Sale Listing.<span class="s-required">*</span></h5>
                                <table class="table dataTable" id="tblApplicantFiles" width="100%">
                                    <thead>
                                        <tr>
                                            <th style="width: 30%">Document Type</th>
                                            <th>Is Required?</th>
                                            <th>Uploaded Document</th>

                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int i = 0;
                                        }
                                        @foreach (DocumentTypeAssignment item in Model.EditLeaseCoopViewModel.DocumentTypeAssignmentList!)
                                        {
                                            <tr data-document-type-id="@item.DocumentType.Id">
                                                <td style="width: 30%">
                                                    @Html.DisplayFor(modelItem => item.DocumentType.Description)
                                                </td>
                                                <input type="hidden"
                                                       asp-for="EditLeaseCoopViewModel.CreateFileUploadListViewModel.CreateFileUploadsViewModel[i].DocumentTypeId"
                                                       value="@item.DocumentType.Id" />
                                                <td id="isRequired">
                                                    @if (item.IsRequired == true)
                                                    {
                                                        <label class="status-active">Required</label>
                                                    }
                                                    else if (item.IsRequired == false)
                                                    {
                                                        <label class="status-inactive pe-cursor">Not Required</label>
                                                    }
                                                </td>
                                                <td>
                                                    <input asp-for="EditLeaseCoopViewModel.CreateFileUploadListViewModel.CreateFileUploadsViewModel[i].Files"
                                                           id="fileListDropDown_@i"
                                                           type="file"
                                                           class="file"
                                                           multiple
                                                           data-show-upload="false"
                                                           data-allowed-file-extensions='["pdf","doc","docx","xls","xlsx"]'
                                                           accept="application/all"
                                                           data-show-caption="true"
                                                           data-show-preview="false"
                                                           @* onchange="fileSelected(this)" *@
                                                           data-msg-placeholder="Select {files} for upload...">
                                                </td>
                                                @{
                                                    i++;
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>

                    <div class="tab-pane" id="notes" aria-labelledby="notes-tab" style="background-color:white;">
                        <div class="col-md-12 mt-4">
                            <div class="form-group">
                                <label asp-for="EditLeaseCoopViewModel.Notes" class="control-label fw-bolder">Notes</label>
                                @Html.TextAreaFor(model => model.EditLeaseCoopViewModel.Notes, 10, 100, new { @class = "form-control" })

                            </div>
                        </div>
                    </div>
                </div>
                @*               <div class="row mb-4">
                <div class="col-md-12">
                <div class="form-check form-switch d-flex align-items-center gap-2">
                <input id="isDeletedCheckbox" class="form-check-input" type="checkbox" asp-for="IsDeleted">
                <label id="lblStatusSoftDelete" class="fw-bolder">Not Deleted</label>
                </div>
                <span asp-validation-for="IsDeleted" class="text-danger"></span>
                </div>
                </div> *@
                <div class="mt-4">
                    @await Html.PartialAsync("~/Views/Shared/Transaction/_EditActionButtons.cshtml", Model.EditLeaseCoopViewModel.DealStatusId)
                </div>



            </form>
        </div>
    </div>
</div>




@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/viewDataTableUtility.js" asp-append-version="true"></script>
    <script src="~/js/submitUtility.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const documentTypeAssignments = @Html.Raw(JsonConvert.SerializeObject(Model.EditLeaseCoopViewModel.DocumentTypeAssignmentList));

        $(document).ready(function () {
            initializeSubmitHandlers({
                formId: "ListFormId", // ✅ match your form's actual ID
                dealStatusDropdownSelector: '[name="EditLeaseCoopViewModel.DealStatusId"]', // ✅ or adjust to match input name
                isAdminLike: false, // ✅ or dynamically set via Razor logic
                fileErrorScrollTargetId: "fileUploads", // ✅ your tab/section ID
                documentTypeAssignment: documentTypeAssignments
            });
        });
    </script>
}

