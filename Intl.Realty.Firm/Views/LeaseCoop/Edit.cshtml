<style>
    .file-upload-table {
        table-layout: fixed;
        width: 100%;
        border-collapse: collapse;
    }

        .file-upload-table th,
        .file-upload-table td {
            vertical-align: middle;
            border: 1px solid #dee2e6;
        }

            .file-upload-table td.text-break {
                word-break: break-word;
                overflow-wrap: anywhere;
            }

        .file-upload-table .btn {
            min-width: 82px;
            margin-right: 4px;
        }

        /* THIS IS THE IMPORTANT FIX */
        .file-upload-table thead th {
            background-color: #203d57 !important;
            color: #fff !important;
            font-weight: 600;
        }
</style>
@section Scripts {
    @* ASP.NET Core client-side validation *@
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @* JS Utilities and Plugins *@
    <script src="~/js/viewDataTableUtility.js" asp-append-version="true"></script>
    <script src="~/js/submitUtility.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @* Submit Handler Initialization *@
    <script>
        const documentTypeAssignments = @Html.Raw(JsonConvert.SerializeObject(Model.EditLeaseCoopViewModel.DocumentTypeAssignmentList));
        const isAdminLike = @((User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("DealAdmin")).ToString().ToLower());

        $(document).ready(function () {
            initializeSubmitHandlers({
                formId: "ListFormId",
                dealStatusDropdownSelector: '[name="EditLeaseCoopViewModel.DealStatusId"]',
                isAdminLike: isAdminLike,
                fileErrorScrollTargetId: "fileUploads",
                documentTypeAssignment: documentTypeAssignments
            });

            $('.btn-delete-file').on('click', function (e) {
                 e.preventDefault();
                 var $btn = $(this);
                 var fileId = $btn.data('file-id');
                 Swal.fire({
                     title: 'Are you sure?',
                     text: "This will permanently delete the file.",
                     icon: 'warning',
                     showCancelButton: true,
                     confirmButtonColor: '#d33',
                     cancelButtonColor: '#aaa',
                     confirmButtonText: 'Yes, delete it!'
                 }).then((result) => {
                     if (result.isConfirmed) {
                         $.ajax({
                             url: '/LeaseCoop/DeleteFileAjax/' + fileId,
                             type: 'POST',
                             headers: {
                                 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                             },
                             success: function (res) {
                                 if (res.success) {
                                     Swal.fire('Deleted!', 'File has been deleted.', 'success').then(() => {
                                         location.reload(); // reload to update the file list
                                     });
                                 } else {
                                     Swal.fire('Error!', 'Could not delete the file.', 'error');
                                 }
                             }
                         });
                     }
                 });
             });
        });
    </script>

<script>
    $(function () {
        const tableSelector = '#tblAdditionalDocuments';
        const addButtonSelector = '#btnAddAdditionalDocumentRow';

        function buildAdditionalDocumentRow(index) {
            return `
                <tr>
                    <td>
                        <input type="hidden"
                               name="EditLeaseCoopViewModel.AdditionalDocuments[${index}].Id"
                               value="" />
                        <input type="text"
                               name="EditLeaseCoopViewModel.AdditionalDocuments[${index}].DocumentName"
                               class="form-control"
                               placeholder="Enter document name" />
                    </td>
                    <td>
                        <input type="file"
                               name="EditLeaseCoopViewModel.AdditionalDocuments[${index}].File"
                               class="form-control additional-document-file"
                               accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />
                    </td>
                    <td class="text-center align-middle">
                        <button type="button" class="btn btn-danger btnRemoveAdditionalDocumentRow">
                            Remove
                        </button>
                    </td>
                </tr>
            `;
        }

        function reIndexRows() {
            $(`${tableSelector} tbody tr`).each(function (index) {
                $(this).find('input').each(function () {
                    const currentName = $(this).attr('name');
                    if (!currentName) return;

                    $(this).attr(
                        'name',
                        currentName.replace(
                            /EditLeaseCoopViewModel\.AdditionalDocuments\[\d+\]/g,
                            `EditLeaseCoopViewModel.AdditionalDocuments[${index}]`
                        )
                    );
                });
            });
        }

        $(document)
            .off('click.additionalDocs', addButtonSelector)
            .on('click.additionalDocs', addButtonSelector, function (e) {
                e.preventDefault();
                const rowCount = $(`${tableSelector} tbody tr`).length;
                $(`${tableSelector} tbody`).append(buildAdditionalDocumentRow(rowCount));
            });

        $(document)
            .off('click.additionalDocs', `${tableSelector} .btnRemoveAdditionalDocumentRow`)
            .on('click.additionalDocs', `${tableSelector} .btnRemoveAdditionalDocumentRow`, function (e) {
                e.preventDefault();

                const $rows = $(`${tableSelector} tbody tr`);
                if ($rows.length > 1) {
                    $(this).closest('tr').remove();
                    reIndexRows();
                } else {
                    const $row = $(this).closest('tr');
                    $row.find('input[type="hidden"]').val('');
                    $row.find('input[type="text"]').val('');
                    $row.find('input[type="file"]').val('');
                }
            });

        $(document)
            .off('click.additionalDocsDelete', '.btn-delete-additional-document')
            .on('click.additionalDocsDelete', '.btn-delete-additional-document', function (e) {
                e.preventDefault();

                const id = $(this).data('id');

                Swal.fire({
                    title: 'Are you sure?',
                    text: 'This will permanently delete the additional document.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#aaa',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/LeaseCoop/DeleteAdditionalDocumentAjax/' + id,
                            type: 'POST',
                            headers: {
                                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function (res) {
                                if (res.success) {
                                    Swal.fire('Deleted!', 'Additional document has been deleted.', 'success')
                                        .then(() => location.reload());
                                } else {
                                    Swal.fire('Error!', 'Could not delete the additional document.', 'error');
                                }
                            }
                        });
                    }
                });
            });
    });
</script>
}
