@using Intl.Realty.Firm.Model.Model
@using Intl.Realty.Firm.Model.ViewModel.Home
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> _userManager;

@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";

    var users = _userManager.Users;
}

<div class="container-fluid">
    <div class="row">
        <h1 class="text-blue">Admin Dashboard</h1>
    </div>
</div>

<div class="container-fluid mt-3 mb-3 dashboard-cards">
    <div class="row">
        <!-- Card 1 -->
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <p class="card-title">SaleListing</p>
                    <span class="label">Today</span>
                    <p class="value">@Model.SaleListingCountToday</p>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar w-75" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Card 2 -->
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <p class="card-title">Sale Coop</p>
                    <span class="label">Today</span>
                    <p class="value">@Model.SaleCoopCountToday</p>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar w-75" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Card 3 -->
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <p class="card-title">Lease Listing</p>
                    <span class="label">Today</span>
                    <p class="value">@Model.LeaseCoopCountToday</p>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar w-75" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Card 4 -->
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <p class="card-title">Lease Coop</p>
                    <span class="label">Today</span>
                    <p class="value">@Model.LeaseCoopCountToday</p>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar w-75" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid mt-3 mb-3 dashboard-lists">
    <div class="row">
        <div class="col-6">
            <div class="card card-custom">
                <div class="card-body">
                    <h5 class="card-title">Monthly Invoices</h5>
                    <ul class="list-group">
                        <li class="list-group-item">
                            <div class="d-flex align-items-center">
                                <div class="icon-circle" style="background-color: #f9e79f;">
                                    <i class="bi bi-check-circle-fill text-warning"></i>
                                </div>
                                <div>
                                    <div>Deposit PayPal</div>
                                    <div class="text-small">5 march, 18:33</div>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="text-eur">+2000 EUR</div>
                            </div>
                        </li>
                        <li class="list-group-item">
                            <div class="d-flex align-items-center">
                                <div class="icon-circle" style="background-color: #f5b7b1;">
                                    <i class="bi bi-check-circle-fill text-danger"></i>
                                </div>
                                <div>
                                    <div>Deposit PayPal</div>
                                    <div class="text-small">5 march, 18:33</div>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="text-eur">+2000 EUR</div>
                            </div>
                        </li>
                        <li class="list-group-item">
                            <div class="d-flex align-items-center">
                                <div class="icon-circle" style="background-color: #f5c7f7;">
                                    <i class="bi bi-check-circle-fill text-primary"></i>
                                </div>
                                <div>
                                    <div>Deposit from Bank</div>
                                    <div class="text-small">5 march, 18:33</div>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="text-eur">+2000 EUR</div>
                            </div>
                        </li>
                        <li class="list-group-item">
                            <div class="d-flex align-items-center">
                                <div class="icon-circle" style="background-color: #d4efdf;">
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                </div>
                                <div>
                                    <div>Cancelled</div>
                                    <div class="text-small">5 march, 18:33</div>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="text-eur">+2000 EUR</div>
                            </div>
                        </li>
                        <li class="list-group-item">
                            <div class="d-flex align-items-center">
                                <div class="icon-circle" style="background-color: #a2d9ce;">
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                </div>
                                <div>
                                    <div>Deposit from Bank</div>
                                    <div class="text-small">5 march, 18:33</div>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="text-eur">+2000 EUR</div>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-6">
            <div class="card card-custom">
                <div class="card-body">
                    <h5 class="card-title">Recent Activity</h5>
                    <div class="activity-timeline">

                        @foreach (var item in Model.SaleListingListPastHour)
                        {
                            <div class="activity-timeline-item">
                                <div class="timeline-dot"></div>
                                <div class="activity-time">1 hour ago</div>
                                <div class="activity-desc">@item.TransactionType!.Description was created - Deal Id: @item.Id - @item.DealStatus!.Description</div>
                            </div>
                        }


                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid mt-3 mb-3 px-4 dashboard-tables">
    <div class="row">
        <div class="card card-custom">
            <div class="card-body">
                <h5 class="card-title">Monthly Transactions</h5>
                <div class="table-responsive">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>Deal #</th>
                                <th>Transaction Type</th>
                                <th>Property Address</th>
                                <th>Deal Status</th>
                                <th>Created By</th>
                                <th>Created At</th>
                                <th>Attachment</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.SaleListingListAll)
                            {
                                var user = await _userManager.FindByIdAsync(item.CreatedBy.ToString());
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.TransactionType!.Description</td>
                                    <td>@item.IRFDeal!.PropertyAddress</td>
                                    <td>@item.DealStatus!.Description</td>
                                    <td>@user!.FirstName @user.LastName</td>
                                    <td>@item.CreatedAt</td>
                                    <td><div class="attachment-icon">PDF</div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

