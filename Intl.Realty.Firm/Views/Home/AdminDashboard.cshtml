@using Intl.Realty.Firm.Model.Model
@using Intl.Realty.Firm.Model.ViewModel.Home
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> _userManager;

@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";

    var users = _userManager.Users;
}

<div class="container-fluid">
    <div class="row">
        <h1 class="text-blue">Admin Dashboard</h1>
    </div>
</div>

<div class="container-fluid mt-3 mb-3 dashboard-cards">
    <div class="row">
        <!-- Card 1 -->
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <p class="card-title">SaleListing</p>
                    <span class="label">Today</span>
                    <p class="value">@Model.SaleListingCountToday</p>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar w-75" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="d-flex">
                        <div>
                            <a asp-action="Index"
                               asp-controller="SaleListing"
                               class="btn btn-link d-flex align-items-center">
                                View Sale Listing
                            </a>
                        </div>
                        <div class="ml-auto">
                            <a asp-action="Create"
                               asp-controller="SaleListing"
                               class="btn btn-link d-flex align-items-center">
                                Create Sale Listing
                            </a>
                        </div>

                    </div>

                </div>
            </div>
        </div>
        <!-- Card 2 -->
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <p class="card-title">Sale Coop</p>
                    <span class="label">Today</span>
                    <p class="value">@Model.SaleCoopCountToday</p>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar w-75" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="d-flex">
                        <div>
                            <a asp-action="Index"
                               asp-controller="SaleCoop"
                               class="btn btn-link d-flex align-items-center">
                                View Sale Coop
                            </a>
                        </div>
                        <div class="ml-auto">
                            <a asp-action="Create"
                               asp-controller="SaleCoop"
                               class="btn btn-link d-flex align-items-center">
                                Create Sale Coop
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <!-- Card 3 -->
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <p class="card-title">Lease Listing</p>
                    <span class="label">Today</span>
                    <p class="value">@Model.LeaseCoopCountToday</p>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar w-75" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="d-flex">
                        <div>
                            <a asp-action="Index"
                               asp-controller="LeaseListing"
                               class="btn btn-link d-flex align-items-center">
                                View Lease Listing
                            </a>
                        </div>
                        <div class="ml-auto">
                            <a asp-action="Create"
                               asp-controller="LeaseListing"
                               class="btn btn-link d-flex align-items-center">
                                Create Lease Listing
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <!-- Card 4 -->
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <p class="card-title">Lease Coop</p>
                    <span class="label">Today</span>
                    <p class="value">@Model.LeaseCoopCountToday</p>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar w-75" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="d-flex">
                        <div>
                            <a asp-action="Index"
                               asp-controller="LeaseCoop"
                               class="btn btn-link d-flex align-items-center">
                                View Lease Coop
                            </a>
                        </div>
                        <div class="ml-auto">
                            <a asp-action="Create"
                               asp-controller="LeastCoop"
                               class="btn btn-link d-flex align-items-center">
                                Create Lease Coop
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid mt-3 mb-3 dashboard-lists">
    <div class="row">
        <div class="col-6">
            <div class="card card-custom">
                <div class="card-body">
                    <h5 class="card-title">My Daily Transactions</h5>
                    <ul class="list-group">

                        @foreach (var item in Model.SaleListingListToday)
                        {
                            <li class="list-group-item">
                                <div class="d-flex align-items-center">
                                    <div class="icon-circle" style="background-color: #f9e79f;">
                                        <i class="bi bi-check-circle-fill text-warning"></i>

                                    </div>
                                    <div>
                                        <div>@item.IRFDeal!.PropertyAddress - @item.Id</div>
                                        <div class="text-small">@item.CreatedAt</div>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="text-eur">@item.DealStatus!.Description</div>
                                </div>
                            </li>
                        }


                    </ul>
                </div>
            </div>
        </div>

        <div class="col-6">
            <div class="card card-custom">
                <div class="card-body">
                    <h5 class="card-title">Recent Activity</h5>
                    <div class="activity-timeline">

                        @foreach (var item in Model.SaleListingListPastHour)
                        {
                            <div class="activity-timeline-item">
                                <div class="timeline-dot"></div>
                                <div class="activity-time">1 hour ago</div>
                                <div class="activity-desc">@item.TransactionType!.Description was created - Deal Id: @item.Id - @item.DealStatus!.Description</div>
                            </div>
                        }


                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid mt-3 mb-3 px-4 dashboard-tables">
    <div class="row">
        <div class="card card-custom">
            <div class="card-body">
                <h5 class="card-title">Monthly Transactions - @DateTime.Now.ToString("MMMM") @DateTime.Now.ToString("yyyy")</h5>
                <div class="table-responsive">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>Deal #</th>
                                <th>Transaction Type</th>
                                <th>Property Address</th>
                                <th>Deal Status</th>
                                <th>Created By</th>
                                <th>Created At</th>
                                <th>Final Closing Date</th>
                                <th>Attachment</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.SaleListingListAll)
                            {
                                var user = await _userManager.FindByIdAsync(item.CreatedBy.ToString());
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.TransactionType!.Description</td>
                                    <td>@item.IRFDeal!.PropertyAddress</td>
                                    <td>@item.DealStatus!.Description</td>
                                    <td>@user!.FirstName @user.LastName</td>
                                    <td>@item.CreatedAt</td>
                                    <td>@item.IRFDeal.FinalClosingDate</td>
                                    <td>
                                        @{
                                            var fileUploads = item.FileUploads!.Where(x => x.SaleListingId == item.Id);
                                            if (fileUploads.Any())
                                            {
                                                var str = fileUploads.Select(x => x.FileExtension).FirstOrDefault();
                                                string[] split = str!.Split('.');
                                                var fileExtension = split[1];
                                                <div class="attachment-icon">@fileExtension</div>
                                            }
                                            else
                                            {
                                                <div class="attachment-icon">PDF</div>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <nav aria-label="Page navigation">

                        <ul class="pagination">

                            <li class="page-item">

                                <a class="page-link" href="?page=@(Model.MonthlyCurrentPage - 1)">Previous</a>

                            </li>

                            @for (int i = 1; i <= Model.MonthlyTotalPages; i++)

                            {

                                <li class="page-item">

                                    <a class="page-link" href="?page=@i">@i</a>

                                </li>

                            }

                            <li class="page-item">

                                <a class="page-link" href="?page=@(Model.MonthlyCurrentPage + 1)">Next</a>

                            </li>

                        </ul>

                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

