@using Intl.Realty.Firm.Model.Model
@using Intl.Realty.Firm.Model.ViewModel.Home
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> _userManager;

@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<div id="dashboardContent">
    @Html.Partial("_DashboardPartial", Model)
</div>

@section Scripts {
    <script>
        function loadDashboard(sortExpression,searchText,pageIndex, pageSize) {
            $.get('@Url.Action("Dashboard", "Home")', { sortExpression, searchText, pageIndex, pageSize }, function (data) {
                $('#dashboardContent').html(data);
            });
        }

        // $(document).on('change', '#pageSizeDropdown', function () {
        //     let pageSize = $(this).val();
        //     loadDashboard('@Model.AllDealsCurrentMonth.SortModel', 1, pageSize);
        // });
    </script>
}