@using Intl.Realty.Firm.Model.Model
@using Intl.Realty.Firm.Model.ViewModel.Home
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> _userManager;

@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<div id="dashboardContent">
    @Html.Partial("_DashboardPartial", Model)
</div>

@section Scripts {
    <script>
        function loadDashboard(sortExpression,searchText,pageIndex, pageSize, tableName) {
            $.get('@Url.Action("Dashboard", "Home")', { sortExpression, searchText, pageIndex, pageSize, tableName }, function (data) {
                $('#dashboardContent').html(data);
            });
        }

        function loadTopBarPaginationCurrentMonth(action, pageIndex, pageSize, searchText, sortExpression) {
            $.get('@Url.Action("Dashboard", "Home")', { action, pageIndex, pageSize, searchText, sortExpression }, function (data) {
                $('#dashboardContent').html(data);
            });
        }
        function loadTopBarPaginationAllDeals(action, pageIndex, pageSize, searchText, sortExpression) {
            $.get('@Url.Action("Dashboard", "Home")', { action, pageIndex, pageSize, searchText, sortExpression }, function (data) {
                $('#dashboardContent').html(data);
            });
        }
    </script>
}