@using Intl.Realty.Firm.Models.Pagination

@model PaginatedDealsViewModel
<div class="card">
    <div class="card-header p-3 bg-white">
        <h5 class="m-0">All Deals For @DateTime.Now.ToString("MMMM") - @DateTime.Now.Year</h5>
    </div>
    <div class="row" id="current-month-top-bar">
        <div class="col-12">
            @await Html.PartialAsync("~/Views/Home/AllDealsForCurrentMonth/_AllDealsForCurrentMonthTopBar.cshtml", Model.Pager)
        </div>
    </div>

    <table class="table mt-4" id="current-month-table">
        <thead>
            <tr>
                <th>
                    <i class="@Model.SortModel!.GetColumn("dealTransactionNumber").SortIcon" aria-hidden="true"></i>
                    @{
                        <a href="#" onclick="loadDashboard('@Model.SortModel!.GetColumn("dealTransactionNumber").SortExpression', '@Model.Pager.SearchText', '@Model.Pager.CurrentPage', '@Model.Pager.PageSize', 'CurrentMonth')">Deal#</a>
                    }
                </th>
                <th>
                    <i class="@Model.SortModel!.GetColumn("transactionTypeName").SortIcon" aria-hidden="true"></i>
                    @{
                        <a href="#" onclick="loadDashboard('@Model.SortModel!.GetColumn("transactionTypeName").SortExpression', '@Model.Pager.SearchText', '@Model.Pager.CurrentPage', '@Model.Pager.PageSize', 'CurrentMonth')">Transaction Type</a>
                    }
                </th>
                <th>
                    <i class="@Model.SortModel!.GetColumn("propertyAddress").SortIcon" aria-hidden="true"></i>
                    @{
                        <a href="#" onclick="loadDashboard('@Model.SortModel!.GetColumn("propertyAddress").SortExpression', '@Model.Pager.SearchText', '@Model.Pager.CurrentPage', '@Model.Pager.PageSize', 'CurrentMonth')">Property Address</a>
                    }
                </th>
                <th>
                    <i class="@Model.SortModel!.GetColumn("dealStatusName").SortIcon" aria-hidden="true"></i>
                    @{
                        <a href="#" onclick="loadDashboard('@Model.SortModel!.GetColumn("dealStatusName").SortExpression', '@Model.Pager.SearchText', '@Model.Pager.CurrentPage', '@Model.Pager.PageSize', 'CurrentMonth')">Deal Status</a>
                    }
                </th>
                <th>
                    <i class="@Model.SortModel!.GetColumn("createdByFullName").SortIcon" aria-hidden="true"></i>
                    @{
                        <a href="#" onclick="loadDashboard('@Model.SortModel!.GetColumn("createdByFullName").SortExpression', '@Model.Pager.SearchText', '@Model.Pager.CurrentPage', '@Model.Pager.PageSize', 'CurrentMonth')">Created By</a>
                    }
                </th>
                <th>
                    <i class="@Model.SortModel!.GetColumn("createdAt").SortIcon" aria-hidden="true"></i>
                    @{
                        <a href="#" onclick="loadDashboard('@Model.SortModel!.GetColumn("createdAt").SortExpression', '@Model.Pager.SearchText', '@Model.Pager.CurrentPage', '@Model.Pager.PageSize', 'CurrentMonth')">Created At</a>
                    }
                </th>
                <th>
                    <i class="@Model.SortModel!.GetColumn("finalClosingDate").SortIcon" aria-hidden="true"></i>
                    @{
                        <a href="#" onclick="loadDashboard('@Model.SortModel!.GetColumn("finalClosingDate").SortExpression', '@Model.Pager.SearchText', '@Model.Pager.CurrentPage', '@Model.Pager.PageSize', 'CurrentMonth')">Final Closing Date</a>
                    }
                </th>
                <th>File Extension</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="current-month-table-body">
            @await Html.PartialAsync("~/Views/Home/AllDealsForCurrentMonth/_AllDealsForCurrentMonthTableBody.cshtml", Model)
        </tbody>
    </table>

    <div class="row" id="current-month-bottom-bar">
        <div class="container-fluid">
            <div class="col-12 p-0 mb-3">
                @await Html.PartialAsync("~/Views/Home/AllDealsForCurrentMonth/_AllDealsForCurrentMonthBottomBar.cshtml", Model.Pager)
            </div>
        </div>
    </div>
</div>